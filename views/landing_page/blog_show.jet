<section id="blog">
	<div class="container px-xl-5 px-lg-5 px-md-4 px-sm-4 px-4">
		<div class="col-lg-10 px-xl-5 px-lg-5 m-auto">
			<div class="col px-lg-5 blog">
				<p class="text-xs mb-5">
					<a href="{{ baseURL }}/blogs" class="text-black">Blog / </a> <span class="text-sm text-muted">{{ blog.Subject }}</span>
				</p>
				<div class="blog-header pt-xl-3 pt-lg-3">
					<div class="blog-title d-block mb-4 mb-xl-5 mb-lg-5">
						<h1 class="text-bold">{{ blog.Subject }}</h1>
						<p class="mb-lg-3 text-sm text-muted">
							{{ blog.CreatedAt.Format("Mon, 2 Jan 2006 MST") }}
						</p>
					</div>
					<div class="blog-img d-block">
						<img src="{{ baseURL }}/images/blog/{{ blog.Photo }}" alt="{{ blog.Subject }}"
							class="w-100" />
					</div>
				</div>
				<div class="blog-content pt-4 pt-xl-5 pt-lg-5">
					{{ blog.Body | raw }}
				</div>
				<div class="blog-share pt-lg-3 d-none justify-content-evenly pb-3">
					<span class="bi bi-facebook share-icon cp" alt="Facebook"
						data-toggle="tooltip" data-placement="top" title="Share with Facebook"></span>
					<span class="bi bi-instagram share-icon cp" alt="Instagram"
						data-toggle="tooltip" data-placement="top" title="Share with Instagram"></span>
					<span class="bi bi-whatsapp share-icon cp" alt="Whatsapp"
						data-toggle="tooltip" data-placement="top" title="Share with Whatsapp"></span>
					<span class="bi bi-twitter share-icon cp" alt="Twitter"
						data-toggle="tooltip" data-placement="top" title="Share with Twitter"></span>
				</div>
			</div>
			<br />
		</div>
	</div>
</section>
