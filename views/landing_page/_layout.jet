<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
		<meta name="description" content="" />
		<meta name="author" content="" />
		<meta name="facebook-domain-verification" content="oxv3vp8mas5nnzqety27iat2v2fpae" />
		<title>{{ pageTitle }}</title>
		<script src="{{ baseURL }}/assets/plugins/jquery/jquery.js"></script>
		<script src="{{ baseURL }}/assets/plugins/bootstrap/bs-js/bootstrap.bundle.min.js"></script>
		<script src="{{ baseURL }}/assets/plugins/OwlCarousel2-2.3.4/src/js/owl.carousel.js"></script>
		<script src="{{ baseURL }}/assets/plugins/OwlCarousel2-2.3.4/src/js/owl.autoplay.js"></script>
		<script src="{{ baseURL }}/assets/plugins/OwlCarousel2-2.3.4/src/js/owl.navigation.js"></script>
		<script src="{{ baseURL }}/assets/plugins/aos-master/dist/aos.js"></script>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
		<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/bootstrap/bs-css/bootstrap.min.css" />
		<link rel="stylesheet" href="{{ baseURL }}/assets/css/styles.css" />
		<link rel="icon" type="image/x-icon" href="{{ baseURL }}/images/landing-page/more/laukpauk-icon.png" />
		<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/OwlCarousel2-2.3.4/dist/assets/owl.carousel.min.css" />
		<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/animate.css/animate.css" />
		<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/aos-master/dist/aos.css" />
		<style type="text/css">
			a {
				color: #66cc99;
				text-decoration: none;
			}
			.font-40 {
				font-size: 40pt;
			}
			.font-11 {
				font-size: 11pt;
			}
			.font-10 {
				font-size: 10pt;
			}
			.font-9 {
				font-size: 9pt;
			}
			.font-8 {
				font-size: 8pt;
			}
			.bold {
				font-weight: bold;
			}
			.owl-stage {
				display: flex;
			}
			.owl-nav {
				position: absolute;
				top: 50%;
				transform: translateY(-50%);
				width: 100%;
				padding-left: 2.5rem;
				padding-right: 2.5rem;
				display: flex;
				justify-content: space-between;
			}
			.navigasi {
				display: inline-block;
				width: 50px;
				height: 50px;
				background: #66cc99;
				color:#fff;
				border-radius: 50%;
				position: relative;
				box-shadow: 0px 10px 30px -8px rgb(0 0 0 / 16%);
			}
			.navigasi > span {
				position: absolute;
				top:50%;
				left:50%;
				transform: translate(-50%, -50%);
				font-size: 1.75rem;
			}
			@media screen and (max-width: 768px) {
				.navigasi {
					width: 35px;
					height: 35px;
				}
				.navigasi > span {
					font-size: 1.5rem;
				}
			}
		</style>
		<link rel="stylesheet" href="{{ baseURL }}/assets/css/custom-landing-page-style.css" />
	</head>
	<body id="page-top">
		<!-- Navigation-->
		<nav class="navbar navbar-expand-lg navbar-light shadow-md" id="mainNav">
			<div class="container px-5">
				<a class="navbar-brand fw-bold" href="{{ baseURL }}/">
					<img src="{{ baseURL }}/assets/img/laukpauk-brand.png" style="width:125px;" alt="Logo" />
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive"
					aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
					Menu
					<i class="bi-list"></i>
				</button>
				<div class="collapse navbar-collapse" id="navbarResponsive">
					<ul class="navbar-nav ms-auto me-4 my-3 my-lg-0">
						<li class="nav-item"><a class="nav-link me-lg-3" href="{{ baseURL }}/">Home</a></li>
						<li class="nav-item"><a class="nav-link me-lg-3" href="{{ baseURL }}/blog">Blog</a></li>
						<li class="nav-item"><a class="nav-link me-lg-3" href="{{ baseURL }}/hubungi-kami">Hubungi Kami</a></li>
					</ul>
					<a href="https://play.google.com/store/apps/details?id=id.laukpauk" target="_blank">
						<button class="btn btn-primary rounded-pill px-3 mb-2 mb-lg-0" data-bs-toggle="modal" data-bs-target="#feedbackModal">
							<span class="d-flex align-items-center">
								<span class="small">KE PASAR SEKARANG</span>
							</span>
						</button>
					</a>
				</div>
			</div>
		</nav>
		{{ embed() }}
		<!-- Footer-->
		<footer class="bg-light pt-5 pb-4">
			<div class="container px-5">
				<div class="row">
					<div class="col-xl-2 col-lg-2 col-md-4 col-sm-6 mb-4">
						<p class="font-11 bold text-judul">Laukpauk</p>
						<p class="text-sub-judul text-sm mb-0"><a class="font-9 text-muted" href="{{ baseURL }}/blog">Blog</a></p>
					</div>
					<div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 mb-4">
						<p class="font-11 bold text-judul">Bantuan & Panduan</p>
						<p class="text-sub-judul text-sm mb-2"><a class="font-9 text-muted" href="{{ baseURL }}/bantuan">Bantuan</a></p>
						<p class="text-sub-judul text-sm mb-0"><a class="font-9 text-muted" href="{{ baseURL }}/kebijakan-privasi">Kebijakan & Privasi</a></p>
					</div>
					<div class="col-xl-5 col-lg-5 col-md-4 col-sm-6 mb-4">
						<p class="font-11 bold text-judul">Kepo-in Kami</p>
						<div class="row mt-3">
							<div class="col">
								<a href="https://web.facebook.com/laukpauk.id" target="_blank">
									<img src="{{ baseURL }}/images/landing-page/more/fb.png" alt="Kepoin kami di facebook"
										style="width:35px;" />
								</a>
								<a href="https://www.instagram.com/laukpauk.id/" target="_blank">
									<img src="{{ baseURL }}/images/landing-page/more/ig.png" alt="Kepoin kami di instagram"
										style="width:35px;" />
								</a>
							</div>
						</div>
					</div>
					<div class="col-xl-2 col-lg-2 col-md-12 col-sm-6 px-lg-0">
						<p class="font-11 bold text-judul">Download Laukpauk</p>
						<a href="https://play.google.com/store/apps/details?id=id.laukpauk" target="_blank">
							<img src="{{ baseURL }}/images/landing-page/more/ps.png" alt="Download Laukpauk"
								style="width:150px;" />
						</a>
					</div>
				</div>
				<div class="row pt-4">
					<div class="col-lg-5 align-items-center d-none d-lg-flex">
						<div class="footer-line"></div>
					</div>
					<div class="col-lg-2 text-center">
						@2026 Laukpauk
					</div>
					<div class="col-lg-5 align-items-center d-none d-lg-flex">
						<div class="footer-line"></div>
					</div>
				</div>
			</div>
		</footer>
		<script defer src="https://static.cloudflareinsights.com/beacon.min.js/v833ccba57c9e4d2798f2e76cebdd09a11778172276447" integrity="sha512-57MDmcccJXYtNnH+ZiBwzC4jb2rvgVCEokYN+L/nLlmO8rfYT/gIpW2A569iJ/3b+0UEasghjuZH/ma3wIs/EQ==" data-cf-beacon="{'version':'2024.11.0','token':'de04ed05247d400f8cec6262b9dd586f','r':1,'server_timing':{'name':{'cfCacheStatus':true,'cfEdge':true,'cfExtPri':true,'cfL4':true,'cfOrigin':true,'cfSpeedBrain':true},'location_startswith':null}}" crossorigin="anonymous"></script>
		<script>
			AOS.init();
			let _navContainer = `<button class="btn btn-danger"></button>`;
			$("#hero").owlCarousel({
				items: 1,
				// autoplay: true,
				autoplaySpeed: 1000,
				dots: false,
				nav: true,
				navText: [`<span class="navigasi"><span class="bi bi-chevron-left"></span></span>`, `<span class="navigasi"><span class="bi bi-chevron-right"></span></span>`],
				loop: true
			});

			function changeAccordionImage(imgURL, accordionTitle, renderPlace, animation = "animate__fadeInRight") {
				let _html = `<img src="${imgURL}" alt="${accordionTitle}"
						class="animate__animated ${animation} img-fluid" />`;
				$(renderPlace).html(_html);
			}

			function onImageError(thisContext) {
				let _el = $(thisContext);
				let _src = `{{ baseURL }}/assets/img/laukpauk-icon.png`;
				_el.attr('src', _src);
			}
		</script>
	</body>
</html>
