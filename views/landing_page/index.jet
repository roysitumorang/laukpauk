<!-- Mashead header-->
<header class="owl-carousel hero-slider owl-theme" id="hero">
	{{ range _, row := hero.Items }}
	<div class="hero-slider-item pb-lg-5">
		<div class="col px-0 mx-xl-5 mx-lg-5 mx-md-0 mx-sm-0 mx-0">
			<div class="mx-md-3 mx-sm-3 mx-3 col-xl-7 col-lg-7 hero-slider-content">
				<div class="mx-5 mx-lg-5 mx-md-0 text-center text-lg-start">
					<h1 class="hero-slider-title display-6 lh-1 mb-3 animate__animated animate__fadeInDown"
						style="font-weight: bold;">{{ row.Subject }}</h1>
					<p class="hero-slider-desc lead fw-normal text-muted mb-4 mb-lg-5 mb-md-5 mb-sm-5 animate__animated animate__fadeInUp"
						style="font-weight: normal !important;">{{ row.Body }}</p>
					<div class="d-flex flex-column flex-lg-row align-items-center animate__animated animate__fadeInDown animate__delay-1s">
						<a href="{{ row.LinkURL }}">
							<button class="btn-download">{{ row.LinkText }}</button>
						</a>
					</div>
				</div>
			</div>
		</div>
		<div class="hero-slider-img-mobile w-100 d-flex d-xl-none d-lg-none d-md-flex d-sm-flex justify-content-end animate__animated animate__fadeInRight animate__delay-1s">
			<img src="{{ baseURL }}/{{ row.PhotoPath() }}" alt="{{ row.Subject }}"
				onError="onImageError(this)" />
		</div>
		<img src="{{ row.PhotoPath() }}" alt="{{ row.Subject }}"
			class="hero-slider-img d-none d-xl-block d-lg-block animate__animated animate__fadeInRight animate__delay-1s"
			onerror="onImageError(this)" />
	</div>
	{{ end }}
</header>
<!-- App features section-->
<section id="fitur" class="bg-white">
	<div class="container px-5">
		<div class="row gx-5 align-items-center" data-aos="fade-down">
			<div class="col-lg-6 order-lg-1 mb-5 mb-lg-0">
				<h2 class="font-40 display-4 lh-1 mb-4 h-title fitur-title">{{ feature.CustomAttributes["subject"] }}</h2>
				<div class="accordion mt-5" id="accordionFiturLaukpauk">
					{{ range _, row := feature.Items }}
					<div class="accordion-item mb-3" onclick="changeAccordionImage('{{ baseURL}}/{{ row.PhotoPath() }}', '{{ row.Subject }}', '#fitur-img', 'animate__fadeInLeft')">
						<h2 class="accordion-header" id="69">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
								data-bs-target="#collapse-69" aria-expanded="true" aria-controls="collapse-69">
							{{ row.Subject }}</button>
						</h2>
						<div id="collapse-69" class="accordion-collapse collapse show"
							aria-labelledby="69" data-bs-parent="#accordionFiturLaukpauk">
							<div class="accordion-body font-8">
								{{ row.Body }}
							</div>
						</div>
					</div>
					{{ end }}
				</div>
			</div>
			<div class="col-lg-4 order-lg-0 offset-lg-2" data-aos="fade-up">
				<!-- Features section device mockup-->
				<div class="features-device-mockup" id="fitur-img">
					<img src="{{ baseURL }}/images/landing-page/feature/Fitur_69_20210803_104305.png" alt="Fitur 1"
						class="img-fluid" onError="onImageError(this)" />
				</div>
			</div>
		</div>
	</div>
</section>
<!-- Basic features section-->
<section class="bg-light" id="why">
	<div class="container px-5" style="z-index:50 !important">
		<div class="row gx-5 align-items-center justify-content-center">
			<div class="col-lg-6 mb-5 mb-lg-0" data-aos="fade-down">
				<h2 class="display-4 lh-1 mb-4 h-title font-40 why-title">{{ why.CustomAttributes["subject"] }}</h2>
				<div class="accordion mt-5" id="accordionWhy">
					{{ range _, row := why.Items }}
					<div class="accordion-item mb-3" onclick="changeAccordionImage('{{ baseURL }}/{{ row.PhotoPath() }}', '{{ row.Subject }}', '#why-img', 'animate__fadeInRight')">
						<h2 class="accordion-header" id="53">
							<button class="accordion-button" type="button" data-bs-toggle="collapse"
								data-bs-target="#collapseMengapa-53" aria-expanded="true"
								aria-controls="collapseMengapa-53">
							{{ row.Subject }}</button>
						</h2>
						<div id="collapseMengapa-53" class="accordion-collapse collapse show"
							aria-labelledby="53" data-bs-parent="#accordionWhy">
							<div class="accordion-body font-8">
								{{ row.Body }}
							</div>
						</div>
					</div>
					{{ end }}
				</div>
				<div class="d-flex flex-column flex-lg-row align-items-center pt-5">
					<a href="{{ why.CustomAttributes["link_url"] }}" target="_blank">
						<button class="btn-download">{{ why.CustomAttributes["link_text"] }}</button>
					</a>
				</div>
			</div>
			<div class="col-lg-4" data-aos="fade-up">
				<!-- Features section device mockup-->
				<div class="features-device-mockup" id="why-img">
					<img src="{{ baseURL }}/images/landing-page/why/Why_53_20210803_114948.png" alt="Gabung"
						class="img-fluid" onerror="onImageError(this)" />
				</div>
			</div>
		</div>
	</div>
</section>
<section class="bg-white" id="uang-belanja-gratis">
	<div class="container px-5">
		<div class="row gx-5 align-items-center justify-content-center justify-content-lg-between">
			<div class="col-lg-8 mb-5 mb-lg-0" data-aos="fade-left" data-aos-delay="1000">
				<h1 class="display-5 lh-1 mb-3 h-title font-40 uang-belanja-gratis-title">{{ freeShopping.CustomAttributes["subject"] }}</h1>
				<div class="mt-5">
					{{ freeShopping.CustomAttributes["body"] | raw }}
				</div>
			</div>
			<div class="col-lg-4" data-aos="fade-right" data-aos-delay="500">
				<!-- Features section device mockup-->
				<div class="features-device-mockup">
					<img src="{{ baseURL }}/images/landing-page/free-shopping/{{ freeShopping.CustomAttributes["photo"] }}" alt="Uang Belanja Gratis"
						class="w-100" onError="onImageError(this)" />
				</div>
			</div>
		</div>
	</div>
</section>
<!-- Call to action section-->
<section class="bg-gradient" data-aos="fade-up" id="komitmen">
	<div class="container px-5 py-5 text-center">
		<h2 class="text-white display-6 lh-1 mb-5"
			data-aos="fade-down" data-aos-delay="150">{{ commitment.CustomAttributes["subject"] }}</h2>
		<p class="lead fw-normal text-white mb-3" style="font-weight: normal !important;"
			data-aos="fade-up" data-aos-delay="500">
			{{ commitment.CustomAttributes["body"] | raw }}
		</p>
	</div>
</section>
<section class="bg-white" id="pahlawan-dapur">
	<div class="container px-5">
		<div class="row gx-5 align-items-center justify-content-center justify-content-lg-between">
			<div class="col-lg-4" data-aos="fade-right">
				<!-- Features section device mockup-->
				<div class="features-device-mockup" id="pahlanwan-dapur">
					<img src="{{ baseURL }}/images/landing-page/kitchen-hero/{{ kitchenHero.CustomAttributes["photo"] }}" alt="Emak Gendong Anak"
						class="w-100" onerror="onImageError(this)" />
				</div>
			</div>
			<div class="col-lg-8 mb-5 mb-lg-0" data-aos="fade-left" data-aos-delay="300">
				{{ kitchenHero.CustomAttributes["body"] | raw }}
			</div>
		</div>
	</div>
</section>
