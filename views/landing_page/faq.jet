<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
	<meta name="description" content="" />
	<meta name="author" content="" />
	<meta name="facebook-domain-verification" content="oxv3vp8mas5nnzqety27iat2v2fpae" />
	<title>{{ pageTitle }}</title>
	<script src="{{ baseURL }}/assets/plugins/jquery/jquery.js"></script>
	<script src="{{ baseURL }}/assets/plugins/bootstrap/bs-js/bootstrap.bundle.min.js"></script>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
	<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/bootstrap/bs-css/bootstrap.min.css" />
	<link rel="stylesheet" href="{{ baseURL }}/assets/css/styles.css" />
	<link rel="icon" type="image/x-icon" href="{{ baseURL }}/upload/gambar/landing-page-imgs/more/laukpauk-icon.png" />
	<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/icons-1.5.0/font/bootstrap-icons.css" />
	<style type="text/css">
		a {
			color: #66cc99;
			text-decoration: none;
		}
		.font-40 {
			font-size: 40pt;
		}
		.font-11 {
			font-size: 11pt;
		}
		.font-10 {
			font-size: 10pt;
		}
		.font-9 {
			font-size: 9pt;
		}
		.font-8 {
			font-size: 8pt;
		}
		.bold {
			font-weight: bold;
		}
	</style>
</head>
<body id="page-top">
	<section id="bantuan" class="pt-4">
		<div class="container">
			<div class="col mb-4">
				<span class="bi bi-chevron-left pr-5 d-inline-block"></span>
				<span class="text-bold">
					<a href="{{ baseURL }}">Kembali ke Home</a>
				</span>
			</div>
			<div class="col-lg-12 mb-3">
				<h4>Bantuan</h4>
			</div>
			<div class="col-lg-12">
				<div class="accordion">
					{{ range _, row := rows }}
					<div class="accordion-item mb-3" id="accordionBantuan-{{ row.ID }}">
						<h2 class="accordion-header" id="87">
							<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
								data-bs-target="#collapse-87" aria-expanded="true" aria-controls="collapse-87">{{ row.Subject }}</button>
						</h2>
						<div id="collapse-{{ row.ID }}" class="accordion-collapse collapse show"
							aria-labelledby="{{ row.ID }}" data-bs-parent="#accordionBantuan-{{ row.ID }}">
							<div class="accordion-body">
								{{ row.Body | raw }}
							</div>
						</div>
					</div>
					{{ end }}
				</div>
			</div>
		</div>
	</section>
	<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script>
	<script defer src="https://static.cloudflareinsights.com/beacon.min.js/v833ccba57c9e4d2798f2e76cebdd09a11778172276447" integrity="sha512-57MDmcccJXYtNnH+ZiBwzC4jb2rvgVCEokYN+L/nLlmO8rfYT/gIpW2A569iJ/3b+0UEasghjuZH/ma3wIs/EQ==" data-cf-beacon="{'version':'2024.11.0','token':'de04ed05247d400f8cec6262b9dd586f','r':1,'server_timing':{'name'    :{'cfCacheStatus':true,'cfEdge':true,'cfExtPri':true,'cfL4':true,'cfOrigin':true,'cfSpeedBrain':true},'location_startswith':null}}" crossorigin="anonymous"></script>
	<link rel="stylesheet" href="{{ baseURL }}/assets/css/custom-landing-page-style.css" />
	<script type="text/javascript">
		AOS.init();
		$("#hero").owlCarousel({
			items: 1
		});
		function changeAccordionImage(imgURL, accordionTitle, renderPlace, animation = "animate__fadeInRight") {
			let _html = `<img src="${imgURL}" alt="${accordionTitle}"
					class="animate__animated ${animation} img-fluid" />`;
			$(renderPlace).html(_html);
		}
		function onImageError(thisContext){
			let _el = $(thisContext);
			let _src = `{{ baseURL }}/assets/img/laukpauk-icon.png`;
			_el.attr("src", _src);
		}
	</script>
</body>
</html>

