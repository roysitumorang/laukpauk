<div class="container px-5">
	<div class="row">
		<div class="col-lg-8">
			<p style="font-size: 16px; font-weight: bold;">Hubungi Kami</p>
			<br />
			<h6>Laukpauk</h6>
			<p class="text-sm text-muted mb-4">
				Jl.Sedap Malam III E no.18<br />
				Telp / WA (061) 8367205
			</p>
			<!--
			<p class="text-sm text-muted mb-4">
				atau hubungi kami melalui <a href="mailto:info@laukpauk.id" target="_blank">email</a>
			</p>
			-->
		</div>
		<div class="col-lg-4 border-left-1">
			<p style="font-size: 16px; font-weight: bold;">Hubungi Kami melalui Email</p>
			<br />
			{{ range type, message := flash.Data }}
			<div class="alert alert-{{ type }}">
				<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
			</div>
			{{ end }}
			<form method="POST" action="{{ baseURL }}/contact-us">
				<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
				<div class="form-group mb-3">
					<label for="name" class="mb-2 bold">Nama</label>
					<input type="text" name="name" value="{{ request.Name }}" id="name" class="form-control" />
				</div>
				<div class="form-group mb-3">
					<label for="mobile_phone" class="mb-2 bold">HP</label>
					<input type="text" name="mobile_phone" value="{{ request.MobilePhone }}" id="mobile_phone" class="form-control" />
				</div>
				<div class="form-group mb-3">
					<label for="message" class="mb-2 bold">Berita</label>
					<textarea name="message" id="message" class="form-control">{{ request.Message }}</textarea>
				</div>
				<hr />
				<button type="submit" class="btn btn-success" id="btnSubmit">Kirim</button>
			</form>
		</div>
	</div>
</section>
