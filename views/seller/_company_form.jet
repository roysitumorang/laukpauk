{{ range type, message := flash.Data }}
<div class="alert alert-{{ type }}">
	<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
</div>
{{ end }}
<form method="POST" action="{{ baseURL }}/seller/companies/mine" enctype="multipart/form-data">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !company.New() }}<input type="hidden" name="id" value="{{ company.ID }}" />{{ end }}
	<div class="row">
		<div class="col-lg-12">
			<div class="form-group">
				<label for="subject" class="label-title">Name</label>
				<input type="text"
					name="name"
					value="{{ request.Name }}"
					id="name"
					class="form-control"
					placeholder="Name" />
			</div>
			<div class="form-group">
				<input type="checkbox" name="android" id="android" class="mr-2"{{ if request.Android }} checked{{ end }} disabled />
				<label for="android" class="label-title cp">Android</label>
			</div>
			<div class="form-group">
				<label for="subdomain" class="label-title">Subdomain</label>
				<input type="text"
					name="subdomain"
					value="{{ if request.Subdomain }}{{ request.Subdomain }}{{ end }}"
					id="subdomain"
					class="form-control"
					placeholder="Subdomain" />
			</div>
			<div class="form-group">
				<input type="checkbox" name="billed" id="billed" class="mr-2"{{ if request.Billed }} checked{{ end }} disabled />
				<label for="billed" class="label-title cp">Billed</label>
			</div>
			<div class="form-group">
				<label for="telegram_bot_token" class="label-title">Telegram Bot Token</label>
				<input type="text"
					name="telegram_bot_token"
					value="{{ if request.TelegramBotToken }}{{ request.TelegramBotToken }}{{ end }}"
					id="telegram_bot_token"
					class="form-control"
					placeholder="Telegram Bot Token" disabled />
			</div>
			<div class="form-group">
				<label for="whatsapp_phone_number" class="label-title">Whatsapp Phone Number</label>
				<input type="text"
					name="whatsapp_phone_number"
					value="{{ if request.WhatsappPhoneNumber }}{{ request.WhatsappPhoneNumber }}{{ end }}"
					id="whatsapp_phone_number"
					class="form-control"
					placeholder="Whatsapp Phone Number" />
			</div>
			<div class="form-group">
				<input type="checkbox" name="vacation_mode" id="vacation_mode" class="mr-2"{{ if request.VacationMode }} checked{{ end }} />
				<label for="vacation_mode" class="label-title cp">Vacation Mode</label>
			</div>
			<div class="form-group">
				<label for="vacation_end_date" class="label-title">Tanggal Terakhir Libur</label>
				<input type="date" name="vacation_end_date" value="{{ if request.VacationMode }}{{ request.RawVacationEndDate }}{{ end }}" id="vacation_end_date"
					class="form-control date-picker"{{ if !request.VacationMode }} disabled{{ end }} />
			</div>
			<div class="form-group">
				<input type="checkbox" name="voucher_enabled" id="voucher_enabled" class="mr-2"{{ if request.VoucherEnabled }} checked{{ end }} />
				<label for="voucher_enabled" class="label-title cp">Voucher Enabled</label>
			</div>
			<div class="form-group">
				<input type="checkbox" name="referral_points_enabled" id="referral_points_enabled" class="mr-2"{{ if request.ReferralPointsEnabled }} checked{{ end }} />
				<label for="referral_points_enabled" class="label-title cp">Referral Points Enabled</label>
			</div>
			<div class="form-group">
				<label for="referral_points_minimum_shopping_cost" class="label-title">Referral Points Minimum Shopping Cost (IDR)</label>
				<input type="number"
					name="referral_points_minimum_shopping_cost"
					value="{{ request.ReferralPointsMinimumShoppingCost }}"
					id="referral_points_minimum_shopping_cost"
					class="form-control"
					placeholder="Referral Points Minimum Shopping Cost"
					min="0" />
			</div>
			<div class="form-group">
				<label for="referral_points_amount" class="label-title">Referral Points Amount</label>
				<input type="number"
					name="referral_points_amount"
					value="{{ request.ReferralPointsAmount }}"
					id="referral_points_amount"
					class="form-control"
					placeholder="Referral Points Amount"
					min="0" />
			</div>
			<div class="form-group">
				<label for="referral_points_slots" class="label-title">Referral Points Slots (separated by comma)</label>
				<input type="text"
					name="referral_points_slots"
					value="{{ request.RawReferralPointsSlots }}"
					id="referral_points_slots"
					class="form-control"
					placeholder="Referral Points Slots"
					min="0" />
			</div>
			<div class="form-group">
				<label for="reward_points_accumulation_window_in_days" class="label-title">Reward Points Accumulation Window (in days)</label>
				<input type="number"
					name="reward_points_accumulation_window_in_days"
					value="{{ request.RewardPointsAccumulationWindowInDays }}"
					id="reward_points_accumulation_window_in_days"
					class="form-control"
					placeholder="Reward Points Accumulation Window"
					min="0" />
			</div>
			<div class="form-group">
				<label for="delivery_origin" class="label-title">Delivery Origin (Longitude - Latitude)</label>
				<div class="input-group" id="delivery_origin">
					<input type="text" name="delivery_origin_longitude" value="{{ request.DeliveryOriginLongitude }}" id="delivery_origin_longitude"
						class="form-control" />
					<input type="text" name="delivery_origin_latitude" value="{{ request.DeliveryOriginLatitude }}" id="delivery_origin_latitude"
						class="form-control" />
				</div>
			</div>
			<div class="form-group">
				<label for="delivery_cost_per_km" class="label-title">Delivery Cost per KM</label>
				<input type="number"
					name="delivery_cost_per_km"
					value="{{ request.DeliveryCostPerKM }}"
					id="delivery_cost_per_km"
					class="form-control"
					placeholder="Delivery Cost per KM"
					min="0" />
			</div>
			<div class="form-group">
				<label for="delivery_max_distance_km" class="label-title">Delivery Max Distance in KM</label>
				<input type="number"
					name="delivery_max_distance_km"
					value="{{ request.DeliveryMaxDistanceKM }}"
					id="delivery_max_distance_km"
					class="form-control"
					placeholder="Delivery Max Distance in KM"
					min="0" />
			</div>
			<div class="form-group">
				<label for="payment_terms" class="label-title">Payment Terms</label>
				<input type="text"
					name="payment_terms"
					value="{{ request.PaymentTerms }}"
					id="payment_terms"
					class="form-control"
					placeholder="24h" />
			</div>
			<div class="form-group">
				<label for="maximum_delivery_time" class="label-title">Maximum Delivery Time</label>
				<input type="text"
					name="maximum_delivery_time"
					value="{{ request.MaximumDeliveryTime }}"
					id="maximum_delivery_time"
					class="form-control"
					placeholder="2h" />
			</div>
			<div class="form-group">
				<input type="checkbox" name="transaction_auto_withdrawal_enabled" id="transaction_auto_withdrawal_enabled" class="mr-2"{{ if request.TransactionAutoWithdrawalEnabled }} checked{{ end }} />
				<label for="transaction_auto_withdrawal_enabled" class="label-title cp">Transaction Auto Withdrawal Enabled</label>
			</div>
			<div class="form-group">
				<label for="transaction_auto_withdrawal_window" class="label-title">Transaction Auto Withdrawal Effective Window (Mulai - Sampai)</label>
				<div class="input-group" id="transaction_auto_withdrawal_window">
					<input type="time" name="transaction_auto_withdrawal_window_min" value="{{ request.RawTransactionAutoWithdrawalWindowMin }}" id="transaction_auto_withdrawal_window_min"
						step="1" class="form-control time-picker" required />
					<input type="time" name="transaction_auto_withdrawal_window_max" value="{{ request.RawTransactionAutoWithdrawalWindowMax }}" id="transaction_auto_withdrawal_window_max"
						step="1" class="form-control time-picker" required />
				</div>
			</div>
			<button type="submit" class="btn btn-success mr-1">
				Simpan Perubahan Data Company
			</button>
		</div>
	</div>
</form>
<script>
	document.addEventListener("DOMContentLoaded", () => {
		flatpickr(".date-picker", {
			altInput: true,
			altFormat: "j F Y",
			dateFormat: "Y-m-d",
		});
		flatpickr(".time-picker", {
			noCalendar: true,
			enableTime: true,
			enableSeconds: true,
			time_24hr: true,
			dateFormat: "H:i:S",
			minuteIncrement: 1,
		});
		const vacationMode = document.getElementById("vacation_mode");
		const vacationEndDate = document.getElementById("vacation_end_date");
		const vacationEndDateNextSibling = vacationEndDate.nextElementSibling
		vacationMode.addEventListener("change", (event) => {
			if (event.target.checked) {
				vacationEndDate.removeAttribute("disabled");
				vacationEndDateNextSibling.removeAttribute("disabled");
				return;
			}
			vacationEndDate.value = "";
			vacationEndDate.setAttribute("disabled", "disabled");
			vacationEndDateNextSibling.value = "";
			vacationEndDateNextSibling.setAttribute("disabled", "disabled");
		});
		const transactionAutoWithdrawalEnabled = document.getElementById("transaction_auto_withdrawal_enabled");
		const transactionAutoWithdrawalWindowMin = document.getElementById("transaction_auto_withdrawal_window_min");
		const transactionAutoWithdrawalWindowMinNextSibling = transactionAutoWithdrawalWindowMin.nextElementSibling;
		const transactionAutoWithdrawalWindowMax = document.getElementById("transaction_auto_withdrawal_window_max");
		const transactionAutoWithdrawalWindowMaxNextSibling = transactionAutoWithdrawalWindowMax.nextElementSibling;
		transactionAutoWithdrawalEnabled.addEventListener("change", (event) => {
			if (event.target.checked) {
				transactionAutoWithdrawalWindowMin.removeAttribute("disabled");
				transactionAutoWithdrawalWindowMinNextSibling.removeAttribute("disabled");
				transactionAutoWithdrawalWindowMax.removeAttribute("disabled");
				transactionAutoWithdrawalWindowMaxNextSibling.removeAttribute("disabled");
				return;
			}
			transactionAutoWithdrawalWindowMin.value = "";
			transactionAutoWithdrawalWindowMin.setAttribute("disabled", "disabled");
			transactionAutoWithdrawalWindowMinNextSibling.value = "";
			transactionAutoWithdrawalWindowMinNextSibling.setAttribute("disabled", "disabled");
			transactionAutoWithdrawalWindowMax.value = "";
			transactionAutoWithdrawalWindowMax.setAttribute("disabled", "disabled");
			transactionAutoWithdrawalWindowMaxNextSibling.value = "";
			transactionAutoWithdrawalWindowMaxNextSibling.setAttribute("disabled", "disabled");
		});
	});
</script>
