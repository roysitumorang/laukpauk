<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Resep</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Detail Resep
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Detail Resep</h5>
							{{ recipe.Name }}
						</div>
						<div class="col-lg-8 text-right"></div>
					</div>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="offset-lg-2"></div>
							<div class="col-lg-3 text-center">
								<img src="{{ recipe.PhotoPath(baseURL) }}"
									alt="{{ recipe.Name }}"
									class="img-circle"
									style="width:180px; height:180px;" />
							</div>
							<div class="col-lg-6">
								<h2 class="text-primary text-bold mb-4">{{ recipe.Name }}</h2>
								<div class="table-responsive">
									<table class="table table-sm">
										<tr class="text-sm">
											<td class="border-top-0 text-left">Instagram Link</td>
											<td class="border-top-0 text-left">
												<a href="{{ recipe.InstagramLink }}" target="_blank">{{ recipe.InstagramLink }}</a>
											</td>
										</tr>
										<tr class="text-sm">
											<td class="border-top-0 text-left">Facebook Link</td>
											<td class="border-top-0 text-left">
												<a href="{{ recipe.FacebookLink }}" target="_blank">{{ recipe.FacebookLink }}</a>
											</td>
										</tr>
										<tr class="text-sm">
											<td class="border-top-0 text-left">Keterangan</td>
											<td class="border-top-0 text-left">{{ if recipe.Description }}{{ recipe.Description }}{{ else }}-{{ end }}</td>
										</tr>
										<tr class="text-sm">
											<td class="border-top-0 text-left">Dibuat</td>
											<td class="border-top-0 text-left">
												{{ recipe.CreatedAt.Format("Mon, 2 Jan 2006 15:04:05 MST") }}
											</td>
										</tr>
										<tr class="text-sm">
											<td class="border-top-0 text-left">Terakhir Diperbaharui</td>
											<td class="border-top-0 text-left">
												{{ recipe.UpdatedAt.Format("Mon, 2 Jan 2006 15:04:05 MST") }}
											</td>
										</tr>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-lg-6">
						<div class="card">
							<div class="card-header">
								<div class="row">
									<div class="col-lg-4">
										<h5>Resep Item</h5>
										<span class="text-sm">{{ recipe.Name }}</span>
									</div>
									<div class="col-lg-8 text-right"></div>
								</div>
							</div>
							<div class="card-body">
								{{ include "_recipe_item_form" }}
								<hr class="mb-3" />
								<div class="table-responsive">
									<table class="table table-sm">
										<thead>
											<tr>
												<th class="text-center border-top-0">No.</th>
												<th class="text-left border-top-0">Produk</th>
												<th class="text-left border-top-0">Catatan</th>
												<th class="text-center border-top-0">Opsi</th>
											</tr>
										</thead>
										<tbody>
											{{ range _, row := recipeItems }}
											<tr class="text-sm tr-parent">
												<td class="vam text-center"><b>{{ row.RowNo }}.</b></td>
												<td class="vam text-left">
													<div class="row">
														<div class="col-lg-4 text-center">
															<img src="{{ row.ProductPhotoPath(baseURL) }}"
																alt="{{ row.ProductName }}"
																class="img-circle"
																style="width:50px; height:50px;" />
														</div>
														<div class="col-lg-8">
															<h6 class="text-primary mb-1">{{ row.ProductName }}</h6>
															<p class="text-muted text-sm">{{ row.Amount }} {{ row.ProductVariantStockUnit }}</p>
														</div>
													</div>
												</td>
												<td class="vam text-left"><i class="text-muted">{{ if row.Note }}{{ row.Note }}{{ else }}Tanpa Catatan{{ end }}</i></td>
												<td class="vam text-center">
													<a href="{{ baseURL }}/seller/recipes/{{ row.RecipeID }}/items/{{ row.ID }}/edit">
														<span class="fa fa-edit text-warning cp mr-2"
														title="Edit Resep Item"
														data-toggle="tooltip"
														data-placement="top"></span>
													</a>
													<form method="POST" action="{{ baseURL }}/seller/recipes/{{ row.RecipeID }}/items/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
														<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
															<span class="fa fa-trash text-danger cp ml-2"
																data-toggle="tooltip"
																data-placement="top"
																title="Hapus Data Resep Item"
																onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
														</span>
													</form>
												</td>
											</tr>
											{{ end }}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
					<div class="col-lg-6">
						<div class="card">
							<div class="card-header">
								<div class="row">
									<div class="col-lg-4">
										<h5>Langkah Memasak</h5>
										<span class="text-sm">{{ recipe.Name }}</span>
									</div>
									<div class="col-lg-8 text-right"></div>
								</div>
							</div>
							<div class="card-body">
								<label class="cp label-title mb-3">
									<a href="{{ baseURL }}/seller/recipes/{{ recipe.ID }}/guides/new">
										<span class="cp fa fa-plus-circle mr-2"></span> Tambah Langkah Masak Baru
									</a>
								</label>
								<hr class="mb-3" />
								<div class="table-responsive">
									<table class="table table-sm">
										<thead>
											<tr>
												<th class="text-center border-top-0">No.</th>
												<th class="text-left border-top-0">Langkah</th>
												<th class="text-center border-top-0">Opsi</th>
											</tr>
										</thead>
										<tbody>
											{{ range _, row := recipeGuides }}
											<tr class="text-sm tr-parent">
												<td class="py-3 vam text-center"><b>{{ row.RowNo }}.</b></td>
												<td class="py-3 vam text-left">{{ row.Instruction }}</td>
												<td class="py-3 vam text-center">
													<a href="{{ baseURL }}/seller/recipes/{{ row.RecipeID }}/guides/{{ row.ID }}/edit">
														<span class="fa fa-edit text-warning cp mr-2"
															title="Edit Langkah Item"
															data-toggle="tooltip"
															data-placement="top"></span>
													</a>
													<form method="POST" action="{{ baseURL }}/seller/recipes/{{ row.RecipeID }}/guides/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
														<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
															<span class="fa fa-trash text-danger cp ml-2"
																data-toggle="tooltip"
																data-placement="top"
																title="Hapus Data Langkah Item"
																onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
														</span>
													</form>
												</td>
											</tr>
											{{ end }}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
