{{ range type, message := flash.Data }}
<div class="alert alert-{{ type }}">
	<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
</div>
{{ end }}
<form method="POST" action="{{ baseURL }}/seller/point_earning_caps{{ if !pointEarningCap.New() }}/{{ pointEarningCap.ID }}{{ end }}" id="formPoin">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !pointEarningCap.New() }}<input type="hidden" name="id" value="{{ pointEarningCap.ID }}" />{{ end }}
	<div class="row">
		<div class="col-lg-12">
			<div class="row">
				<div class="col-lg-4">
					<div class="form-group">
						<label for="shopping_cost" class="label-nilai">Minimal Pembelian</label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text">Rp.</span>
							</div>
							<input type="number" name="minimum_shopping_cost" value="{{ if request.MinimumShoppingCost }}{{ request.MinimumShoppingCost }}{{ end }}" class="form-control input" id="minimum_shopping_cost"
								placeholder="Minimal Pembelian" required />
						</div>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="form-group">
						<label for="maximum_shopping_cost" class="label-nilai">Maksimal Pembelian</label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text">Rp.</span>
							</div>
							<input type="number" name="maximum_shopping_cost" value="{{ if request.MaximumShoppingCost }}{{ request.MaximumShoppingCost }}{{ end }}" class="form-control input" id="maximum_shopping_cost"
								placeholder="Maksimal Pembelian" required />
						</div>
					</div>
				</div>
				<div class="col-lg-4">
					<div class="form-group">
						<label for="earned_points" class="label-nilai">Poin</label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text">Rp.</span>
							</div>
							<input type="number" name="earned_points" value="{{ request.EarnedPoints }}" class="form-control input" id="earned_points"
								placeholder="Poin" required />
						</div>
					</div>
				</div>
			</div>
			<hr class="mb-4" />
			<button type="submit" class="btn btn-success mr-1" id="btnSubmit">
				Simpan Data Tarif Akumulasi Poin
			</button>
			<a href="{{ baseURL }}/seller/point_earning_caps" class="btn btn-link btn-sm">
				List Tarif Akumulasi Poin
			</a>
		</div>
	</div>
</form>
