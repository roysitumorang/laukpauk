<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Point Seluruh User</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">Histori Point User</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col">
							<div class="row">
								<div class="col-lg-4 ">
									<h5 class="mb-1">Histori Point</h5>
								</div>
								<div class="col-lg-8 text-right">
									<a href="{{ baseURL }}/seller/points/new">
										Tambah Poin User
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card-body">
					<div class="table-responsive">
						{{ range type, message := flash.Data }}
						<div class="alert alert-{{ type }}">
							<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
						</div>
						{{ end }}
						<form method="GET" action="/seller/points" id="search">
							<div class="row">
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Show
											<select name="limit" id="limit" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, limit := limits }}
												<option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
												{{ end }}
											</select> entries
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div id="listBlog_filter" class="dataTables_filter">
										<label for="q">
											Search: <input type="text" name="q" id="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Sort by
											<select name="sort_by" multiple id="sort_by" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, sorting := sortings }}
												<option value="{{ sorting.String() }}"{{ if request.MapSortings.Contains(sorting.String()) }} selected{{ end }}>{{ sorting.Label }}</option>
												{{ end }}
											</select>
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
										<button type="reset" class="btn btn-default" id="reset"><i class="fa fa-sync"></i> Reset</button>
									</div>
								</div>
							</div>
						</form>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
						<table class="table table-sm table-stripped" id="tabelPoin">
							<thead>
								<tr>
									<th class="text-center">No.</th>
									<th class="text-left">User</th>
									<th class="text-right">Nilai</th>
									<th class="text-left">Asal</th>
									<th class="text-center">Opsi</th>
								</tr>
							</thead>
							<tbody>
								{{ range _, row := rows }}
								<tr class="text-sm tr-parent">
									<td class="text-center"><b>{{ row.RowNo }}.</b></td>
									<td class="text-left">
										<div class="row">
											<div class="col pl-3">
												<h6 class="mb-0 text-bold text-primary">{{ row.BuyerName }} ({{ row.BuyerUsername }})</h6>
												<p class="mb-0 text-sm text-muted">HP <b>{{ row.BuyerMobilePhone }}</b></p>
												<p class="mb-0 text-sm text-muted">Kode Referal <b>{{ row.BuyerReferralCode }}</b></p>
											</div>
										</div>
									</td>
									<td class="text-right">
										<div class="text-right">
											<h6 class="badge badge-{{ if row.Spendable() }}success{{ else }}seconday{{ end }}">Rp. {{ row.Amount | Comma }}</h6>
											<span class="text-muted text-sm">{{ row.Description }}</span>
										</div>
									</td>
									<td class="text-left">
										{{ row.PointType.String() }}{{ if row.TransactionReferenceNumber }} transaksi {{ row.TransactionReferenceNumber }}{{ end }}<br>
										<span class="text-sm text-muted">Dibuat pada <b>{{ row.CreatedAt.Format("Mon, 2 Jan 2006 15:04:05") }}</b></span>
										{{ if row.UpdatedAt.After(row.CreatedAt) }}
										<p class="text-sm mb-0 mt-1 text-muted">
											Diupdate pada <b>{{ row.UpdatedAt.Format("Mon, 2 Jan 2006 15:04:05") }}</b>
										</p>
										{{ end }}
									</td>
									<td class="vam text-center">
										<a href="{{ baseURL }}/seller/points/{{ row.ID }}/edit">
											<span class="fa fa-edit text-warning cp mr-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Edit Data Point">
											</span>
										</a>
										<form method="POST" action="{{ baseURL }}/seller/points/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
											<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
											<span class="fa fa-trash text-danger cp ml-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Hapus Data Point"
												onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
											</span>
										</form>
									</td>
								</tr>
								{{ end }}
							</tbody>
						</table>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("reset").addEventListener("click", (event) => {
			event.preventDefault();
			let form = event.target.form;
			form.querySelectorAll("input[type=text]").forEach((select) => select.value = "");
			form.querySelectorAll("select").forEach((select) => select.selectedIndex = 0);
		});
	});
</script>
