{{ range type, message := flash.Data }}
<div class="alert alert-{{ type }}">
	<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
</div>
{{ end }}
<form method="POST" action="{{ baseURL }}/seller/blogs{{ if !blog.New() }}/{{ blog.ID }}{{ end }}" enctype="multipart/form-data">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !blog.New() }}<input type="hidden" name="id" value="{{ blog.ID }}" />{{ end }}
	<div class="row">
		<div class="col-lg-4 text-center">
			<label for="photo">
				<img src="{{ if request.Photo }}{{ request.PhotoPath(baseURL) }}{{ else }}{{ baseURL}}/assets/img/upload-icon.png{{ end }}"
					alt="Foto Blog"
					class="w-100 cp"
					data-toggle="tooltip"
					data-placement="left"
					title="Klik Gambar untuk Memilih Gambar"
					id="photo_preview" />
				<input type="file" name="photo" id="photo" accept="image/*" />
			</label>
		</div>
		<div class="col-lg-8">
			<div class="form-group">
				<label for="subject" class="label-title">Title</label>
				<input type="text"
					class="form-control"
					name="subject"
					id="subject"
					placeholder="Sekarang Anda bisa ke pasar dekat rumah, sambil pilih-pilih kebutuhan dapur"
					value="{{ request.Subject }}" />
			</div>
			<div class="form-group">
				<label for="slug" class="label-title">Slug</label>
				<input type="text"
					class="form-control"
					name="slug"
					id="slug"
					placeholder="Slug"
					value="{{ if request.Slug }}{{ request.Slug }}{{ end }}" />
			</div>
			<div class="form-group">
				<label for="body" class="label-title">Content</label>
				<textarea class="form-control"
					name="body"
					id="body"
					placeholder="Your Content Here">{{ request.Body }}</textarea>
			</div>
			<hr />
			<button type="submit" class="btn btn-success mr-1">
				Simpan{{ if !blog.New() }} Perubahan{{ end }} Data Blog
			</button>
			<a href="{{ baseURL }}/seller/blogs" class="btn btn-default ml-1">
				Back to List Blog
			</a>
		</div>
	</div>
</form>
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.css" />
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.css" />
<script>
	document.addEventListener("DOMContentLoaded", () => {
		$("#body").summernote({
			toolbar: _summernoteCustomToolbar
		});
		document.getElementById("photo").addEventListener("change", (event) => {
			let file = event.target.files[0]
			if (!file || !file.type.startsWith("image/")) {
				return;
			}
			let preview = document.getElementById("photo_preview");
			preview.setAttribute("src", URL.createObjectURL(file));
			preview.classList.add("img-thumbnail");
		});
	});
</script>
