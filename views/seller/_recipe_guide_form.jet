{{ range type, message := flash.Data }}
<div class="alert alert-{{ type }}">
	<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
</div>
{{ end }}
<form method="POST" action="{{ baseURL }}/seller/recipes/{{ recipe.ID }}/guides{{ if !recipeGuide.New() }}/{{ recipeGuide.ID }}{{ end }}">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !recipeGuide.New() }}
	<input type="hidden" name="id" value="{{ recipeGuide.ID }}" />
	{{ end }}
	<div class="row">
		<div class="form-group col-lg-12">
			<label for="instruction" class="label-title">Langkah Masak</label>
			<textarea name="instruction"
				id="instruction"
				placeholder="Langkah Masak"
				class="form-control">{{ request.Instruction }}</textarea>
		</div>
	</div>
	<button type="submit" class="btn btn-success">Simpan Langkah Masak</button>
	<a href="{{ baseURL }}/seller/recipes/{{ recipe.ID }}" class="btn btn-default ml-1">
		Back to Detail Resep
	</a>
</form>
