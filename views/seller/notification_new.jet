<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Push Notifikasi Baru</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Notifikasi Baru
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<div class="row">
								<div class="col-lg-4">
									<h5>Notifikasi Baru</h5>
								</div>
								<div class="col-lg-8 text-right"></div>
							</div>
						</div>
						<div class="card-body">
							{{ range type, message := flash.Data }}
							<div class="alert alert-{{ type }}">
								<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
							</div>
							{{ end }}
							<form method="POST" action="{{ baseURL }}/seller/notifications" enctype="multipart/form-data">
								<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
									<div class="row">
									<div class="col-lg-4">
										<label for="notifikasiImg">
											<img src="{{ baseURL }}/assets/img/upload-icon.png"
												alt="Gambar Pendukung Notifikasi"
												data-toggle="tooltip"
												class="w-100 cp"
												data-placement="left"
												title="Klik Gambar untuk Memilih/Mengganti Gambar Notifikasi"
												id="photo_preview" />
											<input type="file" name="photo" id="photo" accept="image/*" />
										</label>
									</div>
									<div class="col-lg-8">
										<div class="form-group">
											<label for="user_id" class="label-title">Penerima Notifikasi</label>
											<select name="buyer_id" id="buyer_id" class="form-control" required>
												<option value="" disabled>- Pilih Penerima -</option>
												{{ range _, buyer := buyers }}
												<option value="{{ buyer.ID }}"{{ if request.BuyerID.Compare(buyer.ID) == 0 }} selected{{ end }}>{{ buyer.Name }}</option>
												{{ end }}
											</select>
										</div>
										<div class="form-group">
											<label for="subject" class="label-title">Judul Notifikasi</label>
											<input type="text"
												name="subject"
												value="{{ request.Subject }}"
												id="subject"
												class="form-control input"
												placeholder="Judul Notifikasi"
												required />
										</div>
										<div class="form-group">
											<label for="body" class="label-title">Pesan Notifikasi</label>
											<textarea name="body"
												id="body"
												class="form-control input"
												placeholder="Pesan Notifikasi">{{ request.Body }}</textarea>
										</div>
										<hr class="mb-4" />
										<button type="submit" class="btn btn-success mr-1">
											Kirim  Notifikasi
										</button>
										<a href="{{ baseURL }}/seller/notifications" class="btn btn-default ml-1">
											Back to List Notifikasi
										</a>
									</div>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("photo").addEventListener("change", (event) => {
			let file = event.target.files[0]
			if (!file || !file.type.startsWith("image/")) {
				return;
			}
			let preview = document.getElementById("photo_preview");
			preview.setAttribute("src", URL.createObjectURL(file));
			preview.classList.add("img-thumbnail");
		});
	});
</script>
