	<!-- ./wrapper -->
	<script>
		let baseURLJS = "{{ baseURL }}/seller/";
		$("[data-toggle=tooltip]").tooltip();
		$(".notifikasi-item").on("click", function(e) {
			e.preventDefault();
			let href = $(this).attr("href");
			let idNotifikasi = $(this).attr("idNotifikasi");
			$.ajax({
				url: `${baseURLJS}/NotifikasiAdmin/toggleStatus/${idNotifikasi}`,
				success: function(responseFromServer) {
					let rFS = JSON.parse(responseFromServer);
					let statusToggleStatus = rFS.statusToggleStatus;
					if (statusToggleStatus) {
						location.href = href;
					}
				}
			});
		});
		$(".not-allowed").on("click", function(e) {
			e.preventDefault();
			// Swal.fire({
			//     title   :   "Not Allowed",
			//     html    :   "Anda tidak diijinkan untuk mengakses halaman ini!",
			//     type    :   "warning"
			// });
			alert("Anda tidak diijinkan untuk mengakses halaman ini!");
		});
		$("body").addClass("layout-fixed layout-navbar-fixed layout-footer-fixed");
		// let environment = "development";
		let environment = "production";
		window.OneSignal = window.OneSignal || [];
		OneSignal.push(function() {
			OneSignal.init({
				appId: (environment === "development") ? "52b56d11-5d2b-43e0-ba06-25f99fbde235" : "21ac8b87-e7cc-48b4-9fba-c38ccdf159c3",
				subdomainName: "laukpauk",
				promptOptions: {
					slidedown: {
						enabled: true,
						autoPrompt: true,
						timeDelay: 1,
						pageViews: 3,
						actionMessage: "Laukpauk ingin mengirimkan notifikasi realtime. Aktifkan fitur ini dengan klik ALLOW",
						acceptButtonText: "ALLOW",
						cancelButtonText: "NO"
					}
				}
			});
			OneSignal.on("notificationDisplay", function(noticationData) {
				notificationReceived();
			});
		});

		function notificationReceived() {
			let notificationRingtone = new Audio("assets/ringtone/notification.mp3");
			notificationRingtone.play();
			let jumlahNotifikasiBelumDibaca = getJumlahNotifikasi(false);
			let notifikasiAdminBelumDibaca = getNotifikasiAdmin(false, 5);
			let notifikasiAdminBelumDibacaHTML = "";
			if (notifikasiAdminBelumDibaca.length >= 1) {
				notifikasiAdminBelumDibaca.forEach((item, index) => {
					notifikasiAdminBelumDibacaHTML += `
						<div class="dropdown-divider"></div>
						<a href="${item.route}" class="notifikasi-item" idNotifikasi="${item.id}">
							<div class="dropdown-item">
								<div class="row">
									<div class="col-lg-2 text-center">
										<span class="fa fa-bell"></span>
									</div>
									<div class="col-lg-10">
										<p class="text-primary mb-1" class="word-break:break-all;">${item.judul.toUpperCase()}</p>
										<span class="text-muted" style="font-size:.75em">Pada ${item.waktu}</span>
									</div>
								</div>
							</div>
						</a>`;
				});
			}
			$("#jumlahNotifikasi").text(jumlahNotifikasiBelumDibaca);
			$("#notifikasi").html(notifikasiAdminBelumDibacaHTML);
		}

		function getJumlahNotifikasi(isRead = null) {
			let jumlahNotifikasi = 0;
			let isReadQS = "";
			if (isRead != null) {
				isReadQS = `${(isRead)? "&isRead=true" : "&isRead=false"}`;
			}
			$.ajax({
				url: `{{ baseURL }}/seller/Admin/getJumlahNotifikasiAdmin?${isReadQS}`,
				async: false,
				success: function(responseFromServer) {
					let rFS = JSON.parse(responseFromServer);
					jumlahNotifikasi = rFS.numberOfAdminNotification;
				}
			});
			return jumlahNotifikasi;
		}

		function getNotifikasiAdmin(isRead = null, limit = null) {
			let notifikasiAdmin = [];
			let isReadQS = "";
			let limitQS = "";
			if (isRead != null) {
				isReadQS = `${(isRead)? "&isRead=true" : "&isRead=false"}`;
			}
			if (limit != null) {
				limitQS = `&limit=${limit}`;
			}
			$.ajax({
				url: `{{ baseURL }}/seller/Admin/getNotifikasiAdmin?${isReadQS}${limitQS}`,
				async: false,
				success: function(responseFromServer) {
					let rFS = JSON.parse(responseFromServer);
					notifikasiAdmin = rFS.notifikasiAdmin;
				}
			});
			return notifikasiAdmin;
		}
	</script>
	<script type="module">
		import { initializeApp } from "https://www.gstatic.com/firebasejs/12.17.0/firebase-app.js";
		import { getMessaging, onMessage, onRegistered } from "https://www.gstatic.com/firebasejs/12.17.0/firebase-messaging.js";
		import { getInstallations, getId } from "https://www.gstatic.com/firebasejs/12.17.0/firebase-installations.js";
		const firebaseConfig = {
			apiKey: "AIzaSyBob-5BSzx71suls2th1WpXpmw5gozG-Mk",
			authDomain: "laukpauk-53b39.firebaseapp.com",
			databaseURL: "https://laukpauk-53b39.firebaseio.com",
			projectId: "laukpauk-53b39",
			storageBucket: "laukpauk-53b39.firebasestorage.app",
			messagingSenderId: "605038317389",
			appId: "1:605038317389:web:767b27e1b3c33226d43104"
		};
		const app = initializeApp(firebaseConfig);
		const vapidKey = "BMNjy4x4XOVtSplXSxg4Xq8ZAlc-6pTZRI-tAMDcYn5in5jrOd5yAEuOMn6I92QEDsrZYicsXNklWjwAFjl5CLk";
		const installations = getInstallations(app);
		const messaging = getMessaging(app);
		async function requestPermission() {
			const permission = await Notification.requestPermission();
			if (permission === "granted") {
				try {
					const fid = await getId(installations);
					console.log("FCM Token:", fid);
					const formData = new FormData();
					formData.append("_csrf", document.querySelector("meta[name='csrf-token']").getAttribute("content"));
					formData.append("fid", fid);
					const response = await fetch("{{ baseURL }}/seller/notification_targets", {
						method: "POST",
						headers: { "X-Request-Id": crypto.randomUUID() },
						body: formData,
						credentials: "include"
					});
				} catch (error) {
					console.error("Token retrieval failed:", error);
				}
			} else {
				console.warn("Notification permission denied.");
			}
		}
		onMessage(messaging, (payload) => {
			console.log("Message received in foreground: ", payload);
		});
		onRegistered(messaging, (fid) => {
			console.log("FCM registered with Firebase Installation ID:", fid);
			const formData = new FormData();
			formData.append("_csrf", document.querySelector("meta[name='csrf-token']").getAttribute("content"));
			formData.append("fid", fid);
			const response = fetch("{{ baseURL }}/seller/notification_targets", {
				method: "POST",
				headers: { "X-Request-Id": crypto.randomUUID() },
				body: formData,
				credentials: "include"
			});
		});
		requestPermission()
	</script>
</body>
</html>
