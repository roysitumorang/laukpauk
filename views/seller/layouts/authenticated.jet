						<img src="{{ currentSeller.PhotoPath(baseURL) }}"
							class="img-circle elevation-2"
							alt="{{ currentSeller.Name }}"
							style="width:3.2rem;" />
						</a>
					</div>
					<div class="info pt-0 pl-3">
						<a href="#" class="d-block mb-0">{{ currentSeller.Name }}</a>
						<p class="text-white text-sm mb-0 mt-1">{{ currentSeller.Username }}</p>
					</div>
				</div>
