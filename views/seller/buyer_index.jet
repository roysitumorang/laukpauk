<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">User</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							List Data User
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Data User</h5>
						</div>
						<div class="col-lg-8 text-right">
							<a href="{{ baseURL }}/seller/buyers/new"
								data-toggle="tooltip"
								data-placement="top"
								title="Tambah User Baru"
								class="mx-3">
								Add New User
							</a>
						</div>
					</div>
				</div>
				<div class="card-body">
					<div class="col-lg-12 table-responsive">
						{{ range type, message := flash.Data }}
						<div class="alert alert-{{ type }}">
							<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
						</div>
						{{ end }}
						<form method="GET" action="/seller/buyers" id="search">
							<div class="row">
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listArtikel_length">
										<label>
											Show
											<select name="limit" aria-controls="listArtikel" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, limit := limits }}
												<option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
												{{ end }}
											</select> entries
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div id="listArtikel_filter" class="dataTables_filter">
										<label>
											Search: <input type="text" name="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Sort by
											<select name="sort_by" multiple id="sort_by" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, sorting := sortings }}
												<option value="{{ sorting.String() }}"{{ if request.MapSortings.Contains(sorting.String()) }} selected{{ end }}>{{ sorting.Label }}</option>
												{{ end }}
											</select>
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
										<button type="reset" class="btn btn-default" id="reset"><i class="fa fa-sync"></i> Reset</button>
									</div>
								</div>
							</div>
						</form>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
						<table class="table-sm table" id="listUser">
							<thead>
								<tr>
									<th class="border-top-0 text-left">No</th>
									<th class="border-top-0 text-left">Nama User</th>
									<th class="border-top-0 text-left">Kode Referal</th>
									<th class="border-top-0 text-right">Belanja</th>
									<th class="border-top-0 text-right">Point</th>
									<th class="border-top-0 text-right">Dompet</th>
									<th class="border-top-0 text-center">Opsi</th>
								</tr>
							</thead>
							<tbody>
								{{ range _, row := rows }}
								<tr class="text-sm tr-parent">
									<td class="text-center"><b>{{ row.RowNo }}.</b></td>
									<td>
										<div class="row">
											<a href="{{ if row.Photo }}{{ row.PhotoPath(baseURL) }}{{ else }}{{ baseURL}}/assets/img/no-image.png{{ end }}" target="_blank">
												<img src="{{ if row.Photo }}{{ row.PhotoPath(baseURL) }}{{ else }}{{ baseURL}}/assets/img/no-image.png{{ end }}"
													class="img-circle cp"
													style="width:50px; height:50px;" />
											</a>
											<div class="col pl-3">
												<h6 class="text-info mb-0">
													<b>{{ row.Name }}</b>
												</h6>
												<span class="text-sm text-muted">{{ row.MobilePhone }}</span>
												<p class="text-sm text-muted mb-0 mt-1">
													{{ if row.Address }}{{ row.Address }}{{ else }}<i>Alamat Tidak Tersedia</i>{{ end }}
												</p>
												<p class="mt-3 text-sm text-muted">
													Bergabung pada <span class="badge badge-primary">{{ row.CreatedAt.Format("Mon, 2 Jan 2006 15:04:05 MST") }}</span>
												</p>
											</div>
										</div>
									</td>
									<td>
										{{ row.ReferralCode }}
										{{ if row.ReferrerID }}
										<p class="text-sm text-muted mb-0">
											Referensi <span class="badge badge-info ml-1">{{ row.ReferrerID }}</span>
										</p>
										{{ else }}
										<p class="mb-0"><i class="text-sm text-muted">Referal tidak dikenal</i></p>
										{{ end }}
									</td>
									<td>
										<div class="text-right text-sm">
											{{ row.TransactionVolume }} x Belanja
											<a href="{{ baseURL }}/seller/transactions?buyer_id={{ row.ID }}">
												<span class="fa fa-shopping-cart ml-2 text-success cp"
													data-toggle="tooltip"
													data-placement="top"
													title="Histori Belanja">
												</span>
											</a>
										</div>
									</td>
									<td>
										<div class="text-sm text-right">
											<b>Rp. {{ row.RewardPoints | Comma }} point</b>
											<a href="{{ baseURL }}/seller/points?buyer_id={{ row.ID }}">
												<span class="fa fa-coins ml-1" title="Histori point"></span>
											</a>
										</div>
									</td>
									<td>
										<div class="text-right text-sm">
											Rp. {{ row.Wallet | Comma }}
											<a href="{{ baseURL }}/seller/wallets?buyer_id={{ row.ID }}">
												<span class="fa fa-dollar-sign text-success cp ml-1"
													data-toggle="tooltip"
													data-placement="top"
													title="Histori Dompet {{ row.Name }}"></span>
											</a>
										</div>
									</td>
									<td class="text-center">
										<a href="{{ baseURL }}/seller/buyers/{{ row.ID }}/edit">
											<span class="fa fa-edit text-warning cp mr-2"
											data-toggle="tooltip"
											data-placement="top"
											title="Edit Data Buyer">
											</span>
										</a>
										<form method="POST" action="{{ baseURL }}/seller/buyers/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
											<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
											<span class="fa fa-trash text-danger cp ml-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Hapus Data Buyer"
												onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
											</span>
										</form>
									</td>
								</tr>
								{{ end }}
							</tbody>
						</table>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("reset").addEventListener("click", (event) => {
			event.preventDefault();
			let form = event.target.form;
			form.querySelectorAll("input[type=text]").forEach((select) => select.value = "");
			form.querySelectorAll("select").forEach((select) => select.selectedIndex = 0);
		});
	});
</script>
