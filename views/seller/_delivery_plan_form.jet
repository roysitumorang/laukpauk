{{ range type, message := flash.Data }}
<div class="alert alert-{{ type }}">
	<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
</div>
{{ end }}
<form method="POST" action="{{ baseURL }}/seller/delivery_plans{{ if !deliveryPlan.New() }}/{{ deliveryPlan.ID }}{{ end }}">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !deliveryPlan.New() }}<input type="hidden" name="id" value="{{ deliveryPlan.ID }}" />{{ end }}
	<div class="row">
		<div class="col-12">
			<div class="form-group">
				<label for="name" class="label-title">Nama</label>
				<input type="text" name="name" value="{{ request.Name }}" id="name"
					class="form-control" placeholder="Nama Jadwal Delivery" required />
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-12">
			<div class="form-group">
				<label for="weekday" class="label-title">Hari</label>
				<select name="weekday" id="weekday" class="form-control" required>
					<option disabled>Silahkan Pilih</option>
					{{ range _, deliveryWeekday := deliveryWeekdays }}
					<option value="{{ deliveryWeekday.Int() }}"{{ if request.Weekday.Equal(deliveryWeekday) }} selected{{ end }}>{{ deliveryWeekday.String() }}</option>
					{{ end }}
				</select>
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-4">
			<div class="form-group">
				<label for="transaction_window_min" class="label-title">Batas Awal Jam Transaksi</label>
				<input type="time" name="transaction_window_min" value="{{ request.RawTransactionWindowMin }}" id="transaction_window_min"
					class="form-control time-picker" step="1" required />
			</div>
		</div>
		<div class="col-4">
			<div class="form-group">
				<label for="transaction_window_max" class="label-title">Batas Akhir Jam Transaksi</label>
				<input type="time" name="transaction_window_max" value="{{ request.RawTransactionWindowMax }}" id="transaction_window_max"
					class="form-control time-picker" step="1" required />
			</div>
		</div>
		<div class="col-4">
			<div class="form-group">
				<label for="delivery_time_interval" class="label-title">Interval Jam Pengantaran</label>
				<input type="text" name="delivery_time_interval" value="{{ request.RawDeliveryTimeInterval }}" id="delivery_time_interval"
					class="form-control" placeholder="1h" required />
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-4">
			<div class="form-group">
				<label for="same_day" class="label-title">Same Day</label>
				<input type="checkbox" name="same_day" value="1" id="same_day"{{ if request.SameDay}} checked{{ end }} />
			</div>
		</div>
		<div class="col-4">
			<div class="form-group">
				<label for="same_day_window_min" class="label-title">Batas Awal Jam Pengantaran</label>
				<input type="time" name="same_day_window_min" value="{{ request.RawSameDayWindowMin }}" id="same_day_window_min"
					class="form-control time-picker" step="1" required{{ if !request.SameDay }} disabled{{ end }} />
			</div>
		</div>
		<div class="col-4">
			<div class="form-group">
				<label for="same_day_window_max" class="label-title">Batas Akhir Jam Pengantaran</label>
				<input type="time" name="same_day_window_max" value="{{ request.RawSameDayWindowMax }}" id="same_day_window_max"
					class="form-control time-picker" step="1" required{{ if !request.SameDay }} disabled{{ end }} />
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-4">
			<div class="form-group">
				<label for="next_day" class="label-title">Next Day</label>
				<input type="checkbox" name="next_day" value="1" id="next_day"{{ if request.NextDay}} checked{{ end }} />
			</div>
		</div>
		<div class="col-4">
			<div class="form-group">
				<label for="next_day_window_min" class="label-title">Batas Awal Jam Pengantaran</label>
				<input type="time" name="next_day_window_min" value="{{ request.RawNextDayWindowMin }}" id="next_day_window_min"
					class="form-control time-picker" step="1" required{{ if !request.NextDay }} disabled{{ end }} />
			</div>
		</div>
		<div class="col-4">
			<div class="form-group">
				<label for="next_day_window_max" class="label-title">Batas Akhir Jam Pengantaran</label>
				<input type="time" name="next_day_window_max" value="{{ request.RawNextDayWindowMax }}" id="next_day_window_max"
					class="form-control time-picker" step="1" required{{ if !request.NextDay }} disabled{{ end }} />
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-4">
			<div class="form-group">
				<label for="next_two_day" class="label-title">Next Two Day</label>
				<input type="checkbox" name="next_two_day" value="1" id="next_two_day"{{ if request.NextTwoDay}} checked{{ end }} />
			</div>
		</div>
		<div class="col-4">
			<div class="form-group">
				<label for="next_two_day_window_min" class="label-title">Batas Awal Jam Pengantaran</label>
				<input type="time" name="next_two_day_window_min" value="{{ request.RawNextTwoDayWindowMin }}" id="next_two_day_window_min"
					class="form-control time-picker" step="1" required{{ if !request.NextTwoDay }} disabled{{ end }} />
			</div>
		</div>
		<div class="col-4">
			<div class="form-group">
				<label for="next_two_day_window_max" class="label-title">Batas Akhir Jam Pengantaran</label>
				<input type="time" name="next_two_day_window_max" value="{{ request.RawNextTwoDayWindowMax }}" id="next_two_day_window_max"
					class="form-control time-picker" step="1" required{{ if !request.NextTwoDay }} disabled{{ end }} />
			</div>
		</div>
	</div>
	<hr />
	<button type="submit" class="btn btn-success mr-1">
		Simpan{{ if !deliveryPlan.New() }} Perubahan{{ end }} Data Jadwal Delivery
	</button>
	<a href="{{ baseURL }}/seller/delivery_plans" class="btn btn-default ml-1">
		Back to List Jadwal Delivery
	</a>
</form>
<script>
	document.addEventListener("DOMContentLoaded", () => {
		flatpickr(".time-picker", {
			noCalendar: true,
			enableTime: true,
			enableSeconds: true,
			time_24hr: true,
			dateFormat: "H:i:S",
			minuteIncrement: 1,
		});
		const sameDay = document.getElementById("same_day");
		const sameDayWindowMin = document.getElementById("same_day_window_min");
		const sameDayWindowMax = document.getElementById("same_day_window_max");
		sameDay.addEventListener("change", (event) => {
			if (event.target.checked) {
				sameDayWindowMin.removeAttribute("disabled");
				sameDayWindowMax.removeAttribute("disabled");
				return;
			}
			sameDayWindowMin.value = "";
			sameDayWindowMin.setAttribute("disabled", "disabled");
			sameDayWindowMax.value = "";
			sameDayWindowMax.setAttribute("disabled", "disabled");
		});
		const nextDay = document.getElementById("next_day");
		const nextDayWindowMin = document.getElementById("next_day_window_min");
		const nextDayWindowMax = document.getElementById("next_day_window_max");
		nextDay.addEventListener("change", (event) => {
			if (event.target.checked) {
				nextDayWindowMin.removeAttribute("disabled");
				nextDayWindowMax.removeAttribute("disabled");
				return;
			}
			nextDayWindowMin.value = "";
			nextDayWindowMin.setAttribute("disabled", "disabled");
			nextDayWindowMax.value = "";
			nextDayWindowMax.setAttribute("disabled", "disabled");
		});
		const nextTwoDay = document.getElementById("next_two_day");
		const nextTwoDayWindowMin = document.getElementById("next_two_day_window_min");
		const nextTwoDayWindowMax = document.getElementById("next_two_day_window_max");
		nextTwoDay.addEventListener("change", (event) => {
			if (event.target.checked) {
				nextTwoDayWindowMin.removeAttribute("disabled");
				nextTwoDayWindowMax.removeAttribute("disabled");
				return;
			}
			nextTwoDayWindowMin.value = "";
			nextTwoDayWindowMin.setAttribute("disabled", "disabled");
			nextTwoDayWindowMax.value = "";
			nextTwoDayWindowMax.setAttribute("disabled", "disabled");
		});
	});
</script>
