{{ range type, message := flash.Data }}
<div class="alert alert-{{ type }}">
	<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
</div>
{{ end }}
<form method="POST" action="{{ baseURL }}/seller/product_categories{{ if !productCategory.New() }}/{{ productCategory.ID }}{{ end }}" enctype="multipart/form-data">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !productCategory.New() }}
	<input type="hidden" name="id" value="{{ productCategory.ID }}" />
	{{ end }}
	<div class="row">
		<div class="col-lg-4">
			<label for="photo">
				<img src="{{ if request.Photo }}{{ request.PhotoPath(baseURL) }}{{ else }}{{ baseURL }}/assets/img/upload-icon.png{{ end }}"
					class="w-100 cp"
					data-toggle="tooltip"
					data-placement="left"
					title="Klik Gambar untuk Memilih Gambar"
					alt="Foto Kategori Produk"
					id="photo_preview" />
				<input type="file" name="photo" id="photo" accept="image/*" />
			</label>
		</div>
		<div class="col-lg-8">
			<div class="form-group">
				<label for="name" class="label-title">Nama Kategori Produk</label>
				<input type="text" name="name" value="{{ if request.Name }}{{ request.Name }}{{ end }}" class="form-control" id="name"
					placeholder="Nama Kategori Produk" />
			</div>
			<div class="form-group">
				<label for="description" class="label-title">Keterangan Kategori Produk</label>
				<textarea name="description" class="form-control" id="description"
					placeholder="Keterangan Kategori Produk">{{ request.Description }}</textarea>
			</div>
			<hr class="mt-3 mb-4">
			<button type="submit" class="btn btn-success mr-1">Simpan{{ if !productCategory.New() }} Perubahan{{end}} Data Kategori Produk</button>
			<a href="{{ baseURL }}/seller/product_categories" class="btn btn-default ml-1">
				Back to List Kategori Produk
			</a>
		</div>
	</div>
</form>
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("photo").addEventListener("change", (event) => {
			let file = event.target.files[0];
			if (!file || !file.type.startsWith("image/")) {
				return;
			}
			let preview = document.getElementById("photo_preview");
			preview.setAttribute("src", URL.createObjectURL(file));
			preview.classList.add("img-thumbnail");
		});
	});
</script>
