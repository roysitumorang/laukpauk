{{ range type, message := flash.Data }}
<div class="alert alert-{{ type }}">
	<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
</div>
{{ end }}
<form method="POST" action="{{ baseURL }}/seller/recipes/{{ recipe.ID }}/items{{ if !recipeItem.New() }}/{{ recipeItem.ID }}{{ end }}">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !recipeItem.New() }}
	<input type="hidden" name="id" value="{{ recipeItem.ID }}" />
	<input type="hidden" name="product_variant_id" value="{{ recipeItem.ProductVariantID }}" />
	{{ end }}
	<div class="row">
		<div class="form-group col-lg-4">
			<label for="product_variant_id" class="label-title">Produk</label>
			<select name="product_variant_id" id="product_variant_id" class="form-control" {{ if !recipeItem.New() }}disabled{{ else }}required{{ end }}>
				<option value="" disabled>- Pilih Produk -</option>
				{{ range _, product := products }}
				{{ range _, variant := product.Variants }}
				<option value="{{ variant.ID }}"{{ if request.ProductVariantID.Compare(variant.ID) == 0 }} selected{{ end }}>{{ variant.ProductName }} - {{ variant.StockUnit }}</option>
				{{ end }}
				{{ end }}
			</select>
		</div>
		<div class="form-group col-lg-4">
			<label for="dose" class="label-title">Takaran</label>
			<input type="number"
				name="quantity"
				value="{{ request.Quantity }}"
				id="quantity"
				placeholder="Takaran Satuan (mis. 10)"
				class="form-control"
				min="1" />
		</div>
		<div class="form-group col-lg-12">
			<label for="note" class="label-title">Catatan Tambahan</label>
			<textarea name="note"
				id="note"
				placeholder="Catatan Tambahan (Optional)"
				class="form-control">{{ request.Note }}</textarea>
		</div>
	</div>
	<button type="submit" class="btn btn-success">Simpan{{ if !recipeItem.New() }} Perubahan{{ end }} Resep Item</button>
	<a href="{{ baseURL }}/seller/recipes/{{ recipe.ID }}" class="btn btn-default ml-1">
		Back to Detail Resep
	</a>
</form>
