<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">SMS</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							SMS Baru
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>SMS Baru</h5>
						</div>
						<div class="col-lg-8 text-right"></div>
					</div>
				</div>
				<div class="card-body">
					{{ range type, message := flash.Data }}
					<div class="alert alert-{{ type }}">
						<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
					</div>
					{{ end }}
					<form method="POST" action="{{ baseURL }}/admin/text_messages">
						<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
						<div class="row">
							<div class="col-lg-12">
								<div class="form-group">
									<label for="user_id" class="label-title">Penerima Pesan</label>
									<select name="user_id" id="user_id" class="form-control" required>
										<option value="" disabled>- Pilih Penerima -</option>
										{{ range _, buyer := buyers }}
										{{ if buyer.MobilePhone }}
										<option value="{{ buyer.ID }}"{{ if request.UserID.Compare(buyer.ID) == 0 }} selected{{ end }}>{{ buyer.Name }} / {{ buyer.MobilePhone }}</option>
										{{ end }}
										{{ end }}
									</select>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col-lg-12">
								<div class="form-group">
									<label for="body" class="label-title">Isi Pesan (Max. 580 Karakter)</label>
									<textarea name="body"
										class="form-control"
										id="body"
										placeholder="Isi Pesan"
										maxlength="580">{{ request.Body }}</textarea>
								</div>
							</div>
						</div>
						<hr />
						<button type="submit" class="btn btn-success mr-1">
							Kirim Pesan
						</button>
						<a href="{{ baseURL }}/admin/text_messages" class="btn btn-default ml-1">
							Back to Riwayat Pesan
						</a>
					</form>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
