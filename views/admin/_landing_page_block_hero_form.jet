<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
<div class="row">
	<div class="col-lg-4">
		<label for="heroImage">
			<img src="{{baseURL}}/{{ if request.Photo }}{{ request.PhotoPath() }}{{ else }}assets/img/upload-icon.png{{ end }}"
				alt="Gambar Hero Slider"
				class="w-100 cp"
				data-toggle="tooltip"
				data-placement="left"
				title="Klik Gambar untuk Memilih Gambar"
				id="imgPreview" />
			<input type="file" name="photo" id="heroImage" onChange="imgChanged(this)" />
		</label>
		<div class="alert alert-warning alert-sm">
			<h6>Note</h6>
			<p class="text-sm mb-0">Ukuran yang disarankan : 1100px x 1056px</p>
		</div>
	</div>
	<div class="col-lg-8">
		<div class="form-group">
			<label for="heading" class="label-title">Subject</label>
			<input type="text"
				name="subject"
				value="{{ request.Subject }}"
				id="subject"
				class="form-control input"
				placeholder="Sekarang Anda bisa ke pasar dekat rumah, sambil pilih-pilih kebutuhan dapur" />
		</div>
		<div class="form-group">
			<label for="content" class="label-title">Body</label>
			<textarea name="body"
				id="body"
				class="form-control input"
				placeholder="Hidup lebih santai, dan pekerjaan rumah lainnya bisa dikerjakan tanpa habisin waktu ke pasar">{{ request.Body }}</textarea>
		</div>
		<div class="row">
			<div class="col-lg-6 form-group">
				<label for="buttonText" class="label-title">Link Text</label>
				<input type="text"
					name="link_text"
					value="{{ request.LinkText }}"
					id="link_text"
					class="form-control input"
					placeholder="Gabung Sekarang" />
			</div>
			<div class="col-lg-6 form-group">
				<label for="buttonLink" class="label-title">Link URL</label>
				<input type="text"
					name="link_url"
					value="{{ request.LinkURL }}"
					id="link_url"
					class="form-control input"
					placeholder="https://google.com" />
			</div>
		</div>
		<hr class="mb-4" />
		<button type="submit" class="btn btn-success mr-1">Simpan Data Hero</button>
		<a href="{{ baseURL }}/admin/landing_page/blocks/hero" class="btn btn-default ml-1">
			Back to List Hero
		</a>
	</div>
</div>
