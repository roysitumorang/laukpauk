<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
{{ if request.ID }}<input type="hidden" name="id" value="{{ request.ID }}" />{{ end }}
<div class="row">
	<div class="col-lg-12">
		<div class="row">
			<div class="col-lg-4">
				<div class="form-group">
					<label for="point_type" class="label-user">Tipe PoinBuyer</label>
					<select name="point_type" id="point_type" class="form-control" required{{ if request.ID }} disabled{{ end }}>
						<option disabled>Pilih</option>
						{{ range _, pointType := pointTypes }}
						<option value="{{ pointType.Int() }}"{{ if request.PointType.Equal(pointType) }} selected{{ end }}>{{ pointType.String() }}</option>
						{{ end }}
					</select>
					{{ if request.ID }}<input type="hidden" name="point_type" value="{{ request.PointType }}" />{{ end }}
				</div>
			</div>
			<div class="col-lg-4">
				<div class="form-group">
					<label for="buyer_id" class="label-user">Buyer</label>
					<select name="buyer_id" id="buyer_id" class="form-control" required{{ if request.ID }} disabled{{ end }}>
						<option disabled>Pilih User</option>
						{{ range _, buyer := buyers }}
						<option value="{{ buyer.ID }}"{{ if request.BuyerID.Compare(buyer.ID) == 0 }} selected{{ end }}>{{ buyer.Name }} ({{ buyer.Username }})</option>
						{{ end }}
					</select>
					{{ if request.ID }}<input type="hidden" name="buyer_id" value="{{ request.BuyerID }}" />{{ end }}
				</div>
			</div>
			<div class="col-lg-4">
				<div class="form-group">
					<label for="amount" class="label-nilai">Nilai</label>
					<div class="input-group">
						<div class="input-group-prepend">
							<span class="input-group-text">Rp.</span>
						</div>
						<input type="number" name="amount" value="{{ request.Amount }}" class="form-control input" id="amount"
							placeholder="Nominal Poin" required />
					</div>
				</div>
			</div>
		</div>
		<div class="form-group">
			<label for="description" class="label-title">Keterangan</label>
			<input type="text" name="description" value="{{ request.Description }}" class="form-control input"
				placeholder="Keterangan"
				id="description"
				required{{ if request.ID }} readonly{{ end }} />
			{{ if request.ID }}<input type="hidden" name="description" value="{{ request.Description }}" />{{ end }}
		</div>
		<hr class="mb-4" />
		<button type="submit" class="btn btn-success mr-1" id="btnSubmit">
			Simpan  Data Poin
		</button>
		<a href="{{ baseURL }}/admin/points" class="btn btn-link btn-sm">
			List Poin User
		</a>
	</div>
</div>
