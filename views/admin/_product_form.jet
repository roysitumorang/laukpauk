<form method="POST" action="{{ baseURL }}/admin/products{{ if !product.New() }}/{{ product.ID }}{{ end }}" enctype="multipart/form-data">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !product.New() }}
	<input type="hidden" name="id" value="{{ product.ID }}" />
	{{ end }}
	<div class="row">
		<div class="col-lg-4">
			<label for="photo">
				<img src="{{ baseURL }}{{ if request.Photo }}{{ request.PhotoPath() }}{{ else }}/assets/img/upload-icon.png{{ end }}"
					alt="Foto Produk"
					data-toggle="tooltip"
					class="w-100 cp"
					data-placement="left"
					title="Klik Gambar untuk Memilih/Mengganti Gambar Produk"
					id="photo_preview"
					onerror="this.src='{{ baseURL }}/assets/img/no-image.png'" />
				<input type="file" name="photo" id="photo" accept="image/*" />
			</label>
		</div>
		<div class="col-lg-8">
			<div class="form-group">
				<label for="name" class="label-title">Nama Produk</label>
				<input type="text" name="name" value="{{ request.Name }}" class="form-control input" id="name"
					placeholder="Nama Produk" />
			</div>
			<div class="form-group">
				<label for="product_category_id" class="label-title">Kategori Produk</label>
				<select name="product_category_id" class="form-control input" id="product_category_id">
					{{ range _, productCategory := productCategories }}
					<option value="{{ productCategory.ID }}"{{ if request.ProductCategoryID.Compare(productCategory.ID) == 0 }} selected{{ end }}>{{ productCategory.Name }}</option>
					{{ end }}
				</select>
			</div>
			<div class="form-group">
				<label for="product_type" class="label-title">Tipe Produk</label>
				<select name="product_type" class="form-control input" id="product_type">
					{{ range _, productType := productTypes }}
					<option value="{{ productType.Int() }}"{{ if request.ProductType == productType.Int() }} selected{{ end }}>{{ productType }}</option>
					{{ end }}
				</select>
			</div>
			<div class="form-group">
				<label for="stock_status" class="label-title">Stok</label>
				<select name="stock_status" class="form-control input" id="stock_status">
					{{ range _, stockStatus := stockStatuses }}
					<option value="{{ stockStatus.Int() }}"{{ if request.StockStatus == stockStatus.Int() }} selected{{ end }}>{{ stockStatus }}</option>
					{{ end }}
				</select>
			</div>
			<div class="form-group">
				<label for="description" class="label-title">Keterangan Produk (Opsional)</label>
				<textarea name="description" class="form-control input" id="description"
					placeholder="Keterangan Produk">{{ request.Description }}</textarea>
			</div>
			<div class="form-group">
				<input type="checkbox" name="pinned" id="pinned" class="mr-2"{{ if request.Pinned }} checked{{ end }} />
				<label for="pinned" class="label-title cp">Superior</label>
			</div>
			<hr class="mb-4" />
			<button type="submit" class="btn btn-success mr-1">
				Simpan{{ if !product.New() }} Perubahan{{end}} Data Produk
			</button>
			<a href="{{ baseURL }}/admin/products">
				<button type="button" class="btn btn-default ml-1">Back to List Produk</button>
			</a>
		</div>
	</div>
</form>
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("photo").addEventListener("change", (event) => {
			let file = event.target.files[0];
			if (!file || !file.type.startsWith("image/")) {
				return;
			}
			let preview = document.getElementById("photo_preview");
			preview.setAttribute("src", URL.createObjectURL(file));
			preview.classList.add("img-thumbnail");
		});
	});
</script>
