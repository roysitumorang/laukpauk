<form method="POST" action="{{ baseURL }}/admin/point_spending_caps{{ if !pointSpendingCap.New() }}/{{ pointSpendingCap.ID }}{{ end }}" id="formPoin">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !pointSpendingCap.New() }}<input type="hidden" name="id" value="{{ pointSpendingCap.ID }}" />{{ end }}
	<div class="row">
		<div class="col-lg-12">
			<div class="row">
				<div class="col-lg-6">
					<div class="form-group">
						<label for="minimum_shopping_cost" class="label-nilai">Minimal Belanja</label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text">Rp.</span>
							</div>
							<input type="number" name="minimum_shopping_cost" value="{{ request.MinimumShoppingCost }}" class="form-control input" id="minimum_shopping_cost"
								placeholder="Minimal Belanja" required />
						</div>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="form-group">
						<label for="maximum_shopping_cost" class="label-nilai">Maksimal Belanja</label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text">Rp.</span>
							</div>
							<input type="number" name="maximum_shopping_cost" value="{{ request.MaximumShoppingCost }}" class="form-control input" id="maximum_shopping_cost"
								placeholder="Maksimal Belanja" required />
						</div>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="form-group">
						<label for="disposable_points" class="label-nilai">Poin</label>
						<div class="input-group">
							<div class="input-group-prepend">
								<span class="input-group-text">Rp.</span>
							</div>
							<input type="number" name="disposable_points" value="{{ request.DisposablePoints }}" class="form-control input" id="disposable_points"
								placeholder="Poin" required />
						</div>
					</div>
				</div>
			</div>
			<hr class="mb-4" />
			<button type="submit" class="btn btn-success mr-1" id="btnSubmit">
				Simpan{{ if !pointSpendingCap.New() }} Perubahan{{ end }} Data Tarif Penggunaan Poin
			</button>
			<a href="{{ baseURL }}/admin/point_spending_caps" class="btn btn-link btn-sm">
				List Tarif Penggunaan Poin
			</a>
		</div>
	</div>
</form>
