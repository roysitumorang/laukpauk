{{ range type, message := flash.Data }}
<div class="alert alert-{{ type }}">
	<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
</div>
{{ end }}
<form method="POST" action="{{ baseURL }}/admin/setting">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	<div class="row">
		<div class="col-lg-12">
			<div class="form-group">
				<input type="checkbox" name="maintenance_mode" id="maintenance_mode" class="mr-2"{{ if request.MaintenanceMode }} checked{{ end }} />
				<label for="maintenance_mode" class="label-title cp">Maintenance Mode</label>
			</div>
			<div class="form-group">
				<label for="subscription_trial_period" class="label-title">Trial Period (in days)</label>
				<input type="number"
					name="subscription_trial_period"
					value="{{ request.SubscriptionTrialPeriod }}"
					id="subscription_trial_period"
					class="form-control"
					placeholder="Trial Period"
					min="0" />
			</div>
			<div class="form-group">
				<label for="monthly_billing_amount" class="label-title">Monthly Billing Amount (IDR)</label>
				<input type="number"
					name="monthly_billing_amount"
					value="{{ request.MonthlyBillingAmount }}"
					id="monthly_billing_amount"
					class="form-control"
					placeholder="Monthly Billing Amount"
					min="0" />
			</div>
			<div class="form-group">
				<label for="annual_billing_amount" class="label-title">Annual Billing Amount (IDR)</label>
				<input type="number"
					name="annual_billing_amount"
					value="{{ request.AnnualBillingAmount }}"
					id="annual_billing_amount"
					class="form-control"
					placeholder="Annual Billing Amount"
					min="0" />
			</div>
			<div class="form-group">
				<label for="billing_grace_period" class="label-title">Billing Grace Period (in days)</label>
				<input type="number"
					name="billing_grace_period"
					value="{{ request.BillingGracePeriod }}"
					id="billing_grace_period"
					class="form-control"
					placeholder="Billing Grace Period"
					min="0" />
			</div>
			<hr />
			<button type="submit" class="btn btn-success mr-1">
				Simpan Perubahan Data Setting
			</button>
		</div>
	</div>
</form>
