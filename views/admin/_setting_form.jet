<form method="POST" action="{{ baseURL }}/admin/settings{{ if !setting.New() }}/{{ setting.ID }}{{ end }}">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !setting.New() }}<input type="hidden" name="id" value="{{ setting.ID }}" />{{ end }}
	<div class="row">
		<div class="col-lg-12">
			<div class="form-group">
				<label for="name" class="label-title">Kunci Pengaturan</label>
				<input type="text"
					name="name"
					value="{{ request.Name }}"
					id="name"
					class="form-control"
					placeholder="Kunci Pengaturan"{{ if !setting.New() && !setting.NameEditable() }} disabled="disabled"{{ end }} />
				{{ if !setting.New() && !setting.NameEditable() }}<input type="hidden" name="name" value="{{ setting.Name }}" />{{ end }}
				<p class="text-danger text-sm mb-0 mt-2">Jangan menggunakan spasi untuk kunci pengaturan. Spasi akan dihilangkan jika anda tetap memasukkan spasi !</p>
			</div>
			<div class="form-group">
				<label for="value" class="label-title">Nilai Pengaturan</label>
				<input type="text" name="value" value="{{ request.Value }}" id="value"
					class="form-control" placeholder="Nilai Pengaturan" />
			</div>
			<div class="form-group">
				<label for="description" class="label-title">Deskripsi Pengaturan</label>
				<textarea class="form-control" name="description" id="description"
					placeholder="Keterangan Pengaturan">{{ request.Description }}</textarea>
			</div>
			<hr />
			<button type="submit" class="btn btn-success mr-1">
				Simpan{{ if !setting.New() }} Perubuahan{{ end }} Data Pengaturan
			</button>
			<a href="{{ baseURL }}/admin/settings" class="btn btn-default ml-1">
				Back to List Pengaturan
			</a>
		</div>
	</div>
</form>
