<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
<div class="row">
	<div class="col-lg-12">
		<div class="form-group">
			<label for="key" class="label-title">Kunci Pengaturan</label>
			<input type="text" name="key" value="{{ request.Key }}" id="key"
				class="form-control" placeholder="Kunci Pengaturan" />
			<p class="text-danger text-sm mb-0 mt-2">Jangan menggunakan spasi untuk kunci pengaturan. Spasi akan dihilangkan jika anda tetap memasukkan spasi !</p>
		</div>
		<div class="form-group">
			<label for="value" class="label-title">Nilai Pengaturan</label>
			<input type="text" name="value" value="{{ request.Value }}" id="value"
				class="form-control" placeholder="Nilai Pengaturan" />
		</div>
		<div class="form-group">
			<label for="description" class="label-title">Deskripsi Pengaturan</label>
			<textarea class="form-control" name="description" id="description"
				placeholder="Keterangan Pengaturan">{{ request.Description }}</textarea>
		</div>
		<hr />
		<button type="submit" class="btn btn-success mr-1">
			Simpan Data Pengaturan
		</button>
		<a href="{{ baseURL }}/admin/settings">
			<button class="btn btn-default ml-1" type="button">Back to List Pengaturan</button>
		</a>
	</div>
</div>

