<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Histori Belanja</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Histori Belanja
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5 class="mb-1">Histori Belanja</h5>
						</div>
						<div class="col-lg-8 text-right"></div>
					</div>
				</div>
				<div class="card-body">
					<div class="col-lg-12 table-responsive">
						{{ range type, message := flash.Data }}
						<div class="alert alert-{{ type }}">
							<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
						</div>
						{{ end }}
						<form method="GET" action="/admin/transactions" id="search">
							<div class="row">
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Show
											<select name="limit" id="limit" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, limit := limits }}
												<option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
												{{ end }}
											</select> entries
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div id="listBlog_filter" class="dataTables_filter">
										<label for="q">
											Search: <input type="text" name="q" id="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Sort by
											<select name="sort_by" multiple id="sort_by" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, sorting := sortings }}
												<option value="{{ sorting.String() }}"{{ if request.MapSortings.Contains(sorting.String()) }} selected{{ end }}>{{ sorting.Label }}</option>
												{{ end }}
											</select>
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
										<button type="reset" class="btn btn-default" id="reset"><i class="fa fa-sync"></i> Reset</button>
									</div>
								</div>
							</div>
						</form>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
						<table class="table-sm table" id="historiBelanja">
							<thead>
								<tr>
									<th class="border-top-0 text-center">No.</th>
									<th class="border-top-0 text-left">No. Transaksi</th>
									<th class="border-top-0 text-left">Penerima</th>
									<th class="border-top-0 text-left">Catatan</th>
									<th class="border-top-0 text-left">Status</th>
									<th class="border-top-0 text-right">Bayar</th>
									<th class="border-top-0 text-right">Total Belanja</th>
									<th class="border-top-0 text-center">Opsi</th>
								</tr>
							</thead>
							<tbody>
								{{ range _, row := rows }}
								<tr class="text-sm tr-parent">
									<td class="vam text-center"><b>{{ row.RowNo }}.</b></td>
									<td class="vam text-left">
										<h6 class="mb-0 text-primary text-bold">{{ row.ReferenceNumber }}</h6>
									</td>
									<td class="vam text-left">
										<h6 class="mb-1 text-info text-bold">{{ row.RecipientName }}</h6>
										<span class="text-sm text-muted">No. Telp {{ row.RecipientMobilePhone }}</span>
									</td>
									<td class="vam text-left">{{ if row.BuyerNote }}{{ row.BuyerNote }}{{ else }}-{{ end }}</td>
									<td class="vam text-left">
										<span class="badge badge-primary">{{ row.TransactionStatus.String() }}</span>
									</td>
									<td class="vam text-right">
										<b class="text-success">Rp. {{ if row.RevisedPaymentAmount }}{{ row.RevisedPaymentAmount | Comma }}{{ else }}0{{ end }}</b>
									</td>
									<td class="vam text-right">
										<b class="text-success">Rp. {{ row.ShoppingCost | Comma }}</b>
									</td>
									<td class="vam text-center">
										<a href="{{ baseURL }}/admin/transactions/{{ row.ID }}">
											<span class="fa fa-list text-primary cp" data-toggle="tooltip"
												data-placement="top" title="Detail Transaksi"></span>
										</a>
										<a href="{{ baseURL }}/admin/transactions/{{ row.ID }}/invoice" target="_blank">
											<span class="fa fa-file text-info cp ml-3" data-toggle="tooltip"
												data-placement="top" title="Print Invoice"></span>
										</a>
									</td>
								</tr>
								{{ end }}
							</tbody>
						</table>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("reset").addEventListener("click", (event) => {
			event.preventDefault();
			let form = event.target.form;
			form.querySelectorAll("input[type=text]").forEach((select) => select.value = "");
			form.querySelectorAll("select").forEach((select) => select.selectedIndex = 0);
		});
	});
</script>
