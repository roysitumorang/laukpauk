<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Produk</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Detail Produk
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-lg-6">
					<div class="card">
						<div class="card-header">
							<div class="row">
								<div class="col-lg-4">
									<h5>Detail Produk</h5>
									{{ product.Name }}
								</div>
								<div class="col-lg-8 text-right"></div>
							</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-lg-4 text-center">
									<img src="{{ baseURL }}{{ product.PhotoPath() }}"
										alt="{{ product.Name }}" class="img-circle"
										style="width:170px; height:170px;"
										onerror="this.src='{{ baseURL }}/assets/img/no-image.png'" />
								</div>
								<div class="col-lg-8">
									<h2 class="text-primary text-bold mb-3">
										{{ product.Name }}
									</h2>
									<div class="table-responsive">
										<table class="table table-sm">
											<tr class="text-sm">
												<td class="border-top-0 text-left">Kategori Produk</td>
												<td class="border-top-0 text-left">{{ product.ProductCategoryName }}</td>
											</tr>
											<tr class="text-sm">
												<td class="border-top-0 text-left">Stok</td>
												<td class="border-top-0 text-left">
													<span class="badge badge-{{ if product.ReadyStock }}success{{ else }}secondary{{ end }}">
														{{ product.StockStatus() }}
													</span>
												</td>
											</tr>
											<tr class="text-sm">
												<td class="border-top-0 text-left">Keterangan</td>
												<td class="border-top-0 text-left">{{ product.Description }}</td>
											</tr>
											<tr class="text-sm">
												<td class="border-top-0 text-left">Dibuat</td>
												<td class="border-top-0 text-left">
													{{ product.CreatedAt.Format("Mon, 2 Jan 2006 15:04:05") }}
												</td>
											</tr>
											<tr class="text-sm">
												<td class="border-top-0 text-left">Terakhir Diperbaharui</td>
												<td class="border-top-0 text-left">
													{{ product.UpdatedAt.Format("Mon, 2 Jan 2006 15:04:05") }}
												</td>
											</tr>
										</table>
										<hr />
										<a href="{{ baseURL }}/admin/products/{{ product.ID }}/edit">
											<button class="btn btn-default">
												Edit Data Product
											</button>
										</a>
										<a href="{{ baseURL }}/admin/products">
											<button class="btn btn-default">
												Back to List Product
											</button>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="card">
						<div class="card-header">
							<div class="row">
								<div class="col-lg-10">
									<h5>Edit Varian Produk</h5>
									{{ product.Name }}
								</div>
								<div class="col-lg-2 text-right cp">
									<span class="fa fa-info-circle text-info animate__animated animate__fadeIn animate__infinite" data-toggle="tooltip"
										data-placement="top" title="Jika persentase harga variasi belum ditentukan, maka satuan (harga) yang bersangkutan tidak akan berpengaruh ketika menggunakan fitur Variasi Harga Massal"></span>
								</div>
							</div>
						</div>
						<div class="card-body">
							{{ range type, message := flash.Data }}
							<div class="alert alert-{{ type }}">
								<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
							</div>
							{{ end }}
							{{ include "_product_variant_form" }}
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
