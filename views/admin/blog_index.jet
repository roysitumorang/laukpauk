<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-4">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Blog</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							List Data Blog
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
		</div>
	</div>
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-lg-4">
                            <h5>Data Blog</h5>
                        </div>
                        <div class="col-lg-8 text-right">
                            <a href="{{ baseURL }}/admin/blogs/new"
                                data-toggle="tooltip"
                                data-placement="top"
                                title="Tambah Blog Baru">
                                Add New Blog
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="col-lg-12 table-responsive">
                        <form method="GET" action="/admin/blogs">
                            <div class="row">
                                <div class="col-sm-12 col-md-6">
                                    <div class="dataTables_length" id="listBlog_length">
                                        <label>
                                            Show
                                            <select name="limit" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
                                                {{ range _, limit := limits }}
                                                <option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
                                                {{ end }}
                                            </select> entries
                                        </label>
                                    </div>
                                </div>
                                <div class="col-sm-12 col-md-6">
                                    <div id="listBlog_filter" class="dataTables_filter">
                                        <label>
                                            Search: <input type="text" name="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </form>
                        {{ if pagination.Info.Total > pagination.Info.Limit }}
                        <ul class="pagination">
                            {{ if pagination.Links.First }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
                            {{ end }}
                            {{ if pagination.Links.Previous }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
                            {{ end }}
                            {{ if pagination.Links.Current }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
                            {{ end }}
                            {{ if pagination.Links.Next }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
                            {{ end }}
                            {{ if pagination.Links.Last }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
                            {{ end }}
                            <li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
                        </ul>
                        {{ end }}
                        <table class="table-sm table table-striped" id="listBlog">
                            <thead>
                                <tr>
                                    <th class="border-top-0 text-center">No.</th>
                                    <th class="border-top-0 text-left">Blog</th>
                                    <th class="border-top-0 text-left">Created At</th>
                                    <th class="border-top-0 text-center">Opsi</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{ range _, row := rows }}
                                <tr class="text-sm tr-parent">
                                    <td class="text-center"><b>{{ row.RowNo }}.</b></td>
                                    <td class="text-left">
                                        <div class="row">
                                            <div class="col-lg-3 text-center">
                                                <a href="{{ baseURL }}/images/blog/{{ row.Photo }}" target="_blank">
                                                    <img src="{{ baseURL }}/images/blog/compress/{{ row.Photo }}"
                                                        class="img-circle cp"
                                                        style="width:50px; height:50px;"
                                                        onError="this.src='{{ baseURL }}/assets/img/no-image.png'" />
                                                </a>
                                            </div>
                                            <div class="col-lg-9">
                                                <h6 class="text-info mb-1">
                                                    <b>{{ row.Subject }}</b>
                                                </h6>
                                                <p class="text-sm text-muted mb-0">
                                                    <a target="_blank" href="{{ baseURL }}/read/{{ row.Slug }}">{{ baseURL }}/read/{{ row.Slug }}</a>
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-left">
                                        {{ row.CreatedAt }}
                                        {{ if row.CreatedAt != row.UpdatedAt }}
                                        <br />
                                        Updated At: {{ row.UpdatedAt }}
                                        {{ end }}
                                    </td>
                                    <td class="vam text-center">
                                        <a href="{{ baseURL }}/admin/blogs/{{ row.ID }}/edit">
                                            <span class="fa fa-edit text-warning cp mr-2"
                                            data-toggle="tooltip"
                                            data-placement="top"
                                            title="Edit Data Blog">
                                            </span>
                                        </a>
                                        <form method="POST" action="{{ baseURL }}/admin/blogs/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
                                            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                                            <span class="fa fa-trash text-danger cp ml-2"
                                                data-toggle="tooltip"
                                                data-placement="top"
                                                title="Hapus Data Blog"
                                                onclick="confirm('Are you sure to delete this blog ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
                                            </span>
                                        </form>
                                    </td>
                                </tr>
                                {{ end }}
                            </tbody>
                        </table>
                        {{ if pagination.Info.Total > pagination.Info.Limit }}
                        <ul class="pagination">
                            {{ if pagination.Links.First }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
                            {{ end }}
                            {{ if pagination.Links.Previous }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
                            {{ end }}
                            {{ if pagination.Links.Current }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
                            {{ end }}
                            {{ if pagination.Links.Next }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
                            {{ end }}
                            {{ if pagination.Links.Last }}
                            <li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
                            {{ end }}
                            <li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
                        </ul>
                        {{ end }}
                    </div>
                </div>
            </div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
    let baseURL = '{{ baseURL }}/admin/';
    let siteURL = '{{ baseURL }}/';
    let uploadGambarBlog = 'images/blog';
    let uploadGambarAdmin = 'images/admin';
    let _tabelBlogOptions = {
    	processing: true,
    	serverSide: true,
    	ajax: {
    		url: `{{ baseURL }}/admin/blog/getBlog${location.search}`,
    		dataSrc: 'listBlog'
    	},
    	columns: [{
    		data: null,
    		render: function(data, type, row, meta) {
    			return `<p class='mb-0 text-center'><b>${meta.row + 1}.</b></p>`;
    		}
    	}, {
    		data: null,
    		render: function(data, type, row, meta) {
    			let content = data.content;
    			if (content.length >= 100) {
    				content = `${content.substr(0, 100)} ..`;
    			}
    			return `<div class='row'>
                            <div class='col-lg-1'>
                                <a href='${baseURL}/${uploadGambarBlog}/${data.foto}' target='_blank'>
                                    <img src='${baseURL}/${uploadGambarBlog}/${data.foto}' alt='${data.title}' class='img-circle size-50-50' />
                                </a>
                            </div>
                            <div class='col-lg-11 pl-3'>
                                <h6 class='mb-1 text-bold text-primary'>${data.title}</h6>
                                <p class='mb-0 text-sm text-muted'>${content}</p>
                                <a href='${siteURL}read/${data.permalink}' target='_blank'>
                                    <span style='font-size:0.9rem;'>${siteURL}read/${data.permalink}</span>
                                </a>
                            </div>
                        </div>`;
    		}
    	}, {
    		data: null,
    		render: function(data, type, row, meta) {
    			let _updater = '';
    			if (data.updatedBy != null) {
    				_updater = `<div class='mt-1 mb-0 text-sm row'>
                                        <div class='col-lg-1'>
                                            <a href='${baseURL}/${uploadGambarAdmin}/${data.updaterFoto}' target='_blank'>
                                                <img src='${baseURL}${uploadGambarAdmin}/${data.updaterFoto}' class='img-circle size-25-25'
                                                alt='${data.updaterNama}' />
                                            </a>
                                        </div>
                                        <div class='col-lg-11 pl-3'>
                                            <b class='text-muted text-sm'>Diupdate oleh ${data.updaterNama}</b>
                                            <p class='text-sm mb-0 text-muted'>Pada ${data.updatedAt}</p>
                                        </div>
                                    </div>`;
    			}
    			return `<div class='row'>
                            <div class='col-lg-2 text-center'>
                                <a href='${baseURL}/${uploadGambarAdmin}/${data.creatorFoto}' target='_blank'>
                                    <img src='${baseURL}/${uploadGambarAdmin}/${data.creatorFoto}' alt='${data.creatorNama}' class='img-circle size-50-50' />
                                </a>
                            </div>
                            <div class='col-lg-10 pl-3'>
                                <b class='mb-1 text-bold text-secondary'>${data.creatorNama}</b>
                                <p class='mb-0 text-sm text-muted'>${data.createdAt}</p>
                                ${_updater}
                            </div>
                        </div>`;
    		}
    	}, {
    		data: null,
    		render: function(data, type, row, meta) {
    			return `<div class='text-center'>
                            <a href='${baseURL}blog/editBlog/${data.id}'>
                                <span class="fa fa-edit text-warning cp"
                                    data-toggle='tooltip' data-placement='top' title='Edit'></span>
                            </a>
                            <span class="fa fa-trash text-danger ml-2 cp" onClick='hapusBlog(this)'
                                data-detail-blog='${JSON.stringify(data)}'
                                data-toggle='tooltip' data-placement='top' title='Hapus'></span>
                        </div>`;
    		}
    	}]
    };
    let _tabelBlog = $('#tabelBlog').DataTable(_tabelBlogOptions);

    function hapusBlog(thisContext) {
    	let _el = $(thisContext);
    	let _detailBlog = JSON.parse(_el.attr('data-detail-blog'));
    	Swal.fire({
    		title: 'Blog',
    		html: `Apakah anda yakin akan menghapus blog ini ?`,
    		type: 'question',
    		showCancelButton: true,
    		cancelButtonText: 'Batal',
    		showConfirmButton: true,
    		confirmButtonText: 'Ya, lanjutkan!',
    		focusCancel: true
    	}).then((konfirmasi) => {
    		if (konfirmasi.value) {
    			$.ajax({
    				url: `http://localhost:81/admin/blog/deleteBlog/${_detailBlog.id}`,
    				success: function(_decodedRFS) {
    					let _statusDelete = _decodedRFS.statusDelete;
    					let _html, _type;
    					if (_statusDelete) {
    						_html = 'Berhasil menghapus blog!';
    						_type = 'success';
    					} else {
    						_html = 'Gagal menghapus blog, silahkan coba lagi!';
    						_type = 'error';
    					}
    					Swal.fire({
    						title: 'Blog',
    						html: _html,
    						type: _type
    					}).then(() => {
    						if (_statusDelete) {
    							_tabelBlog.draw();
    						}
    					});
    				}
    			});
    		}
    	});
    }
</script>
