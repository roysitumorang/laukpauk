<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Tambah Jadwal Tutup</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Jadwal Tutup</a>
						</li>
						<li class="breadcrumb-item active">
							Jadwal Tutup Baru
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<div class="row">
								<div class="col-lg-4">
									<h5>Jadwal Tutup Baru</h5>
								</div>
								<div class="col-lg-8 text-right">
									<a href="http://localhost:81/admin/jadwaltutup">
										<button class="btn btn-link btn-sm">Histori Jadwal Tutup</button>
									</a>
								</div>
							</div>
						</div>
						<div class="card-body">
							{{ range type, message := flash.Data }}
							<div class="alert alert-{{ type }}">
								<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
							</div>
							{{ end }}
							<form method="POST" action="{{ baseURL }}/admin/skipped_delivery_plans">
								<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
								<div class="row">
									<div class="col-lg-6">
										<div class="form-group">
											<label for="jadwal">Tanggal Tutup</label>
											<div class="input-group input-parent ">
												<input type="date"
													name="date"
													value="{{ request.Date.Format("2006-01-02") }}"
													placeholder="Jadwal Tutup"
													class="form-control input-field"
													id="date"
													required />
											</div>
										</div>
									</div>
									<div class="col-lg-6">
										<div class="form-group">
											<label for="delivery_plan_id">Jadwal Delivery</label>
											<div class="input-group input-parent ">
												<select name="delivery_plan_id" id="delivery_plan_id" class="form-control input-field">
													{{ range _, deliveryPlan := deliveryPlans }}
													<option value="{{ deliveryPlan.ID }}"{{ if request.DeliveryPlanID.Compare(deliveryPlan.ID) == 0 }} selected{{ end }}>{{ deliveryPlan.Name }}</option>
													{{ end }}
												</select>
											</div>
										</div>
									</div>
								</div>
								<hr />
								<button type="submit" id="btnSubmit" class="btn btn-success">
									Simpan Data Jadwal Tutup
								</button>
								<a href="{{ baseURL }}/admin/skipped_delivery_plans" class="btn btn-default ml-2">
									Back to Histori Jadwal Tutup
								</a>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
