<form method="POST" action="{{ baseURL }}/admin/admins{{ if !admin.New() }}/{{ admin.ID }}{{ end }}" enctype="multipart/form-data">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !admin.New() }}<input type="hidden" name="id" value="{{ admin.ID }}" />{{ end }}
	<div class="row">
		<div class="col-lg-4">
			<label for="photo">
				<img src="{{ if request.Photo }}{{ request.PhotoPath(baseURL) }}{{ else }}{{ baseURL}}/assets/img/upload-icon.png{{ end }}"
					alt="Foto Blog"
					class="w-100 cp"
					data-toggle="tooltip"
					data-placement="left"
					title="Klik Gambar untuk Memilih Gambar"
					id="photo_preview" />
				<input type="file" name="photo" id="photo" accept="image/*" />
			</label>
		</div>
		<div class="col-lg-8">
			<div class="form-group">
				<label for="admin_level" class="label-title">Tipe Admin</label>
				<select name="admin_level" id="admin_level" class="form-control" required>
					{{ range _, adminLevel := adminLevels }}
					<option value="{{ adminLevel.Int() }}"{{ if request.AdminLevel.Equal(adminLevel) }} selected{{ end }}>{{ adminLevel.String() }}</option>
					{{ end }}
				</select>
			</div>
			<div class="form-group">
				<label for="nama" class="label-title">Nama User</label>
				<input type="text"
					name="name"
					value="{{ request.Name }}"
					id="name"
					class="form-control input"
					placeholder="Nama User" />
			</div>
			<div class="row">
				<div class="form-group col-lg-6">
					<label for="email" class="label-title">Email</label>
					<input type="text"
						class="form-control input"
						name="email"
						value="{{ if request.Email }}{{ request.Email }}{{ end }}"
						id="email"
						placeholder="Email"
						data-toggle="tooltip"
						data-placement="top" />
				</div>
				<div class="form-group col-lg-6">
					<label for="mobile_phone" class="label-title">Nomor Telepon</label>
					<input type="text"
						class="form-control input"
						name="mobile_phone"
						value="{{ if request.MobilePhone }}{{ request.MobilePhone }}{{ end }}"
						id="mobile_phone"
						placeholder="Nomor Telepon" />
				</div>
			</div>
			<div class="row">
				<div class="form-group col-lg-4">
					<label for="username" class="label-title">Username</label>
					<input type="text"
						name="username"
						value="{{ request.Username }}"
						id="username"
						class="form-control input"
						placeholder="Username" />
				</div>
				<div class="form-group">
					<input type="checkbox" name="password_included" id="password_included" class="mr-2"{{ if request.PasswordIncluded }} checked{{ end }} />
					<label for="password_included" class="label-title cp">Isi Password</label>
				</div>
				<div class="form-group col-lg-4">
					<label for="password" class="label-title">Password</label>
					<input type="password"
						id="password"
						class="form-control input"
						placeholder="Password"{{ if !request.PasswordIncluded }} disabled{{ end }} />
					<input type="hidden" name="password"{{ if !request.PasswordIncluded }} disabled{{ end }} />
				</div>
				<div class="form-group col-lg-4">
					<label for="password_confirmation" class="label-title">Konfirmasi Password</label>
					<input type="password"
						id="password_confirmation"
						class="form-control input"
						placeholder="Konfirmasi Password"{{ if !request.PasswordIncluded }} disabled{{ end }} />
					<input type="hidden" name="password_confirmation"{{ if !request.PasswordIncluded }} disabled{{ end }} />
				</div>
			</div>
			<hr class="mb-4" />
			<button type="submit" class="btn btn-success mr-1">
				Simpan{{ if !request.New() }} Perubahan{{ end }} Data Admin
			</button>
			<a href="{{ baseURL }}/admin/admins" class="btn btn-default ml-1">
				Back to List Admin
			</a>
		</div>
	</div>
</form>
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("photo").addEventListener("change", (event) => {
			let file = event.target.files[0]
			if (!file || !file.type.startsWith("image/")) {
				return;
			}
			let preview = document.getElementById("photo_preview");
			preview.setAttribute("src", URL.createObjectURL(file));
			preview.classList.add("img-thumbnail");
		});
		document.getElementById("password_included").addEventListener("change", (event) => {
			if (event.target.checked) {
				document.getElementById("password").removeAttribute("disabled");
				document.getElementById("password_confirmation").removeAttribute("disabled");
				document.querySelector('input[name="password"]').removeAttribute("disabled");
				document.querySelector('input[name="password_confirmation"]').removeAttribute("disabled");
				return;
			}
			document.getElementById("password").setAttribute("disabled", "disabled");
			document.getElementById("password_confirmation").setAttribute("disabled", "disabled");
			document.querySelector('input[name="password"]').setAttribute("disabled", "disabled");
			document.querySelector('input[name="password_confirmation"]').setAttribute("disabled", "disabled");
		});
		document.getElementById("password").addEventListener("change", (event) => {
			document.querySelector('input[name="password"]').value = btoa(event.target.value);
		});
		document.getElementById("password_confirmation").addEventListener("change", (event) => {
			document.querySelector('input[name="password_confirmation"]').value = btoa(event.target.value);
		});
	});
</script>
