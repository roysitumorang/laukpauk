<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Blog</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Edit Data Blog
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Edit Data Blog</h5>
						</div>
						<div class="col-lg-8 text-right"></div>
					</div>
				</div>
				<div class="card-body">
					{{ range type, message := flash.Data }}
					<div class="alert alert-{{ type }}">
						<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
					</div>
					{{ end }}
					<form method="POST" action="{{ baseURL }}/admin/blogs/{{ blog.ID }}" enctype="multipart/form-data">
						{{ include "_blog_form" }}
					</form>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.css" />
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.css" />
<script>
	let baseURL = '{{ baseURL }}/admin/';
	let imgPreview = false;
	let imgData = false;
	let idBlog = '/{{ blog.ID }}';
	$('#content').summernote({
		toolbar: _summernoteCustomToolbar,
		placeholder: 'Your Content Here'
	});

	function blogImgChanged(thisContext) {
		try {
			let el = $(thisContext);
			let _imgData = el.prop('files')[0];
			let fileReader = new FileReader();
			fileReader.readAsDataURL(_imgData);
			fileReader.onload = (e) => {
				let imgResult = e.target.result;
				imgPreview = imgResult;
				imgData = _imgData;
				$('#imgPreview').attr('src', imgPreview).addClass('img-thumbnail');
			}
		} catch (e) {
			console.log(e);
		}
	}
	$('#formBlog').on('submit', function(e) {
		e.preventDefault();
		let _formData = new FormData();
		if (imgData !== false) {
			_formData.append('img', imgData);
		}
		_formData.append('title', $('#title').val());
		_formData.append('content', $('#content').val());
		$.ajax({
			url: `${baseURL}Blog/saveBlog${idBlog}`,
			type: 'POST',
			data: _formData,
			processData: false,
			contentType: false,
			cache: false,
			success: function(_decodedRFS) {
				let _statusSaveBlog = _decodedRFS.statusSaveBlog;
				let _swalType, _swalMessage;
				if (_statusSaveBlog) {
					_swalMessage = 'Berhasil menyimpan data blog!';
					_swalType = 'success';
				} else {
					_swalMessage = 'Gagal menyimpan data blog!';
					_swalType = 'error';
				}
				Swal.fire({
					title: 'Blog',
					html: _swalMessage,
					type: _swalType
				}).then(() => {
					if (_statusSaveBlog) {
						location.href = `${baseURL}blog`;
					}
				});
			}
		});
	});
</script>
