<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
<div class="row">
	<div class="col-lg-4">
		<label for="photo">
			<img src="{{ baseURL }}/images/product_category/{{ request.Photo }}"
				class="w-100 cp" data-toggle="tooltip"
				data-placement="left" title="Klik Gambar untuk Memilih Gambar" alt="Foto Kategori Produk"
				id="imgKategoriProduk"
				onerror="this.src='{{ baseURL }}/assets/img/upload-icon.png'" />
			<input type="file" name="photo" id="photo" onChange="katagoriProdukChanged(this)"
				style="display:block;" />
		</label>
	</div>
	<div class="col-lg-8">
		<div class="form-group">
			<label for="name" class="label-title">Nama Kategori Produk</label>
			<input type="text" name="name" value="{{ request.Name }}" class="form-control" id="name"
				placeholder="Nama Kategori Produk" />
		</div>
		<div class="form-group">
			<label for="description" class="label-title">Keterangan Kategori Produk</label>
			<textarea name="description" class="form-control" id="description"
				placeholder="Keterangan Kategori Produk">{{ request.Description }}</textarea>
		</div>
		<hr class="mt-3 mb-4">
		<button class="btn btn-success mr-1">Simpan  Data Kategori Produk</button>
		<a href="{{ baseURL }}/admin/product_categories">
			<button class="btn btn-default ml-1" type="button">Back to List Kategori Produk</button>
		</a>
	</div>
</div>
