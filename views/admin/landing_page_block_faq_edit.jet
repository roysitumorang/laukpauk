<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Edit Data Bantuan</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Website</a>
						</li>
						<li class="breadcrumb-item active">
							List Data Bantuan
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<div class="row">
								<div class="col-lg-4">
									<h5>Edit Data Bantuan</h5>
								</div>
								<div class="col-lg-8 text-right">
									<a href="{{ baseURL }}/admin/landing_page/blocks/faq">
										<button class="btn btn-link btn-sm">List Data Bantuan</button>
									</a>
								</div>
							</div>
						</div>
						<div class="card-body">
							{{ range type, message := flash.Data }}
							<div class="alert alert-{{ type }}">
								<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
							</div>
							{{ end }}
							<form method="POST" action="{{ baseURL }}/admin/landing_page/blocks/faq/items/{{ landingPageBlockItemID }}" enctype="multipart/form-data">
								{{ include "_landing_page_block_faq_form" }}
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	let baseURL = '{{ baseURL }}/admin/';
	let idElement = '/{{ landingPageBlockItemID }}';
	$('#content').summernote({
		toolbar: _summernoteCustomToolbar
	});
	$('#formBantuan').on('submit', function(e) {
		e.preventDefault();
		let _formData = new FormData();
		_formData.append('title', $('#title').val());
		_formData.append('content', $('#content').val());
		$.ajax({
			url: `${baseURL}Bantuan/saveBantuan${idElement}`,
			type: 'POST',
			data: _formData,
			processData: false,
			contentType: false,
			cache: false,
			success: function(_decodedRFS) {
				let _statusSaveBantuan = _decodedRFS.statusSaveBantuan;
				let _swalType, _swalMessage;
				if (_statusSaveBantuan) {
					_swalMessage = 'Berhasil menyimpan data bantuan!';
					_swalType = 'success';
				} else {
					_swalMessage = 'Gagal menyimpan data bantuan!';
					_swalType = 'error';
				}
				Swal.fire({
					title: 'Bantuan',
					html: _swalMessage,
					type: _swalType
				}).then(() => {
					if (_statusSaveBantuan) {
						location.href = `${baseURL}website/bantuan`;
					}
				});
			}
		});
	});
</script>
