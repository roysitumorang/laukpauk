<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta http-equiv="x-ua-compatible" content="ie=edge" />
	<meta name="csrf-token" content="{{ csrfToken }}">
	<meta name="csrf-header" content="X-Csrf-Token">
	<title>{{ pageTitle }}</title>
	<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/fontawesome-free/css/all.min.css" />
	<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/ionicons/ionicons.min.css" />
	<link rel="stylesheet" href="{{ baseURL }}/assets/dist/css/adminlte.min.css" />
	<!-- Google Font: Source Sans Pro -->
	<!-- <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700"> -->
	<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/animate.css/animate.css" />
	<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/sweetalert2/sweetalert2.min.css" />
	<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/select2/css/select2.min.css" />
	<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/select2-bootstrap4-theme/select2-bootstrap4.css" />
	<link rel="shortcut icon" href="{{ baseURL }}/assets/img/laukpauk-icon.png" />
	<link rel="stylesheet" href="{{ baseURL }}/assets/css/flatpickr.min.css" />
	<!-- REQUIRED SCRIPTS -->
	<!-- jQuery -->
	<script src="{{ baseURL }}/assets/plugins/jquery/jquery.min.js"></script>
	<script src="{{ baseURL }}/assets/plugins/jquery-ui/jquery-ui.min.js"></script>
	<!-- Bootstrap -->
	<script src="{{ baseURL }}/assets/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
	<!-- AdminLTE -->
	<script src="{{ baseURL }}/assets/dist/js/adminlte.js"></script>
	<!-- OPTIONAL SCRIPTS -->
	{{ if path == "/admin" }}
	<script src="{{ baseURL }}/assets/plugins/chart.js/Chart.min.js"></script>
	<script src="{{ baseURL }}/assets/dist/js/demo.js"></script>
	<script src="{{ baseURL }}/assets/dist/js/pages/dashboard3.js"></script>
	{{ end }}
	<script src="{{ baseURL }}/assets/js/flatpickr.min.js"></script>
	<script src="{{ baseURL }}/assets/plugins/sweetalert2/sweetalert2.min.js"></script>
	<script src="{{ baseURL }}/assets/plugins/select2/js/select2.min.js"></script>
	<script>
		let _summernoteCustomToolbar = [
			["style", ["style", "bold", "italic", "underline"]],
			["fontname", ["fontname"]],
			["fontsizeunit", ["fontsize", "fontsizeunit"]],
			["fullscreen", ["fullscreen"]],
			["undo", ["undo", "redo", "help"]],
			["codeview", ["codeview"]],
			["font", ["strikethrough", "superscript", "subscript"]],
			["color", ["color"]],
			["para", ["ul", "ol", "paragraph"]],
			["height", ["height"]],
			["insert", ["picture", "link", "video", "hr", "table"]]
		];
	</script>
	<style type="text/css">
		.nav-treeview > .nav-item {
			font-size: .8rem;
			margin-left: 1rem;
		}
		.nav-treeview > .nav-item .nav-icon {
			font-size: .8rem !important;
		}
		.cp {
			cursor: pointer;
		}
		.label-title {
			font-weight: 100 !important;
		}
		.vam {
			vertical-align: middle !important;
		}
		.size-50-50 {
			width: 50px;
			height: 50px;
		}
		.size-25-25 {
			width: 25px;
			height: 25px;
		}
		.size-15-15 {
			width: 15px;
			height: 15px;
		}
		.sidebar::-webkit-scrollbar {
			width: .35rem;
			height: .5rem;
		}
		.sidebar::-webkit-scrollbar-thumb {
			background-color: #d2dfd9;
		}
	</style>
</head>
<body class="hold-transition sidebar-mini">
	<div class="wrapper">
		<!-- Navbar -->
		<nav class="main-header navbar navbar-expand navbar-white navbar-light">
			<!-- Left navbar links -->
			<ul class="navbar-nav">
				<li class="nav-item">
					<a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a>
				</li>
			</ul>
			<!-- Right navbar links -->
			<ul class="navbar-nav ml-auto">
				<li class="nav-item">
					<a class="nav-link" href="{{ baseURL }}/admin/auth/logout">
						<i class="fas fa-power-off text-danger" data-toggle="tooltip" data-placement="top" title="Logout"></i>
					</a>
				</li>
			</ul>
		</nav>
		<!-- /.navbar -->
		<!-- Main Sidebar Container -->
		<aside class="main-sidebar sidebar-dark-primary elevation-4">
			<!-- Brand Logo -->
			<a href="{{ baseURL }}/admin" class="brand-link">
				<img src="{{ baseURL }}/assets/img/laukpauk-icon.png"
					alt="AdminLTE Logo"
					class="brand-image img-circle elevation-3"
					style="opacity: 0.8" />
				<span class="brand-text font-weight-light">Laukpauk</span>
			</a>
			<!-- Sidebar -->
			<div class="sidebar">
				<!-- Sidebar user panel (optional) -->
				<div class="user-panel mt-3 pb-3 mb-3 d-flex">
					<div class="image">
						<a href="{{ currentAdmin.PhotoPath(baseURL) }}" target="_blank">
						<img src="{{ currentAdmin.PhotoPath(baseURL) }}"
							class="img-circle elevation-2"
							alt="{{ currentAdmin.Name }}"
							style="width:3.2rem;" />
						</a>
					</div>
					<div class="info pt-0 pl-3">
						<a href="#" class="d-block mb-0">{{ currentAdmin.Name }}</a>
						<p class="text-white text-sm mb-0 mt-1">{{ currentAdmin.Username }}</p>
					</div>
				</div>
				<!-- Sidebar Menu -->
				<nav class="mt-2">
					<ul class="nav nav-pills nav-sidebar flex-column"
						data-widget="treeview"
						role="menu"
						data-accordion="false">
						<li class="nav-header">Menu</li>
						<li class="nav-item">
							<a href="{{ baseURL }}/admin" class="nav-link">
								<i class="nav-icon fa fa-desktop"></i>
								<p>Dashboard</p>
							</a>
						</li>
						{{ if currentAdmin.SuperAdmin() }}
						<li class="nav-item has-treeview{{ if HasPrefix(path, "/admin/admins") }} menu-open{{ end }}">
							<a href="#" class="nav-link">
								<i class="nav-icon fa fa-user-circle"></i>
								<p>
									Administrator
									<i class="fas fa-angle-left right"></i>
								</p>
							</a>
							<ul class="nav nav-treeview"{{ if HasPrefix(path, "/admin/admins") }} style="display:block"{{ end }}>
								<li class="nav-item">
									<a href="{{ baseURL }}/admin/admins" class="nav-link">
										<i class="fa fa-crown nav-icon"></i>
										<p>Administrator</p>
									</a>
								</li>
								<li class="nav-item">
									<a href="{{ baseURL }}/admin/admins/new" class="nav-link">
										<i class="fa fa-user-plus nav-icon"></i>
										<p>Administrator Baru</p>
									</a>
								</li>
							</ul>
						</li>
						{{ end }}
					</ul>
				</nav>
				<!-- /.sidebar-menu -->
			</div>
			<!-- /.sidebar -->
		</aside>
		{{ embed() }}
		<!-- Main Footer -->
		<footer class="main-footer">
			<strong>Copyright &copy; 2026 <a href="{{ baseURL }}" target="_blank">laukpauk.id</a></strong>
		</footer>
	</div>
	<!-- ./wrapper -->
	<script>
		let baseURLJS = "{{ baseURL }}/admin/";
		$("[data-toggle=tooltip]").tooltip();
		$(".notifikasi-item").on("click", function(e) {
			e.preventDefault();
			let href = $(this).attr("href");
			let idNotifikasi = $(this).attr("idNotifikasi");
			$.ajax({
				url: `${baseURLJS}/NotifikasiAdmin/toggleStatus/${idNotifikasi}`,
				success: function(responseFromServer) {
					let rFS = JSON.parse(responseFromServer);
					let statusToggleStatus = rFS.statusToggleStatus;
					if (statusToggleStatus) {
						location.href = href;
					}
				}
			});
		});
		$(".not-allowed").on("click", function(e) {
			e.preventDefault();
			// Swal.fire({
			//     title   :   "Not Allowed",
			//     html    :   "Anda tidak diijinkan untuk mengakses halaman ini!",
			//     type    :   "warning"
			// });
			alert("Anda tidak diijinkan untuk mengakses halaman ini!");
		});
		$("body").addClass("layout-fixed layout-navbar-fixed layout-footer-fixed");
		// let environment = "development";
		let environment = "production";
		window.OneSignal = window.OneSignal || [];
		OneSignal.push(function() {
			OneSignal.init({
				appId: (environment === "development") ? "52b56d11-5d2b-43e0-ba06-25f99fbde235" : "21ac8b87-e7cc-48b4-9fba-c38ccdf159c3",
				subdomainName: "laukpauk",
				promptOptions: {
					slidedown: {
						enabled: true,
						autoPrompt: true,
						timeDelay: 1,
						pageViews: 3,
						actionMessage: "Laukpauk ingin mengirimkan notifikasi realtime. Aktifkan fitur ini dengan klik ALLOW",
						acceptButtonText: "ALLOW",
						cancelButtonText: "NO"
					}
				}
			});
			OneSignal.on("notificationDisplay", function(noticationData) {
				notificationReceived();
			});
		});

		function notificationReceived() {
			let notificationRingtone = new Audio("assets/ringtone/notification.mp3");
			notificationRingtone.play();
			let jumlahNotifikasiBelumDibaca = getJumlahNotifikasi(false);
			let notifikasiAdminBelumDibaca = getNotifikasiAdmin(false, 5);
			let notifikasiAdminBelumDibacaHTML = "";
			if (notifikasiAdminBelumDibaca.length >= 1) {
				notifikasiAdminBelumDibaca.forEach((item, index) => {
					notifikasiAdminBelumDibacaHTML += `
						<div class="dropdown-divider"></div>
						<a href="${item.route}" class="notifikasi-item" idNotifikasi="${item.id}">
							<div class="dropdown-item">
								<div class="row">
									<div class="col-lg-2 text-center">
										<span class="fa fa-bell"></span>
									</div>
									<div class="col-lg-10">
										<p class="text-primary mb-1" class="word-break:break-all;">${item.judul.toUpperCase()}</p>
										<span class="text-muted" style="font-size:.75em">Pada ${item.waktu}</span>
									</div>
								</div>
							</div>
						</a>`;
				});
			}
			$("#jumlahNotifikasi").text(jumlahNotifikasiBelumDibaca);
			$("#notifikasi").html(notifikasiAdminBelumDibacaHTML);
		}

		function getJumlahNotifikasi(isRead = null) {
			let jumlahNotifikasi = 0;
			let isReadQS = "";
			if (isRead != null) {
				isReadQS = `${(isRead)? "&isRead=true" : "&isRead=false"}`;
			}
			$.ajax({
				url: `{{ baseURL }}/admin/Admin/getJumlahNotifikasiAdmin?${isReadQS}`,
				async: false,
				success: function(responseFromServer) {
					let rFS = JSON.parse(responseFromServer);
					jumlahNotifikasi = rFS.numberOfAdminNotification;
				}
			});
			return jumlahNotifikasi;
		}

		function getNotifikasiAdmin(isRead = null, limit = null) {
			let notifikasiAdmin = [];
			let isReadQS = "";
			let limitQS = "";
			if (isRead != null) {
				isReadQS = `${(isRead)? "&isRead=true" : "&isRead=false"}`;
			}
			if (limit != null) {
				limitQS = `&limit=${limit}`;
			}
			$.ajax({
				url: `{{ baseURL }}/admin/Admin/getNotifikasiAdmin?${isReadQS}${limitQS}`,
				async: false,
				success: function(responseFromServer) {
					let rFS = JSON.parse(responseFromServer);
					notifikasiAdmin = rFS.notifikasiAdmin;
				}
			});
			return notifikasiAdmin;
		}
	</script>
</body>
</html>
