<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
<div class="row">
	<div class="col-lg-4 text-center">
		<label for="blogImg">
			<img src="{{ baseURL }}/assets/img/upload-icon.png"
				alt="Foto Blog"
				id="imgPreview"
				class="w-100 cp"
				data-toggle="tooltip"
				data-placement="left"
				title="Klik Gambar untuk Memilih Gambar" />
			<input type="file"
				name="photo"
				id="blogImg"
				onChange="blogImgChanged(this)" />
		</label>
	</div>
	<div class="col-lg-8">
		<div class="form-group">
			<label for="subject" class="label-title">Title</label>
			<input type="text"
				class="form-control"
				name="subject"
				id="subject"
				placeholder="Sekarang Anda bisa ke pasar dekat rumah, sambil pilih-pilih kebutuhan dapur"
				value="{{ request.Subject }}" />
		</div>
		<div class="form-group">
			<label for="slug" class="label-title">Slug</label>
			<input type="text"
				class="form-control"
				name="slug"
				id="slug"
				placeholder="Slug"
				value="{{ request.Slug }}" />
		</div>
		<div class="form-group">
			<label for="body" class="label-title">Content</label>
			<textarea class="form-control"
				name="body"
				id="body"
				placeholder="Your Content Here">{{ request.Body }}</textarea>
		</div>
		<hr />
		<button type="submit" class="btn btn-success mr-1">
			Simpan Data Blog
		</button>
		<a href="{{ baseURL }}/admin/blogs" class="btn btn-default ml-1">
			Back to List Blog
		</a>
		<script>
			$(document).ready(function() {
				$("#body").summernote()
			});
		</script>
	</div>
</div>
