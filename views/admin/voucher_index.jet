<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Voucher</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							List Data Voucher
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Data Voucher</h5>
						</div>
						<div class="col-lg-8 text-right">
							<a href="{{ baseURL }}/admin/vouchers/new" data-toggle="tooltip"
								data-placement="top" title="Tambah Voucher Baru">
								Add New Voucher
							</a>
						</div>
					</div>
				</div>
				<div class="card-body">
					<div class="col-lg-12 table-responsive">
						{{ range type, message := flash.Data }}
						<div class="alert alert-{{ type }}">
							<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
						</div>
						{{ end }}
						<form method="GET" action="{{ baseURL }}/admin/vouchers">
							<div class="row">
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Show
											<select name="limit" id="limit" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, limit := limits }}
												<option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
												{{ end }}
											</select> entries
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div id="listBlog_filter" class="dataTables_filter">
										<label for="q">
											Search: <input type="text" name="q" id="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Sort by
											<select name="sort_by" multiple id="sort_by" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, sorting := sortings }}
												<option value="{{ sorting.String() }}"{{ if request.MapSortings.Contains(sorting.String()) }} selected{{ end }}>{{ sorting.Label }}</option>
												{{ end }}
											</select>
										</label>
									</div>
								</div>
							</div>
						</form>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
						<table class="table-sm table table-striped" id="listVoucher">
							<thead>
								<tr>
									<th class="border-top-0 text-center">No.</th>
									<th class="border-top-0 text-left">Voucher</th>
									<th class="border-top-0 text-left">Budget / Nilai Voucher</th>
									<th class="border-top-0 text-left">Jenis</th>
									<th class="border-top-0 text-right">Minimum Belanja</th>
									<th class="border-top-0 text-center">Maximum Usage Per Buyer</th>
									<th class="border-top-0 text-left">Masa Berlaku</th>
									<th class="border-top-0 text-center">Status</th>
									<th class="border-top-0 text-center">Opsi</th>
								</tr>
							</thead>
							<tbody>
								{{ range _, row := rows }}
								<tr class="text-sm tr-parent">
									<td class="vam text-center"><b>{{ row.RowNo }}.</b></td>
									<td class="vam text-left">
										<div class="row">
											<div class="col-lg-4 text-center">
												<a href="{{ baseURL }}/images/voucher/{{ row.Photo }}" target="_blank">
													<img src="{{ baseURL }}/images/voucher/compress/{{ row.Photo }}"
													class="img-circle cp" style="width:50px; height:50px;"
													onerror="this.src='{{ baseURL }}/assets/img/no-image.png'" />
												</a>
											</div>
											<div class="col-lg-8">
												<h6 class="text-info mb-0"><b>{{ row.Name }}</b></h6>
												<p class="text-sm text-muted mb-1">Kode : {{ row.Code }}</p>
											</div>
										</div>
									</td>
									<td class="vam text-right">Rp. {{ row.Budget | Comma }} / Rp. {{ row.Discount | Comma }}</td>
									<td class="vam text-left">
										<span class="badge badge-info" data-toggle="tooltip"
											data-placement="top" title="Voucher untuk mengurangi {{ row.VoucherType.String() }}">{{ row.VoucherType.String() }}</span>
									</td>
									<td class="vam text-right">Rp. {{ row.Discount | Comma }}</td>
									<td class="vam text-center">{{ row.QuotaPerBuyer }}x Pemakaian</td>
									<td class="vam text-left">
										{{ row.EffectiveStartDate.Format("2 Jan 2006") }} s/d {{ row.EffectiveEndDate.Format("2 Jan 2006") }}

										<br> Jam {{ row.EffectiveStartTime.Format("15:04:05") }} s/d {{ row.EffectiveEndTime.Format("15:04:05") }}
									</td>
									<td class="vam text-center">
										<span class="badge badge-{{ if row.Status() == "expired" }}danger{{ else if row.Status() == "pending" }}secondary{{ else }}success{{ end }}">{{ row.Status() }}</span>
									</td>
									<td class="vam text-center">
										<a href="{{ baseURL }}/admin/vouchers/{{ row.ID }}/edit">
											<span class="fa fa-edit text-warning cp mx-2" data-toggle="tooltip"
												data-placement="top" title="Edit Data Voucher"></span>
										</a>
										<form method="POST" action="{{ baseURL }}/admin/vouchers/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
											<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
												<span class="fa fa-trash text-danger cp ml-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Hapus Data Voucher"
												onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
											</span>
										</form>
									</td>
								</tr>
								{{ end }}
							</tbody>
						</table>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
