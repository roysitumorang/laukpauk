<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Jadwal Tutup</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Jadwal Tutup</a>
						</li>
						<li class="breadcrumb-item active">
							Histori Jadwal Tutup
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-lg-12">
					<div class="card">
						<div class="card-header">
							<div class="row">
								<div class="col-lg-4">
									<h5>Jadwal Tutup</h5>
								</div>
								<div class="col-lg-8 text-right">
									<a href="{{ baseURL }}/admin/custom_delivery_days/new">
										<button class="btn btn-link btn-sm">Jadwal Tutup Baru</button>
									</a>
								</div>
							</div>
						</div>
						<div class="card-body table-responsive">
							{{ range type, message := flash.Data }}
							<div class="alert alert-{{ type }}">
								<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
							</div>
							{{ end }}
							<form method="GET" action="/admin/custom_delivery_days">
								<div class="row">
									<div class="col-sm-4 col-md-6">
										<div class="dataTables_length" id="listBlog_length">
											<label for="limit">
												Show
												<select name="limit" id="limit" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
													{{ range _, limit := limits }}
													<option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
													{{ end }}
												</select> entries
											</label>
										</div>
									</div>
									<div class="col-sm-4 col-md-6">
										<div id="listBlog_filter" class="dataTables_filter">
											<label for="q">
												Search: <input type="text" name="q" id="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
											</label>
										</div>
									</div>
									<div class="col-sm-4 col-md-6">
										<div class="dataTables_length" id="listBlog_length">
											<label for="limit">
												Sort by
												<select name="sort_by" multiple id="sort_by" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
													{{ range _, sorting := sortings }}
													<option value="{{ sorting.String() }}"{{ if request.MapSortings.Contains(sorting.String()) }} selected{{ end }}>{{ sorting.Label }}</option>
													{{ end }}
												</select>
											</label>
										</div>
									</div>
								</div>
							</form>
							{{ if pagination.Info.Total > pagination.Info.Limit }}
							<ul class="pagination">
								{{ if pagination.Links.First }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
								{{ end }}
								{{ if pagination.Links.Previous }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
								{{ end }}
								{{ if pagination.Links.Current }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
								{{ end }}
								{{ if pagination.Links.Next }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
								{{ end }}
								{{ if pagination.Links.Last }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
								{{ end }}
								<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
							</ul>
							{{ end }}
							<table class="table table-sm" id="tabelJadwalTutup">
								<thead>
									<th class="border-top-0 text-center text-bold">No.</th>
									<th class="border-top-0 text-left text-bold">Tanggal Tutup</th>
									<th class="border-top-0 text-left text-bold">Jadwal</th>
									<th class="border-top-0 text-center text-bold">Action</th>
								</thead>
								<tbody>
									{{ range _, row := rows }}
									<tr>
										<td><p class="mb-0 text-center"><b>{{ row.RowNo }}.</b></p></td>
										<td>
											<h6 class="mb-2 text-bold">Tanggal <b class="text-primary">{{ row.Date.Format("Mon, 2 Jan 2006") }}</b></h6>
											<div class="col">
												<div class="row">
													<div class="col pl-2">
														<span class="text-sm">Dibuat pada <b>{{ row.CreatedAt.Format("Mon, 2 Jan 2006 15:04:05") }}</b></span>
													</div>
												</div>
											</div>
										</td>
										<td>
											<p class="text-sm text-muted mb-1">
												<b>{{ row.DeliveryPlanName }}</b>
											</p>
										</td>
										<td>
											<form method="POST" action="{{ baseURL }}/admin/custom_delivery_days/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
												<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
												<span class="fa fa-trash text-danger cp ml-2"
													data-toggle="tooltip"
													data-placement="top"
													title="Hapus Data Jadwal Tutup"
													onclick="confirm('Are you sure to delete this blog ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
												</span>
											</form>
										</td>
									</tr>
									{{ end }}
								</tbody>
							</table>
							{{ if pagination.Info.Total > pagination.Info.Limit }}
							<ul class="pagination">
								{{ if pagination.Links.First }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
								{{ end }}
								{{ if pagination.Links.Previous }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
								{{ end }}
								{{ if pagination.Links.Current }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
								{{ end }}
								{{ if pagination.Links.Next }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
								{{ end }}
								{{ if pagination.Links.Last }}
								<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
								{{ end }}
								<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
							</ul>
							{{ end }}
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
