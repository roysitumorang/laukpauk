<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Transaksi</h1>
					<p class="text-sm text-muted">{{ transaction.ReferenceNumber }}</p>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Detail Transaksi
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Detail Transaksi</h5>
							{{ transaction.ReferenceNumber }}
						</div>
						<div class="col-lg-8 text-right"></div>
					</div>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="offset-lg-2"></div>
						<div class="col-lg-3 text-center pr-3 d-flex" style="align-items:center;">
							<img src="{{ baseURL }}/assets/img/emak-senang.png"
								alt="{{ transaction.ReferenceNumber }}" class="w-100"
								style="width:250px;"
								onerror="this.src='{{ baseURL }}/assets/img/no-image.png'" />
						</div>
						<div class="col-lg-7 border-left pl-3">
							<h2 class="text-primary text-bold mb-4">Nomor Transaksi {{ transaction.ReferenceNumber }}</h2>
							<div class="table-responsive">
								<table class="table table-sm">
									<tr class="text-sm">
										<td class="border-top-0 text-left">Nama Penerima</td>
										<td class="border-top-0 text-left">{{ transaction.RecipientName }}</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Nomor HP Penerima</td>
										<td class="border-top-0 text-left">{{ transaction.RecipientMobilePhone }}</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Alamat Pengantaran</td>
										<td class="border-top-0 text-left">{{ transaction.DeliveryAddress }}</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Catatan</td>
										<td class="border-top-0 text-left">
											{{ if transaction.BuyerNote }}
											{{ transaction.BuyerNote }}
											{{ else }}
											<i class="text-muted">Catatan Tidak Ada</i>
											{{ end }}
										</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Waktu Checkout</td>
										<td class="border-top-0 text-left">{{ transaction.CreatedAt.Format("Mon, 2 Jan 2006 15:04:05 MST") }}</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Status Transaksi</td>
										<td class="border-top-0 text-left">
											{{ transaction.TransactionStatus.String() }}
											<p class="text-sm text-muted mb-0">
												<span class="text-sm">pada {{ transaction.UpdatedAt.Format("Mon, 2 Jan 2006 15:04:05 MST") }}</span>
											</p>
										</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Ongkos Kirim</td>
										<td class="border-top-0 text-left">
											<b class="text-sm text-info">Rp. {{ transaction.DeliveryCost | Comma }}</b>
										</td>
									</tr>
									<tr class="text-sm">
									<td class="border-top-0 text-left">Total Belanja</td>
										<td class="border-top-0 text-left">
											<b class="text-success">Rp. {{ transaction.Subtotal | Comma }}</b>
										</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Potongan Voucher</td>
										<td class="border-top-0 text-left">
											<p class="text-sm mb-0">
												Rp. {{ transaction.VoucherDiscount | Comma }}
											</p>
										</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Potongan Wallet/Dompet</td>
										<td class="border-top-0 text-left">
											<p class="text-sm mb-0">
												Rp. {{ transaction.WalletDiscount | Comma }}
											</p>
										</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">Potongan Point</td>
										<td class="border-top-0 text-left">
											<p class="text-sm mb-0">
												Rp. {{ transaction.PointDiscount | Comma }}
											</p>
										</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">GRAND TOTAL (Sebelum Pemeriksaan)</td>
										<td class="border-top-0 text-left">
											<p class="text-sm mb-0 text-bold text-success">
												Rp. {{ transaction.PaymentAmount | Comma }}
											</p>
										</td>
									</tr>
									<tr class="text-sm">
										<td class="border-top-0 text-left">GRAND TOTAL (Sesudah Pemeriksaan)</td>
										<td class="border-top-0 text-left">
											<p class="text-sm mb-0 text-bold text-success">
												Rp. {{ transaction.RevisedPaymentAmount | Comma }}
											</p>
										</td>
									</tr>
								</table>
							</div>
							<hr class="mb-3 mt-0" />
							<a href="{{ baseURL }}/admin/transactions/{{ transaction.ID }}/invoice" class="btn btn-info" target="_blank">
								Print Invoice
							</a>
							<a href="{{ baseURL }}/admin/transactions" class="btn btn-default">
								Kembali ke Daftar Belanja
							</a>
						</div>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Daftar Belanjaan (Transaksi Item)</h5>
							<span class="text-sm">{{ transaction.ReferenceNumber }}</span>
						</div>
						<div class="col-lg-8 text-right"></div>
					</div>
				</div>
				<div class="card-body">
					<div class="table-responsive">
						<table class="table table-sm" id="transaksiItem">
							<thead>
								<tr>
									<th class="text-center border-top-0">No.</th>
									<th class="text-left border-top-0">Produk</th>
									<th class="text-left border-top-0">Quantity</th>
									<th class="text-left border-top-0">Catatan</th>
									<th class="text-left border-top-0">Status</th>
									<th class="text-right border-top-0">Total Harga</th>
								</tr>
							</thead>
							<tbody>
								{{ range _, item := transaction.Items }}
								<tr class="text-sm tr-parent">
									<td class="vam text-center"><b>{{ item.RowNo }}.</b></td>
									<td class="vam text-left">
										<div class="row">
											<div class="col-lg-4 text-center">
												<img src="{{ baseURL }}/images/product/compress/{{ item.ProductPhoto }}"
													alt="{{ item.ProductName }}" class="img-circle"
													style="width:50px; height:50px;"
													onerror="this.src='{{ baseURL }}/assets/img/no-image.png'" />
											</div>
											<div class="col-lg-8">
												<h6 class="text-primary mb-1">"{{ item.ProductName }}</h6>
											</div>
										</div>
									</td>
									<td class="vam text-left">
										{{ item.Quantity }} x {{ item.StockUnit }}
									</td>
									<td class="vam text-left">
										{{ if item.BuyerNote }}
										{{ item.BuyerNote }}
										{{ else }}
										<i class="text-muted">Tanpa Catatan</i>
										{{ end }}
									</td>
									<td class="vam text-left">
										{{ if item.OutOfStock }}
										<span class="badge badge-secondary">Out of Stock</span>
										{{ else }}
										<span class="badge badge-success">OK</span>
										{{ end }}
									</td>
									<td class="vam text-right">
										<b class="text-success">Rp. {{ item.Subtotal | Comma }}</b>
									</td>
								</tr>
								{{ end }}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
