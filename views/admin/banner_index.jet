<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Banner</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							List Data Banner
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Data Banner</h5>
						</div>
						<div class="col-lg-8 text-right">
							<a href="{{ baseURL }}/admin/banners/new"
								data-toggle="tooltip"
								data-placement="top"
								title="Tambah Banner Baru">
								Add New Banner
							</a>
						</div>
					</div>
				</div>
				<div class="card-body">
					<div class="col-lg-12 table-responsive">
						{{ range type, message := flash.Data }}
						<div class="alert alert-{{ type }}">
							<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
						</div>
						{{ end }}
						<form method="GET" action="/admin/banners" id="search">
							<div class="row">
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listArtikel_length">
										<label>
											Show
											<select name="limit" aria-controls="listArtikel" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, limit := limits }}
												<option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
												{{ end }}
											</select> entries
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div id="listArtikel_filter" class="dataTables_filter">
										<label>
											Search: <input type="text" name="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Sort by
											<select name="sort_by" multiple id="sort_by" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, sorting := sortings }}
												<option value="{{ sorting.String() }}"{{ if request.MapSortings.Contains(sorting.String()) }} selected{{ end }}>{{ sorting.Label }}</option>
												{{ end }}
											</select>
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
										<button type="reset" class="btn btn-default" id="reset"><i class="fa fa-sync"></i> Reset</button>
									</div>
								</div>
							</div>
						</form>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
						<table class="table-sm table table-striped" id="listBanner">
							<thead>
								<tr>
									<th class="border-top-0 text-center">No.</th>
									<th class="border-top-0 text-left">Banner</th>
									<th class="border-top-0 text-left">Keterangan</th>
									<th class="border-top-0 text-left">Status</th>
									<th class="border-top-0 text-center">Opsi</th>
								</tr>
							</thead>
							<tbody>
								{{ range _, row := rows }}
								<tr class="text-sm tr-parent">
									<td class="text-center"><b>{{ row.RowNo }}.</b></td>
									<td class="text-left">
										<div class="row">
											<div class="col-lg-4 text-center">
												<a href="{{ if row.Photo }}{{ row.PhotoPath(baseURL) }}{{ else }}{{ baseURL}}/admin/assets/img/no-image.png{{ end }}"
													target="_blank">
													<img src="{{ if row.Photo }}{{ row.PhotoPath(baseURL) }}{{ else }}{{ baseURL}}/admin/assets/img/no-image.png{{ end }}"
														alt="{{ row.Name }}"
														class="img-circle"
														style="width:50px; height:50px;" />
												</a>
											</div>
											<div class="col-lg-8">
												<h6 class="text-info mb-1"><b>{{ row.Name }}</b></h6>
												<span class="badge badge-{{ if row.Visible }}success{{ else }}danger{{ end }}">
													{{ if row.Visible }}Banner ditampilkan{{ else }}Banner disembuyikan{{ end }}
												</span>
											</div>
										</div>
									</td>
									<td class="text-left vam">{{ if row.Description }}{{ row.Description }}{{ else }}-{{ end }}</td>
									<td class="text-left vam">
										<form method="POST" action="{{ baseURL }}/admin/banners/{{ row.ID }}/switch" id="switch-{{ row.ID }}">
											<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
											<span class="fa fa-eye text-{{ if row.Visible }}success{{ else }}danger{{ end }} cp ml-2"
												data-toggle="tooltip"
												data-placement="left"
												title="{{ if row.Visible }}Banner ini ditampilkan, klik untuk menyembunyikannya{{ else }}Banner ini disembunyikan, klik untuk menampilkannya{{ end }}"
												onclick="confirm('Are you sure to switch this item visibility ?')&&document.getElementById('switch-{{ row.ID }}').submit()">
											</span>
										</form>
									</td>
									<td class="vam text-center">
										<a href="{{ baseURL }}/admin/banners/{{ row.ID }}/edit">
											<span class="fa fa-edit text-warning cp mr-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Edit Data Artikel">
											</span>
										</a>
										<form method="POST" action="{{ baseURL }}/admin/banners/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
											<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
											<span class="fa fa-trash text-danger cp ml-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Hapus Data Banner"
												onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
											</span>
										</form>
									</td>
								</tr>
								{{ end }}
							</tbody>
						</table>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("reset").addEventListener("click", (event) => {
			event.preventDefault();
			let form = event.target.form;
			form.querySelectorAll("input[type=text]").forEach((select) => select.value = "");
			form.querySelectorAll("select").forEach((select) => select.selectedIndex = 0);
		});
	});
</script>
