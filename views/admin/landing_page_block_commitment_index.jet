<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Komitmen</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Website</a>
						</li>
						<li class="breadcrumb-item active">
							Komitmen
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			{{ range type, message := flash.Data }}
			<div class="alert alert-{{ type }}">
				<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
			</div>
			{{ end }}
			<form method="POST" action="{{ baseURL }}/admin/landing_page/blocks/commitment/custom_attributes">
				<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
				<div class="row">
					<div class="col-lg-12">
						<div class="card">
							<div class="card-header">
								<h5>Judul</h5>
							</div>
							<div class="card-body">
								<h6>Judul Sekarang</h6>
								<span class="text-muted text-sm">{{ existing.CustomAttributes["subject"] }}</span>
								<hr />
								<div class="form-group">
									<label for="subject">Judul Baru</label>
									<input type="text"
										name="subject"
										value="{{ request.CustomAttributes["subject"] }}"
										id="subject"
										class="form-control mb-2"
										placeholder="Kami Selalu Mencoba Memperluas Kapasitas Kami" />
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-lg-12">
						<div class="card">
							<div class="card-header">
								<h5>Content</h5>
							</div>
							<div class="card-body">
								<div class="form-group">
									<label for="body">Content</label>
									<textarea
										name="body"
										id="body"
										class="form-control mb-2"
										placeholder="Content">{{ request.CustomAttributes["body"] }}</textarea>
									<button type="submit" class="btn btn-success" id="btnSubmitContent">
										<span class="fa fa-save pr-2"></span>
										Simpan
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</form>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.css" />
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.css" />
<script>
	let baseURL = "{{ baseURL }}/admin/";
	$("#body").summernote({
		toolbar: _summernoteCustomToolbar
	});
	$("#formJudul, #formContent").on("submit", function(e) {
		e.preventDefault();
		let _data = $(this).serialize();
		$.ajax({
			url: "{{ baseURL }}/admin/Komitmen/saveProperties",
			data: _data,
			type: "POST",
			success: function(_decodedRFS) {
				let _statusSave = _decodedRFS.statusSave;
				let _type, _message;
				if (_statusSave) {
					_type = "success";
					_message = "Berhasil mengubah data !";
				} else {
					_type = "error";
					_message = "Gagal mengubah data! Ulangi lagi!";
				}
				Swal.fire({
					title: "Mengapa Harus Laukpauk",
					html: _message,
					type: _type
				}).then(() => {
					if (_statusSave) {
						location.href = `${baseURL}Website/komitmen`;
					}
				});
			}
		});
	});
</script>
