<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Pahlawan Dapur</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Website</a>
						</li>
						<li class="breadcrumb-item active">
							Pahlawan Dapur
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			{{ range type, message := flash.Data }}
			<div class="alert alert-{{ type }}">
				<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
			</div>
			{{ end }}
			<form method="POST" action="{{ baseURL }}/admin/landing_pages/kitchen-hero/custom_attributes" enctype="multipart/form-data">
				<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
				<div class="row">
					<div class="col-lg-12">
						<div class="card">
							<div class="card-header">
								<h5>Content</h5>
							</div>
							<div class="card-body">
								<div class="form-group">
									<label for="body">Content</label>
									<textarea
										name="body"
										id="body"
										class="form-control mb-2"
										placeholder="Content">{{ request.CustomAttributes["body"] }}</textarea>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-lg-12">
						<div class="card">
							<div class="card-header">
								<h5>Gambar</h5>
							</div>
							<div class="card-body">
								<label for="photo">
									<img src="{{ if _, ok := landingPage.CustomAttributes["photo"]; ok }}{{ landingPage.PhotoPath(baseURL) }}{{ else }}{{ baseURL }}/assets/img/upload-icon.png{{ end }}"
										alt="Foto User"
										class="w-100 cp img-thumbnail"
										data-toggle="tooltip"
										data-placement="top"
										title="Klik Gambar untuk Memilih Gambar"
										id="photo_preview" />
									<input type="file" name="photo" id="photo" accept="image/*" />
								</label>
								<hr />
								<button type="submit" class="btn btn-success">
									<span class="fa fa-save pr-2"></span>
									Simpan
								</button>
							</div>
						</div>
					</div>
				</div>
			</form>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.css" />
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.css" />
<script>
	document.addEventListener("DOMContentLoaded", () => {
		$("#body").summernote({
			toolbar: _summernoteCustomToolbar
		});
		document.getElementById("photo").addEventListener("change", (event) => {
			let file = event.target.files[0]
			if (!file || !file.type.startsWith("image/")) {
				return;
			}
			let preview = document.getElementById("photo_preview");
			preview.setAttribute("src", URL.createObjectURL(file));
			preview.classList.add("img-thumbnail");
		});
	});
</script>
