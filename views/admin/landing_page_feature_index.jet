<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Fitur Laukpauk</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Website</a>
						</li>
						<li class="breadcrumb-item active">
							Fitur Laukpauk
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-lg-6">
					<div class="card">
						<div class="card-body">
							<h5>Judul Sekarang</h5>
							<span class="text-muted text-sm">{{ landingPage.CustomAttributes["subject"] }}</span>
							<hr />
							<div class="row">
								<div class="col-lg-2">
									<h5>Judul</h5>
								</div>
								<div class="col-lg-10">
									<form method="POST" action="{{ baseURL }}/admin/landing_pages/feature/custom_attributes" id="formJudul">
										<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
										<div class="input-group">
											<input type="text" name="subject" value="{{ request.CustomAttributes["subject"] }}" placeholder="Fitur Laukpauk" class="form-control" />
											<div class="input-group-append">
												<button type="submit" class="btn btn-success" id="btnSubmit">
													<span class="fa fa-save pr-2"></span>
													Simpan
												</button>
											</div>
										</div>
									</form>
								</div>
							</div>
						</div>
					</div>
				</div>
				</div>
				<div class="row">
					<div class="col-lg-12">
						<div class="card">
							<div class="card-header">
								<div class="row">
									<div class="col-lg-4">
										<h5>Fitur Laukpauk</h5>
									</div>
									<div class="col-lg-8 text-right">
										<a href="{{ baseURL }}/admin/landing_pages/feature/items/new">
											<button class="btn btn-link btn-sm">Fitur Baru</button>
										</a>
									</div>
								</div>
							</div>
							<div class="card-body table-responsive">
								{{ range type, message := flash.Data }}
								<div class="alert alert-{{ type }}">
									<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
								</div>
								{{ end }}
								<form method="GET" action="/admin/landing_pages/feature">
									<div class="row">
										<div class="col-sm-12 col-md-6">
											<div class="dataTables_length" id="listBlog_length">
												<label for="limit">
													Show
													<select name="limit" id="limit" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
														{{ range _, limit := limits }}
														<option value="{{ limit }}"{{ if limit == paginationRequest.Limit }} selected{{ end }}>{{ limit }}</option>
														{{ end }}
													</select> entries
												</label>
											</div>
										</div>
										<div class="col-sm-12 col-md-6">
											<div id="listBlog_filter" class="dataTables_filter">
												<label for="q">
													Search: <input type="text" name="q" id="q" value="{{ paginationRequest.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
												</label>
											</div>
										</div>
										<div class="col-sm-4 col-md-6">
											<div class="dataTables_length" id="listBlog_length">
												<label for="limit">
													Sort by
													<select name="sort_by" multiple id="sort_by" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
														{{ range _, sorting := sortings }}
														<option value="{{ sorting.String() }}"{{ if paginationRequest.MapSortings.Contains(sorting.String()) }} selected{{ end }}>{{ sorting.Label }}</option>
														{{ end }}
													</select>
												</label>
											</div>
										</div>
										<div class="col-sm-4 col-md-6">
											<div class="dataTables_length" id="listBlog_length">
												<button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
												<button type="reset" class="btn btn-default" id="reset"><i class="fa fa-sync"></i> Reset</button>
											</div>
										</div>
									</div>
								</form>
								{{ if pagination.Info.Total > pagination.Info.Limit }}
								<ul class="pagination">
									{{ if pagination.Links.First }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
									{{ end }}
									{{ if pagination.Links.Previous }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
									{{ end }}
									{{ if pagination.Links.Current }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
									{{ end }}
									{{ if pagination.Links.Next }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
									{{ end }}
									{{ if pagination.Links.Last }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
									{{ end }}
									<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
								</ul>
								{{ end }}
								<table class="table table-sm" id="tabelFitur">
									<thead>
										<th class="border-top-0 text-center text-bold">No.</th>
										<th class="border-top-0 text-left text-bold">Gambar</th>
										<th class="border-top-0 text-left text-bold">Heading & Content</th>
										<th class="border-top-0 text-center text-bold">Action</th>
									</thead>
									<tbody>
										{{ range _, row := rows }}
										<tr role="row" class="odd">
											<td>
												<p class="mb-0 text-center"><b>{{ row.RowNo }}.</b></p>
											</td>
											<td>
												<a href="{{ row.PhotoPath(baseURL) }}" target="_blank">
													<img src="{{ row.PhotoPath(baseURL) }}" alt="{{ row.Subject }}" class="img-circle size-50-50">
												</a>
											</td>
											<td>
												<h6 class="mb-1 text-bold text-primary">{{ row.Subject }}</h6>
												<p class="mb-0 text-sm text-muted">{{ row.Body }}</p>
											</td>
											<td>
												<div class="text-center">
													<a href="{{ baseURL }}/admin/landing_pages/{{ row.LandingPageName }}/items/{{ row.ID }}/edit">
														<span class="fa fa-edit text-warning cp" data-toggle="tooltip" data-placement="top" title="Edit"></span>
													</a>
													<form method="POST" action="{{ baseURL }}/admin/landing_pages/{{ row.LandingPageName }}/items/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
														<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
															<span class="fa fa-trash text-danger cp ml-2"
															data-toggle="tooltip"
															data-placement="top"
															title="Hapus Data Hero Slider"
															onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
														</span>
													</form>
												</div>
											</td>
										</tr>
										{{ end }}
									</tbody>
								</table>
								{{ if pagination.Info.Total > pagination.Info.Limit }}
								<ul class="pagination">
									{{ if pagination.Links.First }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
									{{ end }}
									{{ if pagination.Links.Previous }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
									{{ end }}
									{{ if pagination.Links.Current }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
									{{ end }}
									{{ if pagination.Links.Next }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
									{{ end }}
									{{ if pagination.Links.Last }}
									<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
									{{ end }}
									<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
								</ul>
								{{ end }}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	document.addEventListener("DOMContentLoaded", () => {
		document.getElementById("reset").addEventListener("click", (event) => {
			event.preventDefault();
			let form = event.target.form;
			form.querySelectorAll("input[type=text]").forEach((select) => select.value = "");
			form.querySelectorAll("select").forEach((select) => select.selectedIndex = 0);
		});
	});
</script>
