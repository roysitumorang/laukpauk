<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Produk</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Detail Produk
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="row">
				<div class="col-lg-6">
					<div class="card">
						<div class="card-header">
							<div class="row">
								<div class="col-lg-4">
									<h5>Detail Produk</h5>
									{{ product.Name }}
								</div>
								<div class="col-lg-8 text-right"></div>
							</div>
						</div>
						<div class="card-body">
							<div class="row">
								<div class="col-lg-4 text-center">
									<img src="{{ baseURL }}{{ product.PhotoPath() }}"
										alt="{{ product.Name }}"
										class="img-circle"
										style="width:170px; height:170px;"
										onerror="this.src='{{ baseURL }}/assets/img/no-image.png'" />
								</div>
								<div class="col-lg-8">
									<h2 class="text-primary text-bold mb-3">
										{{ product.Name }}
									</h2>
									<div class="table-responsive">
										<table class="table table-sm">
											<tr class="text-sm">
												<td class="border-top-0 text-left">Kategori Produk</td>
												<td class="border-top-0 text-left">{{ product.ProductCategoryName }}</td>
											</tr>
											<tr class="text-sm">
												<td class="border-top-0 text-left">Stok</td>
												<td class="border-top-0 text-left">
													<span class="badge badge-success">
														{{ product.StockStatus.String() }}
													</span>
												</td>
											</tr>
											<tr class="text-sm">
												<td class="border-top-0 text-left">Keterangan</td>
												<td class="border-top-0 text-left">{{ product.Description }}</td>
											</tr>
											<tr class="text-sm">
												<td class="border-top-0 text-left">Dibuat</td>
												<td class="border-top-0 text-left">
													{{ product.CreatedAt.Format("Mon, 2 Jan 2006 15:04:05") }}
												</td>
											</tr>
											<tr class="text-sm">
												<td class="border-top-0 text-left">Terakhir Diperbaharui</td>
												<td class="border-top-0 text-left">
													{{ product.UpdatedAt.Format("Mon, 2 Jan 2006 15:04:05") }}
												</td>
											</tr>
										</table>
										<hr />
										<a href="{{ baseURL }}/admin/products/{{ product.ID }}/edit">
											<button class="btn btn-default">
												Edit Data Product
											</button>
										</a>
										<a href="{{ baseURL }}/admin/products">
											<button class="btn btn-default">
												Back to List Product
											</button>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-lg-6">
					<div class="card">
						<div class="card-header">
							<div class="row">
								<div class="col-lg-10">
									<h5>Daftar Varian Produk</h5>
									{{ product.Name }}
								</div>
								<div class="col-lg-2 text-right cp">
									<span class="fa fa-info-circle text-info animate__animated animate__fadeIn animate__infinite" data-toggle="tooltip"
										data-placement="top" title="Jika persentase harga variasi belum ditentukan, maka satuan (harga) yang bersangkutan tidak akan berpengaruh ketika menggunakan fitur Variasi Harga Massal"></span>
								</div>
							</div>
						</div>
						<div class="card-body">
							<a href="{{ baseURL }}/admin/products/{{ product.ID }}/variants/new">
								<label class="cp label-title mb-3" onClick="toggleFormAddSatuan()">
									<span class="cp fa fa-plus-circle mr-2"></span> Tambah Varian Produk Baru
								</label>
							</a>
							<div class="table-responsive">
								{{ range type, message := flash.Data }}
								<div class="alert alert-{{ type }}">
									<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
								</div>
								{{ end }}
								<table class="table table-sm" id="hargaProduk">
									<thead>
										<tr>
											<th class="text-center">No.</th>
											<th class="text-left">Satuan &amp; Harga</th>
											<th class="text-left">Diskon &amp; Minimum Quantity</th>
											<th class="text-left">Keterangan</th>
											<th class="text-center">Opsi</th>
										</tr>
									</thead>
									<tbody>
										{{ range _, row := productVariants }}
										<tr class="text-sm tr-parent">
											<td class="vam text-center text-bold">{{ row.RowNo }}</td>
											<td class="vam text-left">
												<h5 class="text-primary mb-1">{{ row.StockUnit }}</h5>
												<span class="text-bold text-success">Rp. {{ row.Price | Comma }}</span>
											</td>
											<td class="vam text-left">
												<h5 class="text-primary mb-1">
													{{ if row.DiscountType.Equal(discountTypePercentage) }}
													{{ row.DiscountRate | Comma }} %
													{{ else }}
													Rp. {{ row.DiscountRate | Comma }}
													{{ end }}
												</h5>
												<span class="text-bold text-success">
													{{ if row.DiscountMinimumQuantity }}
													{{ row.DiscountMinimumQuantity | Comma }}
													{{ else }}
													-
													{{ end }}
												</span>
											</td>
											<td class="vam text-left">
												{{ if row.Description }}
												{{ row.Description }}
												{{ else }}
												<i class="text-muted">Tanpa Keterangan</i>
												{{ end }}
											</td>
											<td class="text-center">
												<a href="{{ baseURL }}/admin/products/{{ row.ProductID }}/variants/{{ row.ID }}/edit">
													<span class="fa fa-edit text-warning cp mr-1" data-toggle="tooltip"
													data-placement="top" title="Edit Varian Produk"></span>
												</a>
												<form method="POST" action="{{ baseURL }}/admin/products/{{ row.ProductID }}/variants/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
													<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
														<span class="fa fa-trash text-danger cp ml-2"
															data-toggle="tooltip"
															data-placement="top"
															title="Hapus Data Varian Produk"
															onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
													</span>
												</form>
											</td>
										</tr>
										{{ end }}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	let baseURL = "{{ baseURL }}/admin/";
	let namaProduk = "TERI NASI BESAR";
	let idProduk = "40538";

	function deleteHargaProduk(thisContext, namaHarga) {
		let el = $(thisContext);
		Swal.fire({
			title: `Konfirmasi Penghapusan Harga Produk`,
			html: `Apakah anda yakin akan menghapus harga produk <b class="text-primary">${namaHarga}</b> dari produk <b class="text-primary">${namaProduk}</b>?`,
			type: "question",
			showConfirmButton: true,
			showCancelButton: true,
			cancelButtonText: "Batal",
			confirmButtonText: "Ya, Lanjutkan !",
			focusCancel: true
		}).then((konfirmasi) => {
			if (konfirmasi.value) {
				let idHargaProduk = el.attr("idHargaProduk");
				$.ajax({
					url: `{{ baseURL }}/admin/produk/deleteHarga/${idHargaProduk}`,
					success: function(responseFromServer) {
						let rFS = JSON.parse(responseFromServer);
						let swalText = `<span class="text-danger">Gagal menghapus harga produk dari Produk ini !</span>`;
						let swalType = "error";
						if (rFS.statusDeleteHarga) {
							swalText = `<span class="text-success">Berhasil menghapus harga produk dari Produk ini !</span>`;
							swalType = "success";
						}
						Swal.fire({
							title: `Penghapusan Harga Produk dari Produk`,
							html: swalText,
							type: swalType
						}).then(() => {
							if (rFS.statusDeleteHarga) {
								location.reload();
							}
						});
					}
				})
			}
		});
	}

	function toggleFormAddSatuan() {
		$("#formAddSatuan").toggle(500);
	}
	$("#formAddSatuan").on("submit", function(e) {
		e.preventDefault();
		let action = `Menambah`;
		let formData = {
			idProduk,
			nama: $("#namaHarga").val(),
			jenis: $("#jenisHarga").val(),
			keterangan: $("#keterangan").val(),
			harga: $("#harga").val(),
			diskon: $("#diskon").val(),
			persentaseHargaVariasi: $("#persentaseHargaVariasi").val()
		};
		$.ajax({
			url: `{{ baseURL }}/admin/produk/saveHarga`,
			data: formData,
			type: "POST",
			success: function(responseFromServer) {
				let rFS = JSON.parse(responseFromServer);
				let swalText = `<span class="text-danger">Gagal ${action} harga produk ke produk ini !</span>`;
				let swalType = "error";
				if (rFS.statusSaveHarga) {
					swalText = `<span class="text-success">Berhasil ${action} harga produk ke produk ini !</span>`;
					swalType = "success";
				}
				Swal.fire({
					title: `Penambahan Harga Produk`,
					html: swalText,
					type: swalType
				}).then(() => {
					if (rFS.statusSaveHarga) {
						location.reload();
					}
				});
			}
		})
	});
</script>
