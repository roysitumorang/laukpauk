<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-4">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Hero Slider</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							List Data Hero Slider
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
		</div>
	</div>
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Data Hero Slider</h5>
						</div>
						<div class="col-lg-8 text-right">
							<a href="{{ baseURL }}/admin/landing_page_blocks/hero/new"
								data-toggle="tooltip"
								data-placement="top"
								title="Tambah Hero Slider Baru">
								Add New Hero Slider
							</a>
						</div>
					</div>
				</div>
				<div class="card-body">
					<div class="col-lg-12 table-responsive">
						<form method="GET" action="/admin/landing_page_blocks/hero">
							<div class="row">
								<div class="col-sm-12 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Show
											<select name="limit" id="limit" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, limit := limits }}
												<option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
												{{ end }}
											</select> entries
										</label>
									</div>
								</div>
								<div class="col-sm-12 col-md-6">
									<div id="listBlog_filter" class="dataTables_filter">
										<label for="q">
											Search: <input type="text" name="q" id="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
										</label>
									</div>
								</div>
							</div>
						</form>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
						<table class="table table-sm" id='tabelHeroSlider'>
							<thead>
								<th class='border-top-0 text-center text-bold'>No.</th>
								<th class='border-top-0 text-left text-bold'>Gambar</th>
								<th class='border-top-0 text-left text-bold'>Heading & Content</th>
								<th class='border-top-0 text-left text-bold'>Tombol</th>
								<th class='border-top-0 text-center text-bold'>Action</th>
							</thead>
							<tbody>
								{{ range _, row := rows }}
								<tr class="text-sm tr-parent">
									<td class="text-center"><b>{{ row.RowNo }}.</b></td>
									<td>
										<a href="{{ baseURL }}/{{ row.PhotoPath() }}" target="_blank">
											<img src="{{ baseURL }}/{{ row.PhotoPath() }}" alt="{{ row.Subject }}" class="img-circle size-50-50">
										</a>
									</td>
									<td>
										<h6 class="mb-1 text-bold text-prim4ary">{{ row.Subject }}</h6>
										<p class="mb-0 text-sm text-muted">{{ row.Body }}</p>
									</td>
									<td>
										<h6 class="mb-1 text-bold text-info">{{ row.LinkText }}</h6>
										<p class="mb-0 text-sm text-muted">{{ row.LinkURL }}</p>
									</td>
									<td class="vam text-center">
										<a href="{{ baseURL }}/admin/landing_page_blocks/hero/{{ row.ID }}/edit">
											<span class="fa fa-edit text-warning cp mr-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Edit Data Hero Slider">
											</span>
										</a>
										<form method="POST" action="{{ baseURL }}/admin/landing_page_blocks/hero/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
											<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
											<span class="fa fa-trash text-danger cp ml-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Hapus Data Hero Slider"
												onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
											</span>
										</form>
									</td>
								{{ end }}
							</tbody>
						</table>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	let baseURL = '{{ baseURL }}/admin/';
	let uploadGambarHero = 'images/landing-page/hero';
	let _tabelHeroSliderOptions = {
		processing: true,
		serverSide: true,
		ajax: {
			url: `{{ baseURL }}/admin/Hero/getHero${location.search}`,
			dataSrc: 'listHero'
		},
		columns: [{
			data: null,
			render: function(data, type, row, meta) {
				return `<p class='mb-0 text-center'><b>${meta.row + 1}.</b></p>`;
			}
		}, {
			data: null,
			render: function(data, type, row, meta) {
				return `<a href='${baseURL}/${uploadGambarHero}/${data.img}' target='_blank'>
					<img src='${baseURL}/${uploadGambarHero}/${data.img}' alt='${data.heading}' class='img-circle size-50-50' />
				</a>`;
			}
		}, {
			data: null,
			render: function(data, type, row, meta) {
				let content = data.content;
				if (content.length >= 50) {
					content = `${content.substr(0, 50)}`;
				}
				return `
					<h6 class='mb-1 text-bold text-prim4ary'>${data.heading}</h6>
					<p class='mb-0 text-sm text-muted'>${content} .. <a href='${baseURL}website/hero/${data.id}'>selengkapnya</a></p>
				`;
			}
		}, {
			data: null,
			render: function(data, type, row, meta) {
				return `
					<h6 class='mb-1 text-bold text-info'>${data.buttonText}</h6>
					<p class='mb-0 text-sm text-muted'>${data.buttonLink}</p>
				`;
			}
		}, {
			data: null,
			render: function(data, type, row, meta) {
				return `
					<div class='text-center'>
						<a href='${baseURL}website/editHero/${data.id}'>
							<span class="fa fa-edit text-warning cp"
								data-toggle='tooltip' data-placement='top' title='Edit'></span>
						</a>
						<span class="fa fa-trash text-danger ml-2 cp" onClick='hapusHero(this)'
							data-detail-hero='${JSON.stringify(data)}'
							data-toggle='tooltip' data-placement='top' title='Hapus'></span>
					</div>`;
			}
		}]
	};
	let _tabelHeroSlider = $('#tabelHeroSlider').DataTable(_tabelHeroSliderOptions);

	function hapusHero(thisContext) {
		let _el = $(thisContext);
		let _detailHero = JSON.parse(_el.attr('data-detail-hero'));
		Swal.fire({
			title: 'Hero Slider',
			html: `Apakah anda yakin akan menghapus hero slider ini ?`,
			type: 'question',
			showCancelButton: true,
			cancelButtonText: 'Batal',
			showConfirmButton: true,
			confirmButtonText: 'Ya, lanjutkan!',
			focusCancel: true
		}).then((konfirmasi) => {
			if (konfirmasi.value) {
				$.ajax({
					url: `{{ baseURL }}/admin/Hero/deleteHero/${_detailHero.id}`,
					success: function(_decodedRFS) {
						let _statusDelete = _decodedRFS.statusDelete;
						let _html, _type;
						if (_statusDelete) {
							_html = 'Berhasil menghapus hero slider!';
							_type = 'success';
						} else {
							_html = 'Gagal menghapus hero slider, silahkan coba lagi!';
							_type = 'error';
						}
						Swal.fire({
							title: 'Hero Slider',
							html: _html,
							type: _type
						}).then(() => {
							if (_statusDelete) {
								_tabelHeroSlider.draw();
							}
						});
					}
				});
			}
		});
	}
</script>
