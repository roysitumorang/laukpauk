<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Kategori Produk</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Kategori Produk Baru
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Kategori Produk Baru</h5>
						</div>
						<div class="col-lg-8 text-right"></div>
					</div>
				</div>
				<div class="card-body">
					{{ range type, message := flash.Data }}
					<div class="alert alert-{{ type }}">
						<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
					</div>
					{{ end }}
					<form method="POST" action="{{ baseURL }}/admin/product_categories" enctype="multipart/form-data">
						{{ include "_product_category_form" }}
					</form>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	let imgKategoriProdukPreview = false;
	let imgKategoriProdukData = false;

	function katagoriProdukChanged(thisContext) {
		let el = $(thisContext);
		let imgData = el.prop("files")[0];
		let fileReader = new FileReader();
		fileReader.readAsDataURL(imgData);
		fileReader.onload = (e) => {
			let imgResult = e.target.result;
			imgKategoriProdukPreview = imgResult;
			imgKategoriProdukData = imgData;
			$("#imgKategoriProduk").attr("src", imgKategoriProdukPreview).addClass("img-thumbnail");
		}
	}
	$("#formKategoriProduk").on("submit", function(e) {
		e.preventDefault();
		let formData = new FormData();
		formData.append("imgKategoriProduk", imgKategoriProdukData);
		formData.append("nama", $("#nama").val());
		formData.append("keterangan", $("#keterangan").val());
		$.ajax({
			url: "{{ baseURL }}/admin/kategoriproduk/save",
			data: formData,
			type: "POST",
			processData: false,
			contentType: false,
			cache: false,
			success: function(responseFromServer) {
				let rFS = JSON.parse(responseFromServer);
				let swalTitle = "Add New Kategori Produk";
				let swalMessage = "Penambahan Kategori Produk baru gagal!";
				let swalType = "error";
				if (rFS.statusSave) {
					swalMessage = "Penambahan Kategori Produk baru berhasil!";;
					swalType = "success";
				}
				Swal.fire({
					title: swalTitle,
					text: swalMessage,
					type: swalType
				}).then(function() {
					if (rFS.statusSave) {
						location.href = "{{ baseURL }}/admin/kategoriproduk";
					}
				});
			}
		});
	});
</script>
