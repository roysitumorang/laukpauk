<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
<div class="row">
	<div class="col-12">
		<div class="form-group">
			<label for="name" class="label-title">Nama</label>
			<input type="text" name="name" value="{{ request.Name }}" class="form-control" id="name"
				placeholder="Nama Jadwal Delivery" />
		</div>
	</div>
</div>
<div class="row">
	<div class="col-4">
		<div class="form-group">
			<label for="transaction_time_min" class="label-title">Batas Awal Jam Transaksi</label>
			<input type="text" name="transaction_time_min" value="{{ request.TransactionTimeMin.Format("15:04:05") }}" id="transaction_time_min"
				class="form-control" placeholder="00:00:00" maxlength="8" />
		</div>
	</div>
	<div class="col-4">
		<div class="form-group">
			<label for="transaction_time_max" class="label-title">Batas Akhir Jam Transaksi</label>
			<input type="text" name="transaction_time_max" value="{{ request.TransactionTimeMax.Format("15:04:05") }}" id="transaction_time_max"
				class="form-control" placeholder="00:00:00" maxlength="8" />
		</div>
	</div>
</div>
<div class="row">
	<div class="col-4">
		<div class="form-group">
			<label for="delivery_time_min" class="label-title">Batas Awal Jam Pengantaran</label>
			<input type="text" name="delivery_time_min" value="{{ request.DeliveryTimeMin.Format("15:04:05") }}" id="delivery_time_min"
				class="form-control" placeholder="00:00:00" maxlength="8" />
		</div>
	</div>
	<div class="col-4">
		<div class="form-group">
			<label for="delivery_time_max" class="label-title">Batas Akhir Jam Pengantaran</label>
			<input type="text" name="delivery_time_max" value="{{ request.DeliveryTimeMax.Format("15:04:05") }}" id="delivery_time_max"
				class="form-control" placeholder="00:00:00" maxlength="8" />
		</div>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<div class="form-group">
			<label for="delivery_daytime" class="label-title">Periode</label>
			<select name="delivery_daytime" class="form-control" id="delivery_daytime">
				{{ range _, deliveryDayTime := deliveryDayTimes }}
				<option value="{{ deliveryDayTime.Int() }}"{{ if request.DeliveryDayTime.Equal(deliveryDayTime) }} selected{{ end }}>{{ deliveryDayTime.String() }}</option>
				{{ end }}
			</select>
		</div>
	</div>
</div>
<div class="row">
	<div class="col-4">
		<div class="form-group">
			<label for="same_day" class="label-title">Same Day</label>
			<input type="checkbox" name="same_day" value="1"{{ if request.SameDay}} checked{{ end }} />
		</div>
	</div>
	<div class="col-4">
		<div class="form-group">
			<label for="next_day" class="label-title">Next Day</label>
			<input type="checkbox" name="next_day" value="1"{{ if request.NextDay}} checked{{ end }} />
		</div>
	</div>
	<div class="col-4">
		<div class="form-group">
			<label for="next_two_day" class="label-title">Next Two Day</label>
			<input type="checkbox" name="next_two_day" value="1"{{ if request.NextTwoDay}} checked{{ end }} />
		</div>
	</div>
</div>
<hr />
<button type="submit" class="btn btn-success mr-1">
	Simpan Data Jadwal Delivery
</button>
<a href="{{ baseURL }}/admin/delivery_plans" class="btn btn-default ml-1">
	Back to List Jadwal Delivery
</a>
