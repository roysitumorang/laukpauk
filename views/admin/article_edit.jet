<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Artikel</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Edit Data Artikel
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Edit Data Artikel</h5>
						</div>
						<div class="col-lg-8 text-right"></div>
					</div>
				</div>
				<div class="card-body">
					{{ range type, message := flash.Data }}
					<div class="alert alert-{{ type }}">
						<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
					</div>
					{{ end }}
					<form method="POST" action="{{ baseURL }}/admin/articles/{{ article.ID }}" enctype="multipart/form-data">
						{{ include "_article_form" }}
					</form>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	let imgOriginal = $("#imgPreview").attr("src");
	let imageData = false;
	let imagePreview = false;

	function artikelImgChanged(thisContext) {
		let el = $(thisContext);
		let file = el.prop("files")[0];
		let fileReader = new FileReader();
		fileReader.readAsDataURL(file);
		fileReader.onload = (e) => {
			let result = e.target.result;
			imagePreview = result;
			imageData = file;
			$("#imgPreview").addClass("img-thumbnail");
			$("#imgPreview").attr("src", imagePreview);
		}
	}

	function simpanArtikel(thisContext) {
		let dataArtikel = new FormData();
		let subject = $("#subject").val();
		let link = $("#link").val();
		let body = $("#body").val();
		dataArtikel.append("artikelImg", imageData);
		dataArtikel.append("subject", subject);
		dataArtikel.append("link", link);
		dataArtikel.append("body", body);
		$.ajax({
			url: "{{ baseURL }}/admin/articles/{{ article.ID }}",
			data: dataArtikel,
			type: "POST",
			contentType: false,
			cache: false,
			processData: false,
			success: function(responseFromServer) {
				let rFS = JSON.parse(responseFromServer);
				let swalTitle = "Perubahan Data Artikel";
				let swalMessage = "Perubahan Data Artikel gagal disimpan !";
				let swalType = "error";
				if (rFS.statusSave) {
					swalMessage = "Perubahan Data Artikel berhasil disimpan !";
					swalType = "success";
				}
				Swal.fire({
					title: swalTitle,
					text: swalMessage,
					type: swalType
				}).then(function() {
					if (rFS.statusSave) {
						location.href = "{{ baseURL }}/admin/articles";
					}
				});
			}
		})
	}
</script>
