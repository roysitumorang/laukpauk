<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Hero Slider</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							Hero Slider Baru
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Hero Slider Baru</h5>
						</div>
						<div class="col-lg-8 text-right">
					</div>
				</div>
			</div>
			<div class="card-body">
				{{ range type, message := flash.Data }}
				<div class="alert alert-{{ type }}">
					<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
				</div>
				{{ end }}
				<form method="POST" action="{{ baseURL }}/admin/blocks/hero/items" enctype="multipart/form-data">
					{{ include "_block_hero_form" }}
				</form>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	let baseURL = '{{ baseURL }}/admin/';
	let imgPreview = false;
	let imgData = false;
	let idElement = '';

	function imgChanged(thisContext) {
		try {
			let el = $(thisContext);
			let _imgData = el.prop('files')[0];
			let fileReader = new FileReader();
			fileReader.readAsDataURL(_imgData);
			fileReader.onload = (e) => {
				let imgResult = e.target.result;
				imgPreview = imgResult;
				imgData = _imgData;
				$('#imgPreview').attr('src', imgPreview).addClass('img-thumbnail');
			}
		} catch (e) {
			console.log(e);
		}
	}
	$('#formheroSlider').on('submit', function(e) {
		e.preventDefault();
		let _formData = new FormData();
		if (imgData !== false) {
			_formData.append('img', imgData);
		}
		_formData.append('heading', $('#heading').val());
		_formData.append('content', $('#content').val());
		_formData.append('buttonText', $('#buttonText').val());
		_formData.append('buttonLink', $('#buttonLink').val());
		$.ajax({
			url: `${baseURL}Hero/saveHero${idElement}`,
			type: 'POST',
			data: _formData,
			processData: false,
			contentType: false,
			cache: false,
			success: function(_decodedRFS) {
				let _statusSaveHero = _decodedRFS.statusSaveHero;
				let _swalType, _swalMessage;
				if (_statusSaveHero) {
					_swalMessage = 'Berhasil menyimpan data hero slider!';
					_swalType = 'success';
				} else {
					_swalMessage = 'Gagal menyimpan data hero slider!';
					_swalType = 'error';
				}
				Swal.fire({
					title: 'Hero Slider',
					html: _swalMessage,
					type: _swalType
				}).then(() => {
					if (_statusSaveHero) {
						location.href = `${baseURL}website/hero`;
					}
				});
			}
		});
	});
</script>
