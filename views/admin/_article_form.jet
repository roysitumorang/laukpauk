<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
<div class="row">
	<div class="col-lg-4 text-center">
		<label for="artikelImg">
			<img src="{{ baseURL }}/assets/img/upload-icon.png"
				alt="Foto Artikel"
				id="imgPreview"
				class="w-100 cp"
				data-toggle="tooltip"
				data-placement="left"
				title="Klik Gambar untuk Memilih Gambar" />
			<input type="file"
				name="photo"
				id="artikelImg"
				onChange="artikelImgChanged(this)" />
		</label>
	</div>
	<div class="col-lg-8">
		<div class="form-group">
			<label for="subject" class="label-title">Judul Artikel</label>
			<input type="text"
				class="form-control"
				name="subject"
				id="subject"
				placeholder="Judul Artikel"
				value="{{ request.Subject }}" />
		</div>
		<div class="form-group">
			<label for="link" class="label-title">Link Artikel</label>
			<input type="text"
				class="form-control"
				name="link"
				id="link"
				placeholder="Link Artikel"
				value="{{ request.Link }}" />
		</div>
		<div class="form-group">
			<label for="body" class="label-title">Isi Artikel</label>
			<textarea class="form-control"
				name="body"
				id="body"
				placeholder="Isi Artikel">{{ request.Body }}</textarea>
			<p class="mb-0 mt-2 text-danger text-sm">Untuk sementara isi artikel ini tidak akan ditampilkan di aplikasi</p>
		</div>
		<hr />
		<button type="submit" class="btn btn-success mr-1">
			Simpan Data Artikel
		</button>
		<a href="{{ baseURL }}/admin/articles" class="btn btn-default ml-1">
			Back to List Artikel
		</a>
	</div>
</div>
