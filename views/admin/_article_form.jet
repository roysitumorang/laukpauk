<form method="POST" action="{{ baseURL }}/admin/articles{{ if !article.New() }}/{{ article.ID }}{{ end }}" enctype="multipart/form-data">
	<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
	{{ if !article.New() }}<input type="hidden" name="id" value="{{ article.ID }}" />{{ end }}
	<div class="row">
		<div class="col-lg-4 text-center">
			<label for="photo">
				<img src="{{ if request.Photo }}{{ request.PhotoPath(baseURL) }}{{ else }}{{ baseURL}}/assets/img/upload-icon.png{{ end }}"
					alt="Foto Artikel"
					class="w-100 cp"
					data-toggle="tooltip"
					data-placement="left"
					title="Klik Gambar untuk Memilih Gambar"
					id="photo_preview" />
				<input type="file" name="photo" id="photo" accept="image/*" />
			</label>
		</div>
		<div class="col-lg-8">
			<div class="form-group">
				<label for="subject" class="label-title">Judul Artikel</label>
				<input type="text"
					class="form-control"
					name="subject"
					id="subject"
					placeholder="Judul Artikel"
					value="{{ request.Subject }}" />
			</div>
			<div class="form-group">
				<label for="link" class="label-title">Link Artikel</label>
				<input type="text"
					class="form-control"
					name="link"
					id="link"
					placeholder="Link Artikel"
					value="{{ request.Link }}" />
			</div>
			<div class="form-group">
				<label for="body" class="label-title">Isi Artikel</label>
				<textarea class="form-control"
					name="body"
					id="body"
					placeholder="Isi Artikel">{{ request.Body }}</textarea>
				<p class="mb-0 mt-2 text-danger text-sm">Untuk sementara isi artikel ini tidak akan ditampilkan di aplikasi</p>
			</div>
			<hr />
			<button type="submit" class="btn btn-success mr-1">
				Simpan{{ if !article.New() }} Perubahan{{ end }} Data Artikel
			</button>
			<a href="{{ baseURL }}/admin/articles" class="btn btn-default ml-1">
				Back to List Artikel
			</a>
		</div>
	</div>
</form>
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote.min.css" />
<script src="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.js"></script>
<link rel="stylesheet" href="{{ baseURL }}/assets/plugins/summernote-0.8.18/summernote-bs4.min.css" />
<script>
	document.addEventListener("DOMContentLoaded", () => {
		$("#body").summernote({
			toolbar: _summernoteCustomToolbar
		});
		document.getElementById("photo").addEventListener("change", (event) => {
			let file = event.target.files[0]
			if (!file || !file.type.startsWith("image/")) {
				return;
			}
			let preview = document.getElementById("photo_preview");
			preview.setAttribute("src", URL.createObjectURL(file));
			preview.classList.add("img-thumbnail");
		});
	});
</script>
