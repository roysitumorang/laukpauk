<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
<div class="row">
	<div class="col-lg-12">
		<div class="form-group">
			<label for="subject" class="label-title">Title</label>
			<input type="text"
				name="subject"
				value="{{ request.Subject }}"
				id="subject"
				class="form-control input"
				placeholder="Belanja dari Rumah" />
		</div>
		<div class="form-group">
			<label for="content" class="label-title">Content</label>
			<textarea name="body"
				class="form-control input"
				placeholder="Hidup lebih santai, dan pekerjaan rumah lainnya bisa dikerjakan tanpa habisin waktu ke pasar"
				id="body">{{ request.Body }}</textarea>
		</div>
		<hr class="mb-4" />
		<button type="submit" class="btn btn-success mr-1">Simpan Data Bantuan</button>
		<a href="{{ baseURL }}/admin/landing_page_blocks/faq" class="btn btn-default ml-1">
			Back to List Bantuan
		</a>
	</div>
</div>
