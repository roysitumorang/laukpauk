<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
	<!-- Content Header (Page header) -->
	<div class="content-header">
		<div class="container-fluid">
			<div class="row mb-2">
				<div class="col-sm-6">
					<h1 class="m-0 text-dark">Kategori Produk</h1>
				</div>
				<!-- /.col -->
				<div class="col-sm-6">
					<ol class="breadcrumb float-sm-right">
						<li class="breadcrumb-item">
							<a href="#">Home</a>
						</li>
						<li class="breadcrumb-item active">
							List Data Kategori Produk
						</li>
					</ol>
				</div>
				<!-- /.col -->
			</div>
			<!-- /.row -->
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content-header -->
	<!-- Main content -->
	<div class="content">
		<div class="container-fluid">
			<div class="card">
				<div class="card-header">
					<div class="row">
						<div class="col-lg-4">
							<h5>Data Kategori Produk</h5>
						</div>
						<div class="col-lg-8 text-right">
							<a href="#" data-toggle="tooltip" class="mr-1" onClick="sinkronKategoriProduk(this)"
								data-placement="top" title="Sinkronisasi Data Kategori Produk">
								Sinkronisasi Kategori Produk
							</a>
							<a href="{{ baseURL }}/admin/product_categories/new" data-toggle="tooltip"
								data-placement="top" title="Tambah Kategori Produk Baru"
								class="ml-1">
								Add New Kategori Produk
							</a>
						</div>
					</div>
				</div>
				<div class="card-body">
					<div class="col-lg-12 table-responsive">
						{{ range type, message := flash.Data }}
						<div class="alert alert-{{ type }}">
							<a class="close" href="#" data-dismiss="alert">x</a>{{ message }}
						</div>
						{{ end }}
						<form method="GET" action="/admin/product_categories">
							<div class="row">
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Show
											<select name="limit" id="limit" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, limit := limits }}
												<option value="{{ limit }}"{{ if limit == request.Limit }} selected{{ end }}>{{ limit }}</option>
												{{ end }}
											</select> entries
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div id="listBlog_filter" class="dataTables_filter">
										<label for="q">
											Search: <input type="text" name="q" id="q" value="{{ request.Keyword }}" class="form-control form-control-sm" placeholder="Search" />
										</label>
									</div>
								</div>
								<div class="col-sm-4 col-md-6">
									<div class="dataTables_length" id="listBlog_length">
										<label for="limit">
											Sort by
											<select name="sort_by" multiple id="sort_by" aria-controls="listBlog" class="custom-select custom-select-sm form-control form-control-sm">
												{{ range _, sorting := sortings }}
												<option value="{{ sorting.String() }}"{{ if request.MapSortings.Contains(sorting.String()) }} selected{{ end }}>{{ sorting.Label }}</option>
												{{ end }}
											</select>
										</label>
									</div>
								</div>
							</div>
						</form>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
						<table class="table-sm table" id="listKategoriProduk">
							<thead>
								<tr>
									<th class="border-top-0 text-center">No.</th>
									<th class="border-top-0 text-left">Kategori</th>
									<th class="border-top-0 text-left">Keterangan</th>
									<th class="border-top-0 text-center">Opsi</th>
								</tr>
							</thead>
							<tbody>
								{{ range _, row := rows }}
								<tr class="text-sm tr-parent">
									<td class="text-center"><b>{{ row.RowNo }}.</b></td>
									<td class="text-left">
										<div class="row">
											<a href="{{ baseURL }}/images/product_category/{{ row.Photo }}" target="_blank">
												<img src="{{ baseURL }}/images/product_category/compress/{{ row.Photo }}"
													alt="{{ row.Name }}" class="img-circle"
													style="width:50px; height:50px;"
													onerror="this.src='{{ baseURL }}/assets/img/no-image.png'" />
											</a>
											<div class="col pl-3">
												<h6 class="mb-0">{{ row.Name }}</h6>
											</div>
										</div>
									</td>
									<td class="text-left">
										{{ if row.Description }}
										{{ row.Description }}
										{{ else }}
										<i class="text-muted">Tidak ada keterangan</i>
										{{ end }}
									</td>
									<td class="vam text-center">
										<a href="{{ baseURL }}/admin/product_categories/{{ row.ID }}/edit">
											<span class="fa fa-edit text-warning cp"
												data-toggle="tooltip" data-placement="left"
												title="Edit Kategori Produk"></span>
										</a>
										<a href="{{ baseURL }}/admin/product_categories/{{ row.ID }}">
											<span class="fa fa-list text-info cp mx-3"
												data-toggle="tooltip" data-placement="left"
												title="Detail Kategori Produk"></span>
										</a>
										<form method="POST" action="{{ baseURL }}/admin/product_categories/{{ row.ID }}/delete" id="delete-{{ row.ID }}">
											<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
											<span class="fa fa-trash text-danger cp ml-2"
												data-toggle="tooltip"
												data-placement="top"
												title="Hapus Data Kategori Produk"
												onclick="confirm('Are you sure to delete this item ?')&&document.getElementById('delete-{{ row.ID }}').submit()">
											</span>
										</form>
									</td>
								</tr>
								{{ end }}
							</tbody>
						</table>
						{{ if pagination.Info.Total > pagination.Info.Limit }}
						<ul class="pagination">
							{{ if pagination.Links.First }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.First }}">First</a></li>
							{{ end }}
							{{ if pagination.Links.Previous }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Previous }}">Previous</a></li>
							{{ end }}
							{{ if pagination.Links.Current }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Current }}">Current</a></li>
							{{ end }}
							{{ if pagination.Links.Next }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Next }}">Next</a></li>
							{{ end }}
							{{ if pagination.Links.Last }}
							<li class="page-item"><a class="page-link" href="{{ pagination.Links.Last }}">Last</a></li>
							{{ end }}
							<li class="page-item"><a class="page-link" href="#">Total: {{ rows | len }} of {{ pagination.Info.Total }} items , Page: {{ pagination.Info.Page + 1 }} of {{ pagination.Info.Pages }} pages</a></li>
						</ul>
						{{ end }}
					</div>
				</div>
			</div>
		</div>
		<!-- /.container-fluid -->
	</div>
	<!-- /.content -->
</div>
<!-- /.content-wrapper -->
<script>
	$("#listKategoriProduk").DataTable();

	function deleteKategoriProduk(thisContext) {
		let el = $(thisContext);
		Swal.fire({
			title: `Konfirmasi Penghapusan Kategori Produk`,
			html: `Apakah anda yakin akan menghapus Kategori Produk ini ?
				<p class="text-danger text-sm mt-2">
					Jika anda menghapus kategori produk ini maka produk produk yang ada di dalam kategori produk ini akan terhapus dari kategori produk ini !
				</p>`,
			type: "question",
			showConfirmButton: true,
			showCancelButton: true,
			cancelButtonText: "Batal",
			confirmButtonText: "Ya, Lanjutkan !",
			focusCancel: true
		}).then((konfirmasi) => {
			if (konfirmasi.value) {
				let idKategoriProduk = el.attr("idKategoriProduk");
				$.ajax({
					url: `{{ baseURL }}/admin/kategoriproduk/delete/${idKategoriProduk}`,
					success: function(responseFromServer) {
						let rFS = JSON.parse(responseFromServer);
						let swalText = `<span class="text-danger">Gagal menghapus Kategori Produk !</span>`;
						let swalType = "error";
						if (rFS.statusHapusKategoriProduk) {
							swalText = `<span class="text-success">Berhasil menghapus Kategori Produk !</span>`;
							swalType = "success";
						}
						Swal.fire({
							title: `Penghapusan Data Kategori Produk`,
							html: swalText,
							type: swalType
						}).then(() => {
							if (rFS.statusHapusKategoriProduk) {
								location.reload();
							}
						});
					}
				})
			}
		});
	}

	function sinkronKategoriProduk(thisContext) {
		let el = $(thisContext);
		Swal.fire({
			title: "Konfirmasi Sinkronisasi Kategori Produk",
			html: `Apakah anda yakin akan melakukan sinkronisasi data kategori produk dari database lama ke database saat ini ?`,
			type: "question",
			showConfirmButton: true,
			showCancelButton: true,
			cancelButtonText: "Batal",
			confirmButtonText: "Ya, Lanjutkan !",
			focusCancel: true
		}).then((konfirmasi) => {
			if (konfirmasi.value) {
				$.ajax({
					url: `{{ baseURL }}/admin/sinkronisasi/sinkronKategoriProduk`,
					success: function(responseFromServer) {
						let rFS = JSON.parse(responseFromServer);
						let html = "Sinkronisasi berhasil dilakukan !";
						Swal.fire({
							title: "Sinkronisasi Data Kategori Produk",
							html: html,
							type: "success"
						}).then(() => {
							location.reload();
						});
					}
				});
			}
		});
	}
</script>
