<input type="hidden" name="_csrf" value="{{ csrfToken }}" />
<div class="row">
	<div class="col-lg-4">
		<label for="fiturImage">
			<img src="{{ baseURL }}/{{ if request.Photo }}{{ request.PhotoPath() }}{{ else }}assets/img/upload-icon.png{{ end }}"
				alt="Gambar Fitur Laukpauk"
				class="w-100 cp"
				data-toggle="tooltip"
				data-placement="left"
				title="Klik Gambar untuk Memilih Gambar"
				id="imgPreview" />
			<input type="file"
				name="photo"
				id="fiturImage"
				onChange="imgChanged(this)" />
		</label>
		<div class="alert alert-warning alert-sm">
			<h6>Note</h6>
			<p class="text-sm mb-0">Ukuran yang disarankan : 360px x 750px</p>
		</div>
	</div>
	<div class="col-lg-8">
		<div class="form-group">
			<label for="subject" class="label-title">Title</label>
			<input type="text"
				name="subject"
				value="{{ request.Subject }}"
				id="subject"
				class="form-control input"
				placeholder="Belanja dari Rumah" />
		</div>
		<div class="form-group">
			<label for="content" class="label-title">Content</label>
			<textarea name="body"
				class="form-control input"
				placeholder="Hidup lebih santai, dan pekerjaan rumah lainnya bisa dikerjakan tanpa habisin waktu ke pasar"
				id="body">{{ request.Body }}</textarea>
		</div>
		<hr class="mb-4" />
		<button type="submit" class="btn btn-success mr-1">Simpan Data Fitur</button>
		<a href="{{ baseURL }}/admin/landing_page/blocks/feature" class="btn btn-default ml-1">
			Back to List Fitur
		</a>
	</div>
</div>
